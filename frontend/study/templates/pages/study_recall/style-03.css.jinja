
        .quick-review-launch { position:relative; min-height:170px; display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:24px; padding:25px 27px; overflow:hidden; color:#fff; border:0; border-radius:22px; background:radial-gradient(circle at 88% 10%,rgba(144,222,255,.33),transparent 30%),linear-gradient(135deg,#0e315b 0%,#105a9d 54%,#087f80 100%); box-shadow:0 20px 44px rgba(15,67,112,.2); }
        .quick-review-launch::after { content:""; position:absolute; right:-50px; bottom:-105px; width:230px; height:230px; border:1px solid rgba(255,255,255,.17); border-radius:50%; box-shadow:0 0 0 28px rgba(255,255,255,.035),0 0 0 58px rgba(255,255,255,.025); pointer-events:none; }
        .quick-review-launch > * { position:relative; z-index:1; }
        .quick-review-copy .eyebrow { color:#a8f0e9; }
        .quick-review-copy h2 { margin:0; font-size:25px; letter-spacing:-.035em; }
        .quick-review-copy p { max-width:560px; margin:8px 0 0; color:rgba(255,255,255,.76); font-size:13px; line-height:1.65; }
        .quick-review-steps { display:flex; flex-wrap:wrap; gap:6px; margin-top:13px; }
        .quick-review-steps span { padding:5px 8px; color:rgba(255,255,255,.84); border:1px solid rgba(255,255,255,.19); border-radius:999px; background:rgba(255,255,255,.07); font-size:10px; font-weight:850; }
        .quick-review-actions { display:grid; gap:7px; min-width:158px; }
        .quick-review-primary,.quick-review-secondary { min-height:44px; display:flex; align-items:center; justify-content:center; padding:0 15px; border-radius:12px; font-size:12px; font-weight:950; }
        .quick-review-primary { color:#0e4e76; background:#fff; box-shadow:0 8px 22px rgba(4,24,42,.16); }
        .quick-review-secondary { color:#fff; border:1px solid rgba(255,255,255,.3); background:rgba(255,255,255,.08); }
        .quick-review-primary:hover,.quick-review-primary:focus-visible,.quick-review-secondary:hover,.quick-review-secondary:focus-visible { transform:translateY(-1px); outline:0; }
        .quick-review-done { min-width:158px; padding:12px 14px; color:#d8fff5; border:1px solid rgba(255,255,255,.24); border-radius:12px; background:rgba(255,255,255,.08); text-align:center; font-size:12px; font-weight:900; }
        @media (max-width:620px) { .quick-review-launch { min-height:0; grid-template-columns:1fr; gap:19px; padding:22px 19px; border-radius:19px; }.quick-review-actions,.quick-review-done { width:100%; min-width:0; }.quick-review-copy h2 { font-size:23px; } }

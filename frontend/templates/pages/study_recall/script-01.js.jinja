        })();
        (() => {
            const dialog = document.getElementById('relation-dialog');
            if (!dialog) return;
            const title = document.getElementById('relation-dialog-title');
            title.dataset.mathContent = '';
            const content = dialog.querySelector('[data-relation-content]');
            const jump = dialog.querySelector('[data-relation-jump]');
            const topic = dialog.querySelector('[data-relation-topic]');
            const loading = dialog.querySelector('[data-relation-loading]');
            const summary = dialog.querySelector('[data-relation-summary]');
            const explanation = dialog.querySelector('[data-relation-explanation]');
            const example = dialog.querySelector('[data-relation-example]');
            const exampleLabel = dialog.querySelector('[data-relation-example-label]');
            const steps = dialog.querySelector('[data-relation-steps]');
            const confusion = dialog.querySelector('[data-relation-confusion]');
            const hint = dialog.querySelector('[data-relation-hint]');
            const cardCache = new Map();
            let activeRequest = null;
            const normalizeMathEscapes = (value) => {
                let normalized = String(value || '');
                for (let attempt = 0; attempt < 3; attempt += 1) {
                    const repaired = normalized
                        .replace(/\\\\(?=[()A-Za-z])/g, '\\')
                        .replace(/\\\\(?=\[(?!\s*-?\d+(?:\.\d+)?(?:pt|em|ex|px|mm|cm|in)\s*\]))/g, '\\')
                        .replace(/\\\\(?=\])/g, '\\');
                    if (repaired === normalized) break;
                    normalized = repaired;
                }
                return normalized;
            };
            const setSectionText = (name, element, value) => {
                const section = dialog.querySelector(`[data-relation-section="${name}"]`);
                const normalized = normalizeMathEscapes(value).trim();
                section.hidden = !normalized;
                element.textContent = normalized;
                delete element.dataset.mathRendered;
                delete element.dataset.studyCodeRendered;
            };
            const detailUrlFromJump = (jumpUrl) => {
                try {
                    const parsed = new URL(jumpUrl, window.location.origin);
                    const sessionId = Number(parsed.searchParams.get('session_id'));
                    const conceptMatch = parsed.hash.match(/^#concept-(\d+)$/);
                    if (!Number.isInteger(sessionId) || sessionId <= 0 || !conceptMatch) return '';
                    return `/admin/study-recall/${sessionId}/cards/${Number(conceptMatch[1])}`;
                } catch (_error) {
                    return '';
                }
            };
            const renderCard = (card) => {
                title.textContent = normalizeMathEscapes(card.title) || '關聯重點卡';
                delete title.dataset.mathRendered;
                delete title.dataset.studyCodeRendered;
                topic.textContent = normalizeMathEscapes(card.topic) || '';
                setSectionText('summary', summary, card.core_summary);
                setSectionText('explanation', explanation, card.explanation);
                const exampleParts = card.card_type === 'example'
                    ? [card.example_problem, card.example_method].filter(Boolean)
                    : [card.simple_example].filter(Boolean);
                exampleLabel.textContent = card.card_type === 'example' ? '題目與解題方法' : '簡單例子';
                setSectionText('example', example, exampleParts.join('\n\n'));
                const stepSection = dialog.querySelector('[data-relation-section="steps"]');

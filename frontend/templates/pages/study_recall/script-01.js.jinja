                        link.textContent = `[${source.number}] ${source.title}・第 ${source.page} 頁`;
                        link.title = `${source.subject}・${source.title}・第 ${source.page} 頁`;
                        sourceList.append(link);
                    });
                    resultPanel.hidden = false;
                    window.renderStudyMath(answerRoot);
                    if (!subject.value && data.inferred?.subject) {
                        subject.value = data.inferred.subject;
                        applySubjectFilter();
                    }
                    status.textContent = data.truncated
                        ? '已完成；範圍較大，本次優先使用最相關的頁面。'
                        : '已完成，所有引用都可從下方來源回查。';
                    status.className = 'library-ai-status';
                    resultPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } catch (error) {
                    status.textContent = error.message || 'AI 筆記助手暫時無法回答。';
                    status.className = 'library-ai-status error';
                } finally {
                    form.classList.remove('is-pending');
                    submit.disabled = !enabled;
                }
            });
            panel.querySelector('[data-library-ai-copy]').addEventListener('click', async (event) => {
                if (!lastAnswer) return;
                const button = event.currentTarget;
                try {
                    await navigator.clipboard.writeText(lastAnswer);
                } catch (_error) {
                    const textarea = document.createElement('textarea');
                    textarea.value = lastAnswer;
                    textarea.style.position = 'fixed';
                    textarea.style.opacity = '0';
                    document.body.append(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    textarea.remove();
                }
                button.textContent = '已複製';
                window.setTimeout(() => { button.textContent = '複製'; }, 1300);
            });
            panel.querySelector('[data-library-ai-clear]').addEventListener('click', () => {
                resultPanel.hidden = true;
                answerRoot.replaceChildren();
                sourceList.replaceChildren();
                lastAnswer = '';
                status.textContent = '';
            });
            applySubjectFilter();
        })();
        (() => {
            const form = document.querySelector('[data-note-search-form]');
            if (!form) return;
            const queryInput = form.querySelector('input[name="q"]');
            const subjectInput = form.querySelector('select[name="subject"]');
            const sessionInput = form.querySelector('select[name="session_id"]');
            const typeInput = form.querySelector('select[name="type"]');
            const sortInput = form.querySelector('select[name="sort"]');
            const submit = form.querySelector('button[type="submit"]');
            const clear = form.querySelector('[data-note-search-clear]');
            const status = form.querySelector('[data-note-search-status]');
            const history = form.querySelector('[data-note-search-history]');
            const results = document.querySelector('[data-note-search-results]');
            let activeRequest = null;
            let searchTimer = null;
            const historyKey = 'e3StudyNoteSearchHistory';

            const appendText = (parent, tagName, className, text) => {
                const node = document.createElement(tagName);
                node.className = className;
                node.textContent = text;
                parent.appendChild(node);
                return node;
            };
            const createActionLink = (label, href, className = '') => {

                copy.className = 'study-code-copy';
                copy.textContent = '複製';
                copy.title = '複製程式碼';
                copy.setAttribute('aria-label', '複製程式碼');
                const pre = document.createElement('pre');
                const code = document.createElement('code');
                code.dataset.studyCode = '';
                code.textContent = match[2].replace(/^\n/, '').replace(/\n[ \t]*$/, '');
                pre.append(code);
                head.append(language, copy);
                block.append(head, pre);
                fragment.append(block);
                cursor = fencePattern.lastIndex;
            }
            appendQuickInlineCode(fragment, source.slice(cursor));
            element.replaceChildren(fragment);
            element.dataset.studyCodeRendered = 'true';
        };
        document.addEventListener('click', async (event) => {

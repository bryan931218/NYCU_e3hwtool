                    status.textContent = '請先輸入想整理的內容。';
                    status.className = 'library-ai-status error';
                    question.focus();
                    return;
                }
                const startValue = pageStart.value ? Number(pageStart.value) : null;
                const endValue = pageEnd.value ? Number(pageEnd.value) : null;
                if (startValue && endValue && Math.abs(endValue - startValue) + 1 > 24) {
                    status.textContent = '一次最多分析 24 頁，請縮小頁碼範圍。';
                    status.className = 'library-ai-status error';
                    return;
                }
                form.classList.add('is-pending');
                submit.disabled = true;
                status.textContent = '正在搜尋相關筆記並核對頁面…';
                status.className = 'library-ai-status';
                try {
                    const response = await fetch(panel.dataset.askUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                        body: JSON.stringify({
                            question: task,
                            subject: subject.value,
                            session_id: sessionSelect.value,
                            page_start: pageStart.value,
                            page_end: pageEnd.value,
                        }),
                    });
                    const data = await response.json().catch(() => ({}));
                    if (!response.ok || !data.ok) throw new Error(data.error || 'AI 筆記助手暫時無法回答。');
                    lastAnswer = data.answer || '';
                    renderAnswer(lastAnswer);
                    scope.textContent = data.scope || '筆記庫相關頁面';
                    sourceList.replaceChildren();
                    (data.sources || []).forEach((source) => {

        .legend-value { margin-top: 4px; font-size: 17px; font-weight: 900; letter-spacing: -.04em; }

        .side-stack { display: grid; gap: 12px; }
        .side-panel { padding: 16px; }
        .side-panel .panel-head { padding: 0 0 14px; }
        .today-card {
            padding: 15px;
            border-radius: 18px;
            color: #fff;
            background:
                radial-gradient(circle at 83% 16%, rgba(255, 255, 255, .24), transparent 24%),
                linear-gradient(135deg, #102a43 0%, #1463d9 100%);

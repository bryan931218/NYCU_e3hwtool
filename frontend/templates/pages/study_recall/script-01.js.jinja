                    content.appendChild(meta);
                    const badges = document.createElement('div');
                    badges.className = 'note-search-badges';
                    if (item.topic) appendText(badges, 'span', 'note-search-badge', item.topic);
                    if (item.card_type === 'example') appendText(badges, 'span', 'note-search-badge example', '例題與解法');
                    if (item.has_formula) appendText(badges, 'span', 'note-search-badge formula', '含公式');
                    if (badges.childElementCount) content.appendChild(badges);
                    const excerpt = appendText(
                        content,
                        'p',
                        'note-search-excerpt',
                        item.excerpt || item.evidence || '已找到相關頁面，可開啟原始筆記查看。',
                    );
                    excerpt.dataset.mathContent = '';
                    const actions = document.createElement('div');
                    actions.className = 'note-search-actions';
                    const preview = document.createElement('button');
                    preview.type = 'button';
                    preview.className = 'note-search-action primary';
                    preview.textContent = item.bbox ? '預覽來源' : '預覽原圖';
                    decorateSourceTrigger(preview, item);
                    actions.appendChild(preview);
                    actions.appendChild(createActionLink('前往筆記', item.note_url));
                    content.appendChild(actions);
                    article.appendChild(content);
                    results.appendChild(article);
                });
                results.hidden = false;
                window.renderStudyMath();
            };

            const performSearch = async () => {
                window.clearTimeout(searchTimer);
                window.clearTimeout(searchTimer);
                const query = queryInput.value.trim();
                if (!query) {
                    status.textContent = '請先輸入要查詢的內容。';
                    status.className = 'note-search-status error';
                    queryInput.focus();
                    return;
                }
                if (query.length < 2) {
                    status.textContent = '請至少輸入兩個字元，讓搜尋結果更準確。';
                    status.className = 'note-search-status';
                    return;
                }
                if (activeRequest) activeRequest.abort();
                const requestController = new AbortController();
                activeRequest = requestController;
                submit.disabled = true;
                submit.textContent = '搜尋中';
                status.textContent = '正在比對所有筆記頁面與重點卡…';
                status.className = 'note-search-status';
                try {
                    const url = new URL(form.dataset.searchUrl, window.location.origin);
                    url.searchParams.set('q', query);
                    if (subjectInput.value) url.searchParams.set('subject', subjectInput.value);
                    if (sessionInput.value) url.searchParams.set('session_id', sessionInput.value);
                    url.searchParams.set('type', typeInput.value);
                    url.searchParams.set('sort', sortInput.value);
                    const response = await fetch(url, {
                        credentials: 'same-origin',
                        headers: { Accept: 'application/json' },
                        signal: requestController.signal,
                    });
                    const payload = await response.json().catch(() => ({}));
                    if (requestController.signal.aborted || activeRequest !== requestController) return;
                    if (!response.ok || !payload.ok) throw new Error(payload.error || '筆記庫搜尋失敗，請稍後再試。');
                    renderResults(Array.isArray(payload.results) ? payload.results : []);
                    rememberQuery(query);
                    status.textContent = payload.result_count
                        ? `${payload.result_count} 個相關頁面`
                        : '沒有找到相關頁面。';
                    status.className = 'note-search-status';
                } catch (error) {
                    if (error.name === 'AbortError' || requestController.signal.aborted || activeRequest !== requestController) return;
                    results.hidden = true;
                    status.textContent = error.message || '筆記庫搜尋失敗，請稍後再試。';
                    status.className = 'note-search-status error';
                } finally {
                    if (activeRequest === requestController) {
                        activeRequest = null;
                        submit.disabled = false;
                        submit.textContent = '搜尋';
                    }
                }
            };
            const scheduleSearch = () => {
                window.clearTimeout(searchTimer);
                const query = queryInput.value.trim();
                clear.hidden = !query;
                if (activeRequest) activeRequest.abort();
                if (query.length < 2) {
                    results.replaceChildren();
                    results.hidden = true;
                    status.textContent = query ? '請輸入至少兩個字元。' : '';
                    return;

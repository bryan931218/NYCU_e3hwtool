            .recall-shortcuts::-webkit-scrollbar { display:none; }
            .recall-shortcuts a { flex:0 0 auto; padding:0 10px; font-size:13px; }
            .workspace-ready .layout { display:flex; flex-direction:column; gap:18px; }
            .workspace-ready .side-stack,.workspace-ready .main-stack { width:100%; position:static; }
            .workspace-ready .side-stack { padding-right:0; border-right:0; }
            .workspace-ready .side-stack { order:-1; }
            .workspace-ready .side-stack .history { max-height:320px; }
            .workspace-ready .library-panel > details > summary { pointer-events:auto; }
            .workspace-ready .library-panel > details > summary .fold-arrow { display:flex; }
            .workspace-ready .note-search-result { grid-template-columns:84px minmax(0,1fr); gap:12px; }
            .workspace-ready .note-search-thumb { width:84px; height:110px; }
            .workspace-ready .note-search-result h3 { font-size:15px; }
            .workspace-ready .note-search-excerpt { font-size:13px; }
            .workspace-ready .note-search-result-head { flex-wrap:wrap; }
            .workspace-ready #review-zone .concepts { grid-template-columns:minmax(0,1fr); }
            .workspace-ready #review-zone .concept { padding:16px; }
            .workspace-ready .library-ai-scope { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .workspace-ready .schedule-panel .queue { grid-template-columns:repeat(4,minmax(0,1fr)); }
            .workspace-ready .favorite-filters { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .workspace-ready .page-head { display:block; margin-bottom:16px; padding-bottom:0; }
            .workspace-ready .page-head .recall-shortcuts { justify-content:flex-start; margin-top:12px; }
            .workspace-ready .subject-library-groups { max-height:360px; }
            .workspace-ready #selected-note-panel { padding:16px; }
            .workspace-ready .session-head { padding-right:0; padding-top:40px; }
            .workspace-ready .session-title-row h2 { font-size:20px; }
            .workspace-ready .note-search-filters { display:grid; grid-template-columns:1fr 1fr; }
            .workspace-ready .note-search-filters select { width:100%; max-width:none; }
        }

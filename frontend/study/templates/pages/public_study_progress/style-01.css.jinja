            .public-note-preview-dialog { max-height:calc(100vh - 16px); border-radius:15px 15px 9px 9px; }
            .public-note-preview-body { max-height:calc(100vh - 94px); padding:8px; }
        }
        @media (prefers-reduced-motion: reduce) {
            .runner-person, .runner-shadow, .calendar-dialog { animation: none; }
        }

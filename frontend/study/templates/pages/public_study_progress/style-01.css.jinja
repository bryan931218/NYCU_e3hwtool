        .day-focus { display: block; margin-top: 3px; color: var(--muted); font-size: 13px; font-weight: 760; }
        .day-completion { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-top: 13px; color: var(--muted); font-size: 13px; font-weight: 760; font-variant-numeric: tabular-nums; }
        .day-completion strong { color: var(--ink-2); font-size: 14px; font-weight: 950; }
        .day-progress { height: 8px; margin-top: 10px; border-radius: 999px; background: #e6edf4; overflow: hidden; }

        .subject-name { font-size: 13px; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .track { height: 9px; border-radius: 999px; background: #e7edf4; overflow: hidden; }
        .fill { height: 100%; width: min(100%, var(--value)); border-radius: inherit; background: linear-gradient(90deg, var(--blue), var(--teal)); }
        .subject-meta { color: var(--muted); font-size: 11px; font-weight: 760; margin-top: 5px; }

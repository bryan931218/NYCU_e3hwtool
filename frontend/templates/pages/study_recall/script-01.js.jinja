            const decorateSourceTrigger = (node, item) => {
                node.dataset.sourceLocator = '';
                node.dataset.sourceImageUrl = item.image_url;
                node.dataset.sourceImageIndex = String(item.image_index);
                node.dataset.sourceEvidence = item.evidence || item.excerpt || '搜尋結果所在頁面';
                if (item.bbox) {
                    node.dataset.sourceLeft = String(item.bbox.left);
                    node.dataset.sourceTop = String(item.bbox.top);
                    node.dataset.sourceRight = String(item.bbox.right);
                    node.dataset.sourceBottom = String(item.bbox.bottom);
                }
                return node;
            };
            const readHistory = () => {
                try {
                    const stored = JSON.parse(localStorage.getItem(historyKey) || '[]');
                    return Array.isArray(stored)
                        ? stored.filter((value) => typeof value === 'string').slice(0, 5)
                        : [];
                } catch (_error) {
                    return [];
                }
            };
            const renderHistory = () => {
                history.replaceChildren();
                readHistory().forEach((query) => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.textContent = query;
                    button.title = `再次搜尋「${query}」`;

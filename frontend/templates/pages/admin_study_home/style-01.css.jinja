        .today-history > summary::after, .analysis-pocket > summary::after { content: "+"; color: var(--muted); font-size: 22px; font-weight: 500; }
        .today-history[open] > summary::after, .analysis-pocket[open] > summary::after { content: "−"; }
        .summary-title { display: block; color: var(--ink); font-size: 15px; font-weight: 900; }
        .summary-meta { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; font-weight: 760; }
        .today-history-body { padding: 0 18px 18px; border-top: 1px solid var(--line); }
        .today-history-section { padding-top: 16px; }
        .today-history-section + .today-history-section { margin-top: 14px; border-top: 1px solid var(--line); }
        .today-history-section h3 { margin: 0; font-size: 14px; }
        .analysis-summary-copy { min-width: 0; }
        .analysis-summary-value { margin-left: auto; color: var(--blue); font-size: 14px; font-weight: 950; white-space: nowrap; }
        .analysis-content { padding: 0 14px 14px; border-top: 1px solid var(--line); }
        .analysis-content .lower-grid { margin-top: 14px; }
        .analysis-content .panel { border: 0; border-radius: 0; background: transparent; box-shadow: none; }
        .analysis-content .panel + .panel { border-left: 1px solid var(--line); }

        .dashboard-grid {
            display: grid;
            grid-template-columns: minmax(620px, 1fr) minmax(330px, 390px);
            gap: 18px;
            align-items: start;
        }
        .panel {
            min-width: 0;
            background: rgba(255, 255, 255, .94);
            border: 1px solid rgba(219, 230, 242, .95);
            border-radius: 28px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }
        .panel-head {
            padding: 20px 22px 0;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
        }
        .panel-title { margin: 0; font-size: 18px; letter-spacing: -.025em; }
        .caption { color: var(--muted); font-size: 12px; line-height: 1.5; }
        .status {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 64px;
            padding: 6px 10px;

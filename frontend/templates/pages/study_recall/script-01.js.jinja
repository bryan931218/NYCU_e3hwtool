                dialog.style.left = `${Math.min(maxLeft, Math.max(margin, rect.left))}px`;
                dialog.style.top = `${Math.min(maxTop, Math.max(margin, rect.top))}px`;
            };
            const finishDrag = (event) => {
                if (!dragState || (event && event.pointerId !== dragState.pointerId)) return;
                if (dragHandle.hasPointerCapture(dragState.pointerId)) {

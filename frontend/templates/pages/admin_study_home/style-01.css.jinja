        .video-meta { margin-top: 3px; color: var(--muted); font-size: 11px; }
        .empty { color: var(--muted); font-size: 13px; line-height: 1.7; }

        .momentum-layout {
            display: grid;
            grid-template-columns: 78px minmax(0, 1fr);
            gap: 12px;
            align-items: center;
        }
        .momentum-score {
            width: 78px;
            height: 78px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            position: relative;
            background: conic-gradient(var(--green) 0deg {{ momentum_angle }}deg, #e7edf4 {{ momentum_angle }}deg 360deg);
            box-shadow: 0 8px 18px rgba(37, 137, 87, .10);
            color: var(--green);
            font-size: 24px;
            font-weight: 950;
            letter-spacing: -.05em;
        }
        .momentum-score::before {
            content: "";
            position: absolute;
            inset: 12px;
            border-radius: 50%;
            background: #fff;
            box-shadow: inset 0 0 0 1px rgba(219, 230, 242, .78);
        }
        .momentum-score span { position: relative; z-index: 1; }
        .momentum-orbs { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
        .orb {
            min-height: 38px;
            border-radius: 14px;
            border: 1px solid var(--line);
            display: grid;
            place-items: center;
            color: var(--muted);
            background: #fbfdff;
            font-size: 10px;
            font-weight: 800;
        }
        .orb.active { color: var(--green); border-color: #b9e0c6; background: var(--green-soft); box-shadow: inset 0 -4px 0 rgba(37, 137, 87, .18); }

        .weak-list { display: grid; gap: 8px; }
        .weak-item {
            padding: 9px 11px;
            border: 1px solid var(--line);
            border-radius: 16px;
            background: #fff;
        }
        .weak-top { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; font-weight: 850; }
        .track { height: 7px; margin-top: 7px; border-radius: 999px; overflow: hidden; background: #e7edf4; }
        .fill { height: 100%; width: min(100%, var(--value)); border-radius: inherit; background: linear-gradient(90deg, var(--blue), var(--teal)); }
        .weak-item .fill { background: linear-gradient(90deg, var(--purple), var(--blue)); }

        .lower-grid {
            display: grid;
            grid-template-columns: minmax(620px, 1fr) minmax(330px, 390px);
            gap: 18px;
            margin-top: 18px;
        }
        .table-card, .chart-card { padding-bottom: 18px; }
        .subject-table-wrap { padding: 14px 18px 0; }
        .subject-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 9px;
            table-layout: fixed;
        }
        .subject-table th {
            padding: 0 10px 2px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 850;
            text-align: left;
        }
        .subject-table td {
            padding: 12px 10px;
            background: #fbfdff;
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            color: var(--ink-2);
            font-size: 13px;
            font-weight: 720;
            vertical-align: middle;
        }
        .subject-table td:first-child { border-left: 1px solid var(--line); border-radius: 16px 0 0 16px; }
        .subject-table td:last-child { border-right: 1px solid var(--line); border-radius: 0 16px 16px 0; }
        .subject-name-cell { font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .progress-cell { display: grid; gap: 6px; }
        .table-track { height: 8px; border-radius: 999px; background: #e7edf4; overflow: hidden; }
        .table-fill { height: 100%; width: min(100%, var(--value)); border-radius: inherit; background: linear-gradient(90deg, var(--blue), var(--teal)); }

        .week-chart-wrap { padding: 12px 18px 0; }
        .week-chart {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 20px;
            background: linear-gradient(180deg, #fbfdff 0%, #f4f8fd 100%);
            border: 1px solid var(--line);
        }
        .chart-labels { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-top: 9px; color: var(--muted); font-size: 10px; font-weight: 800; text-align: center; }
        .chart-legend { display: flex; gap: 14px; flex-wrap: wrap; padding: 12px 2px 0; color: var(--muted); font-size: 12px; font-weight: 760; }
        .chart-key { display: inline-flex; align-items: center; gap: 6px; }
        .key-line { width: 22px; height: 4px; border-radius: 999px; background: var(--blue); }
        .key-line.target { background: #a4b3c2; }

        @media (max-width: 1180px) {
            .metric-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); }
            .dashboard-grid, .lower-grid { grid-template-columns: 1fr; }
            .pace-layout { grid-template-columns: 1fr; }
            .journey-card { min-height: auto; }
            .study-calendar-panel { grid-template-columns: 240px minmax(0, 1fr); }
        }
        @media (max-width: 900px) { .study-nav { padding:12px 18px; align-items:flex-start; flex-direction:column; }.nav-links { justify-content:flex-start; } }
        @media (max-width: 760px) {
            .content { padding: 20px 14px 28px; }
            .page-head { display: block; }
            .head-tools { justify-content: flex-start; margin-top: 14px; }
            .metric-strip { grid-template-columns: 1fr 1fr; gap: 10px; }
            .metric-card:first-child { grid-column: 1 / -1; }
            .pace-message { max-width: 30ch; }
            .pace-history-head { align-items: flex-start; flex-direction: column; }
            .pace-history-summary { justify-content: flex-start; }
            .race-course { padding-left: 0; padding-right: 0; }
            .pace-stats { grid-template-columns: 1fr; }
            .today-log-grid { grid-template-columns: 1fr; }
            .makeup-item { grid-template-columns: 1fr; }
            .makeup-minutes { grid-row: 2; }
            .makeup-track, .makeup-foot { grid-column: 1; }
            .makeup-foot { align-items: flex-start; flex-direction: column; gap: 2px; }
            .metric-card { min-height: 104px; padding: 15px; border-radius: 8px; }
            .metric-value { font-size: 28px; }
            .study-calendar-panel { grid-template-columns: 1fr; }
            .calendar-insight { min-height: 245px; }
            .calendar-focus { margin-top: 16px; }
            .panel { border-radius: 22px; }
            .journey-stage { min-height: 540px; margin: 8px 12px 0; }
            .planet { width: 210px; }
            .topic { min-width: 88px; }
            .topic { transform: translate(-50%, -22px); }
            .topic-orb { width: 44px; height: 44px; }
            .topic-label { max-width: 104px; padding: 6px 8px; font-size: 11px; }
            .map-legend { grid-template-columns: 1fr 1fr; padding: 14px; }
            .video-item { grid-template-columns: 42px minmax(0, 1fr); }
            .video-item .status { grid-column: 2; justify-self: start; }
            .momentum-layout { grid-template-columns: 1fr; }
            .momentum-score { width: 84px; height: 84px; }
            .subject-table th:nth-child(3),
            .subject-table td:nth-child(3) { display: none; }
            .subject-table th, .subject-table td { padding-left: 8px; padding-right: 8px; font-size: 12px; }
            .analysis-content .panel + .panel { border-left: 0; border-top: 1px solid var(--line); }
        }
        @media (max-width: 620px) { .study-nav { gap:8px; }.nav-links { gap:0; }.nav-links a { padding:7px 8px; }.admin { display:none; }.recall-items { grid-template-columns:1fr; } }
        @media (max-width: 620px) { .recall-concepts { grid-template-columns:1fr; padding:14px; } }
        @media (max-width: 470px) {
            .metric-strip { grid-template-columns: 1fr 1fr; }
            .date-pill { white-space: normal; }
            .today-action-panel { padding: 16px 14px; }
            .today-task-stat { padding: 12px 7px; }
            .today-task-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .today-task-stat:nth-child(3) { border-left:0; border-top:1px solid var(--line); }
            .today-task-stat:nth-child(4) { border-top:1px solid var(--line); }
            .today-task-value { font-size: 18px; }
            .today-history > summary, .analysis-pocket > summary { padding-left: 14px; padding-right: 14px; }
            .analysis-summary-value { font-size: 12px; }
            .calendar-main { padding: 16px 10px 18px; }
            .calendar-toolbar { align-items: stretch; flex-direction: column; }
            .calendar-nav { justify-content: space-between; }
            .calendar-nav button:nth-child(2) { flex: 1; }
            .calendar-weekdays, .calendar-grid { gap: 3px; }
            .calendar-day { min-height: 48px; padding: 5px; border-radius: 7px; }
            .calendar-duration { max-width: 42px; font-size: 8px; }
            .calendar-modal { padding: 10px; place-items: end center; }
            .calendar-dialog { width: 100%; max-height: calc(100vh - 20px); border-radius: 18px 18px 12px 12px; }
            .calendar-dialog-head { padding: 18px 16px 14px; }
            .calendar-dialog-body { max-height: calc(100vh - 155px); padding: 13px 16px 18px; }
            .calendar-activity-item { grid-template-columns: 34px minmax(0, 1fr); }
            .calendar-activity-icon { width: 34px; height: 34px; }
            .calendar-activity-time { grid-column: 2; }
            .journey-stage { min-height: 500px; }
            .planet { width: 180px; }
            .topic-0 { left: 50%; top: 13%; }
            .topic-1 { left: 76.8%; top: 31.5%; }
            .topic-2 { left: 76.8%; top: 68.5%; }
            .topic-3 { left: 50%; top: 87%; }
            .topic-4 { left: 23.2%; top: 68.5%; }
            .topic-5 { left: 23.2%; top: 31.5%; }
        }
        /* Unified refinement across the study center */
        .study-nav {
            position: sticky; z-index: 40; top: 0; min-height: 72px; padding: 10px 30px;
            border-bottom-color: rgba(205,220,235,.78); background: rgba(255,255,255,.86);
            box-shadow: 0 1px 0 rgba(255,255,255,.85), 0 8px 28px rgba(16,42,67,.045);
            backdrop-filter: blur(18px) saturate(1.18);
        }
        .brand { gap: 12px; font-size: 15px; letter-spacing: -.015em; }
        .mark { width: 38px; height: 38px; border-radius: 12px; background: linear-gradient(145deg,#1f78ed,#0d4fae); box-shadow: 0 8px 18px rgba(20,99,217,.24), inset 0 1px 0 rgba(255,255,255,.3); }
        .nav-links { gap: 5px; }
        .nav-links a { padding: 9px 13px; border: 0; border-radius: 999px; transition: color .16s ease,background .16s ease,transform .16s ease; }
        .nav-links a:hover { color: var(--blue); background: #f2f7fd; transform: translateY(-1px); }
        .nav-links a.active { color: #0d56bd; background: var(--blue-soft); box-shadow: inset 0 0 0 1px #c9def8; }
        .admin { margin-left: 6px; padding: 8px 11px; border-radius: 999px; }
        .content { padding-top: 32px; padding-bottom: 60px; }
        .page-head { margin-bottom: 22px; }
        .metric-card { border-radius: 18px; box-shadow: 0 12px 34px rgba(16,42,67,.065); }
        .metric-icon { border-radius: 12px; }
        .continue-button { min-height: 42px; padding: 10px 15px; border-radius: 12px; background: linear-gradient(135deg,#1b70e4,#0d57bd); }
        .panel, .study-calendar-panel, .pace-panel, .today-log-panel, .week-progress-panel, .today-action-panel, .analysis-pocket { border-color: rgba(210,224,238,.94); box-shadow: 0 16px 44px rgba(16,42,67,.07); }
        .today-action-panel { position: relative; overflow: hidden; }
        .today-action-panel::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 4px; background: linear-gradient(180deg,var(--blue),var(--teal)); }
        .video-item, .today-log-stat, .makeup-item, .today-video-item { transition: border-color .16s ease,box-shadow .16s ease,transform .16s ease; }
        .video-item:hover, .makeup-item:hover, .today-video-item:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(16,42,67,.06); }
        button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid rgba(20,99,217,.22); outline-offset: 2px; }
        @media (max-width: 900px) {
            .study-nav { padding: 12px 16px; align-items: center; flex-direction: row; flex-wrap: wrap; }
            .nav-links { width: 100%; justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
            .nav-links::-webkit-scrollbar { display: none; }
            .nav-links a { flex: 0 0 auto; }
        }
        @media (max-width: 620px) {
            .brand { font-size: 14px; }
            .mark { width: 35px; height: 35px; }
            .nav-links a { padding: 8px 10px; }
            .content { padding-top: 18px; }
        }
        @media (prefers-reduced-motion: reduce) {
            .runner-person, .runner-shadow, .calendar-dialog { animation: none; }
        }

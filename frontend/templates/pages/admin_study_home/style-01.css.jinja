        .topic-1 { left: 76.8%; top: 31.5%; --topic-color: var(--teal); }
        .topic-2 { left: 76.8%; top: 68.5%; --topic-color: var(--purple); }
        .topic-3 { left: 50%; top: 87%; --topic-color: var(--amber); }
        .topic-4 { left: 23.2%; top: 68.5%; --topic-color: var(--green); }
        .topic-5 { left: 23.2%; top: 31.5%; --topic-color: #4460a8; }

        .map-legend {

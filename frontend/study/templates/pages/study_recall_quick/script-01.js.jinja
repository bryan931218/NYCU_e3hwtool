                feedback.hidden=false; feedback.classList.toggle('is-wrong',!correct); title.textContent=correct?'答對':'答錯'; copy.textContent=correct?'判斷正確，請再核對來源解析與成立條件。':'綠色選項是正確答案；請找出自己判斷失誤的條件。';
                const next=currentCard.querySelector('[data-objective-next]'); next.hidden=false; next.dataset.action=rescueMode&&!correct?'retry':'next'; next.textContent=rescueMode&&!correct?'再作答一次':(rescueMode?'答對了，完成補強':'看完解析，下一題');
                reveal();

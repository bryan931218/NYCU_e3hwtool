        })();
        (() => {
            const dialog = document.getElementById('source-locator-dialog');
            if (!dialog) return;
            const viewport = dialog.querySelector('[data-source-viewport]');
            const canvas = dialog.querySelector('[data-source-canvas]');
            const image = dialog.querySelector('[data-source-image]');
            const highlight = dialog.querySelector('[data-source-highlight]');
            const title = document.getElementById('source-locator-title');
            const evidence = dialog.querySelector('[data-source-evidence]');
            let box = null;
            let scale = 1;

            const clampScale = (value) => Math.max(0.08, Math.min(3.5, value));
            const centerHighlight = () => {
                if (!box || !canvas.clientWidth || !canvas.clientHeight) return;
                const centerX = canvas.offsetLeft + canvas.clientWidth / 2;
                const centerY = canvas.offsetTop + canvas.clientHeight * ((box.top + box.bottom) / 2000);
                viewport.scrollTo({
                    left: Math.max(0, centerX - viewport.clientWidth / 2),
                    top: Math.max(0, centerY - viewport.clientHeight / 2),
                    behavior: 'instant',
                });
            };
            const setScale = (nextScale, shouldCenter = true) => {
                if (!image.naturalWidth || !image.naturalHeight) return;
                scale = clampScale(nextScale);
                canvas.style.width = `${Math.round(image.naturalWidth * scale)}px`;
                canvas.style.height = `${Math.round(image.naturalHeight * scale)}px`;
                if (shouldCenter) requestAnimationFrame(centerHighlight);
            };
            const fitScale = () => {
                if (!image.naturalWidth || !image.naturalHeight) return 1;
                const widthScale = Math.max(0.08, (viewport.clientWidth - 32) / image.naturalWidth);
                const heightScale = Math.max(0.08, (viewport.clientHeight - 32) / image.naturalHeight);
                return Math.min(1, widthScale, heightScale);
            };
            const initializeImage = () => {
                if (!image.naturalWidth || !image.naturalHeight) return;
                highlight.hidden = !box;
                if (!box) {
                    setScale(fitScale(), false);
                    viewport.scrollTo({ left: 0, top: 0, behavior: 'instant' });
                    return;
                }
                highlight.style.left = '0';
                highlight.style.top = `${box.top / 10}%`;
                highlight.style.width = '100%';
                highlight.style.height = `${(box.bottom - box.top) / 10}%`;
                const baseScale = fitScale();
                const sourceWidth = image.naturalWidth * ((box.right - box.left) / 1000);
                const sourceHeight = image.naturalHeight * ((box.bottom - box.top) / 1000);
                const targetWidth = Math.max(220, Math.min(620, viewport.clientWidth - 52));
                const targetHeight = Math.max(180, Math.min(360, viewport.clientHeight * 0.62));
                const focusScale = Math.min(
                    1.75,
                    Math.max(
                        baseScale,
                        Math.min(targetWidth / Math.max(1, sourceWidth), targetHeight / Math.max(1, sourceHeight)),
                    ),
                );
                highlight.style.animation = 'none';
                void highlight.offsetWidth;
                highlight.style.animation = '';
                setScale(focusScale);
            };

            document.addEventListener('click', (event) => {
                const trigger = event.target.closest('[data-source-locator]');

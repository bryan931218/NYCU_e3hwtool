
        window.renderStudyMath = (root = document) => {
            if (!window.renderMathInElement) return;
            const queryAll = (selector) => [
                ...(root.matches?.(selector) ? [root] : []),
                ...root.querySelectorAll(selector),
            ];
            const isDeferred = (element) => {
                if (element.closest('[hidden]')) return true;
                let ancestor = element.parentElement;
                while (ancestor) {
                    if (ancestor.tagName === 'DETAILS' && !ancestor.open) {
                        const summary = Array.from(ancestor.children).find((child) => child.tagName === 'SUMMARY');
                        if (!summary?.contains(element)) return true;
                    }
                    ancestor = ancestor.parentElement;
                }
                return false;
            };
            queryAll('.recall-card-title').forEach((element) => { element.dataset.mathContent = ''; });
            queryAll('[data-math-content]').forEach((element) => {
                if (element.dataset.mathRendered === 'true') return;
                if (isDeferred(element)) return;
                window.renderMathInElement(element, {
                    delimiters: [
                        { left: '$$', right: '$$', display: true },
                        { left: '$', right: '$', display: false },
                        { left: '\\[', right: '\\]', display: true },
                        { left: '\\(', right: '\\)', display: false },
                    ],
                    throwOnError: false,
                    strict: 'ignore',
                });
                element.dataset.mathRendered = 'true';
            });
        };
        document.addEventListener('toggle', (event) => {
            const detail = event.target;
            if (detail instanceof HTMLDetailsElement && detail.open) window.renderStudyMath(detail);
        }, true);
        (() => {
            document.querySelectorAll('[data-recall-card]').forEach((card) => {
                const reveal = card.querySelector('[data-recall-reveal]');
                const answer = card.querySelector('[data-recall-answer]');
                if (!reveal || !answer) return;
                reveal.addEventListener('click', () => {
                    const shouldReveal = answer.hidden;
                    answer.hidden = !shouldReveal;
                    reveal.textContent = shouldReveal ? '收起重點' : '揭示重點';
                    reveal.setAttribute('aria-expanded', shouldReveal ? 'true' : 'false');
                    if (shouldReveal) window.renderStudyMath();
                });
            });
        })();
        (() => {
            const updateDueCounts = (count) => {
                document.querySelectorAll('[data-recall-due-count]').forEach((node) => {
                    node.textContent = `${count} ${node.dataset.countLabel || '張待複習'}`;
                });
            };
            const removeRatedCard = (card) => {
                card.classList.add('is-completing');
                window.setTimeout(() => {
                    const list = card.closest('[data-recall-card-list]');
                    card.remove();
                    if (list && !list.querySelector('[data-recall-card]')) {
                        list.hidden = true;
                        const empty = list.parentElement.querySelector('[data-recall-empty]');
                        if (empty) empty.hidden = false;
                    }
                }, 180);
            };
            document.querySelectorAll('form[data-recall-rating-form]').forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    if (form.dataset.submitting === 'true') return;
                    const status = form.querySelector('[data-recall-rating-status]');
                    const button = form.querySelector('button[type="submit"]');
                    if (!form.querySelector('input[type="radio"]:checked')) {
                        if (status) status.textContent = '請先選擇印象分。';
                        return;
                    }
                    form.dataset.submitting = 'true';
                    if (status) status.textContent = '';
                    const originalLabel = button.textContent;
                    button.disabled = true;
                    button.textContent = '儲存中…';
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            credentials: 'same-origin',
                            headers: { 'X-E3-Recall-Rating': '1', Accept: 'application/json' },
                        });
                        const result = await response.json().catch(() => ({}));
                        if (!response.ok || !result.ok) throw new Error(result.error || '印象分暫時無法儲存，請再試一次。');
                        updateDueCounts(result.remaining_due_count);
                        const card = form.closest('[data-recall-card]');
                        if (card) removeRatedCard(card);
                    } catch (error) {
                        if (status) status.textContent = error.message || '印象分暫時無法儲存，請再試一次。';
                        button.disabled = false;
                        button.textContent = originalLabel;
                        form.dataset.submitting = '';
                    }
                });
            });
        })();

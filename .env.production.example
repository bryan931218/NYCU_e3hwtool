# Configure real values in the hosting provider's secret manager, not Git.
E3_ENV=production
E3_WEB_SECRET=
E3_DATA_ENCRYPTION_KEY=
# Optional comma-separated old Fernet keys during controlled rotation.
E3_DATA_ENCRYPTION_PREVIOUS_KEYS=
E3_SESSION_COOKIE_SECURE=1
E3_SESSION_COOKIE_SAMESITE=Lax
E3_DEV_RELOAD=0
E3_TRUSTED_HOSTS=www.e3hwtool.space,e3hwtool.space,healthcheck.railway.app
E3_CANONICAL_HOST=www.e3hwtool.space
E3_APP_HOME_URL=https://www.e3hwtool.space/
# Set to the exact number of trusted proxies; do not expose origin directly.
E3_PROXY_HOPS=1
# Shared-campus IP limits; account/browser limits remain independent.
E3_REQUESTS_PER_MINUTE=3000
E3_LOGIN_IP_LIMIT=120
E3_LOGIN_ACCOUNT_LIMIT=20
E3_LOGIN_BROWSER_LIMIT=10
E3_DATABASE_URL=
E3_CACHE_DIR=
E3_STUDY_UPLOAD_DIR=
E3_ADMIN_USER_ID=112550103
E3_GOOGLE_REDIRECT_URI=https://www.e3hwtool.space/google/callback
E3_GOOGLE_CLIENT_ID=
E3_GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
# Optional assignment notifications; configure secrets in Railway.
E3_PUSH_VAPID_PRIVATE_KEY=
E3_PUSH_VAPID_PUBLIC_KEY=
E3_PUSH_VAPID_SUBJECT=https://www.e3hwtool.space
E3_LINE_CHANNEL_ACCESS_TOKEN=
E3_LINE_CHANNEL_SECRET=
E3_LINE_BOT_BASIC_ID=
E3_NOTIFICATIONS_WORKER=1

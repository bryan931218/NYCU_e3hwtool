        .session-head { padding:20px; border-bottom:1px solid var(--line); }.session-title-row { display:flex; align-items:start; justify-content:space-between; gap:14px; }.session-title-row h2 { margin:0; }.delete-note { min-height:34px; padding:0 10px; color:var(--red); border:1px solid #e5bfc3; border-radius:4px; background:#fff; font-size:12px; font-weight:850; cursor:pointer; white-space:nowrap; }.delete-note:hover { color:#fff; border-color:var(--red); background:var(--red); }.session-meta { display:flex; flex-wrap:wrap; gap:7px; margin-top:10px; }.chip { padding:4px 7px; border:1px solid var(--line); color:var(--muted); background:#fafcff; border-radius:4px; font-size:11px; font-weight:800; }.summary-section { margin:16px 20px 0; padding:16px 0; border-top:1px solid var(--line); }.summary-section h3 { margin:0; font-size:15px; }.summary { margin:9px 0 0; color:var(--muted); line-height:1.75; font-size:14px; white-space:pre-line; }.concepts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin-top:16px; }.concept { min-width:0; padding:14px; border:1px solid var(--line); border-radius:5px; background:#fbfdff; }.concept strong { display:block; overflow-wrap:anywhere; font-size:14px; }.concept p { min-width:0; margin:7px 0 0; color:var(--muted); font-size:13px; line-height:1.6; }.hint { margin-top:8px; color:var(--teal); font-size:12px; font-weight:750; }.note-fold { margin:16px 0 0; border:1px solid var(--line); border-radius:5px; background:#fbfdff; }.note-fold summary { padding:11px 12px; cursor:pointer; color:var(--ink); font-size:13px; font-weight:850; }.note-fold > div { padding:0 12px 12px; }.note-images { display:flex; flex-wrap:wrap; align-items:flex-start; gap:10px; }.note-images a { position:relative; width:300px; max-width:100%; height:320px; display:block; overflow:hidden; border:1px solid var(--line); background:#fff; }.note-images img { position:absolute; inset:0; display:block; width:100%; height:100%; max-width:none; ma
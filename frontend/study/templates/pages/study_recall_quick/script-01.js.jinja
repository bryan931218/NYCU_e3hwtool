
        const QUICK_CODE_LANGUAGE_LABELS = Object.freeze({ c:'C', cpp:'C++', 'c++':'C++', py:'Python', python:'Python', js:'JavaScript', javascript:'JavaScript', ts:'TypeScript', typescript:'TypeScript', java:'Java', sql:'SQL', pseudocode:'虛擬碼', pseudo:'虛擬碼', text:'程式碼', plaintext:'程式碼' });
        const appendQuickInlineCode = (fragment, value) => {
            const pattern = /`([^`\n]+)`/g;
            let cursor = 0;
            let match;
            while ((match = pattern.exec(value)) !== null) {
                if (match.index > cursor) fragment.append(document.createTextNode(value.slice(cursor, match.index)));
                const code = document.createElement('code');
                code.className = 'study-inline-code';
                code.textContent = match[1];
                fragment.append(code);
                cursor = pattern.lastIndex;
            }
            if (cursor < value.length) fragment.append(document.createTextNode(value.slice(cursor)));
        };
        window.renderStudyCodeBlocks = (element) => {
            if (!element || element.dataset.studyCodeRendered === 'true') return;
            const source = element.textContent || '';
            if (!source.includes('`')) {
                element.dataset.studyCodeRendered = 'true';
                return;
            }
            const fencePattern = /```[ \t]*([A-Za-z0-9_+#.\-]*)[ \t]*\n([\s\S]*?)```/g;

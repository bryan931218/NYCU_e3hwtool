            border: 11px solid rgba(79, 141, 247, .16);
            transform: rotate(-14deg);
        }
        .planet-core { position: relative; z-index: 3; text-align: center; }
        .planet-value { color: var(--blue); font-size: clamp(42px, 5.2vw, 62px); font-weight: 950; letter-spacing: -.08em; }
        .planet-label { margin-top: 2px; color: var(--muted); font-size: 13px; font-weight: 820; }
        .topic {

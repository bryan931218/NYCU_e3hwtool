
        .quick-recall-home { min-height:66px; display:flex; align-items:center; justify-content:space-between; gap:15px; margin-bottom:14px; padding:13px 15px; color:#fff; border-radius:16px; background:linear-gradient(135deg,#0f4f91,#087f80); box-shadow:0 12px 28px rgba(15,79,145,.15); }

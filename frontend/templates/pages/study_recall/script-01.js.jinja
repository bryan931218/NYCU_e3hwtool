        (() => {
            const button = document.querySelector('[data-source-localize-url]');
            if (!button) return;
            const status = document.querySelector('[data-source-localize-status]');
            const originalLabel = button.textContent;
            const storageKey = `e3StudySourceJob:${button.dataset.sourceLocalizeUrl}`;
            let pollTimer = null;
            const resetButton = () => {
                button.dataset.pending = '';
                button.disabled = false;
                button.textContent = originalLabel;
            };
            const showError = (message) => {
                window.clearTimeout(pollTimer);
                localStorage.removeItem(storageKey);
                resetButton();
                if (status) {
                    status.classList.add('error');
                    status.textContent = message || '來源定位暫時無法完成。';
                }
            };
            const pollJob = async (statusUrl) => {
                window.clearTimeout(pollTimer);
                try {
                    const response = await fetch(statusUrl, {
                        credentials: 'same-origin',
                        cache: 'no-store',
                        headers: { Accept: 'application/json' },
                    });
                    const job = await response.json().catch(() => ({}));
                    if (!response.ok || !job.ok) throw new Error(job.error || '無法讀取重新定位進度。');
                    if (job.status === 'running') {
                        button.dataset.pending = 'true';
                        button.disabled = true;
                        button.textContent = '定位中…';
                        if (status) {
                            status.classList.remove('error');
                            status.textContent = `${job.message || '正在重新定位來源。'} ${Number(job.progress) || 0}%`;
                        }
                        pollTimer = window.setTimeout(() => pollJob(statusUrl), 1500);
                        return;
                    }
                    if (job.status === 'success') {
                        localStorage.removeItem(storageKey);
                        if (status) status.textContent = `重新定位完成，保留 ${job.located_count}/${job.total_count} 個精確來源，正在更新頁面…`;
                        window.setTimeout(() => {
                            window.location.href = job.reload_url || window.location.href;
                        }, 450);
                        return;
                    }
                    showError(job.message || '來源定位暫時無法完成。');
                } catch (error) {
                    showError(error.message || '來源定位暫時無法完成。');
                }
            };
            button.addEventListener('click', async () => {

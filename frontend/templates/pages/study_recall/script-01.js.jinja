                        while (index < lines.length && !lines[index].trim().startsWith('```')) {
                            values.push(lines[index]);
                            index += 1;
                        }
                        if (index < lines.length) index += 1;
                        const block = document.createElement('div');
                        block.className = 'study-code-block';
                        const head = document.createElement('div');
                        head.className = 'study-code-head';
                        const label = document.createElement('span');
                        label.className = 'study-code-language';
                        label.textContent = STUDY_CODE_LANGUAGE_LABELS[language.toLowerCase()] || language || '程式碼';
                        const pre = document.createElement('pre');
                        const code = document.createElement('code');
                        code.textContent = values.join('\n');
                        pre.append(code);
                        head.append(label);
                        block.append(head, pre);
                        answerRoot.append(block);
                        continue;
                    }
                    if (line.includes('|') && isTableSeparator(lines[index + 1] || '')) {
                        const headers = markdownCells(line);
                        index += 2;
                        const rows = [];
                        while (index < lines.length && lines[index].includes('|') && lines[index].trim()) {
                            rows.push(markdownCells(lines[index]));
                            index += 1;
                        }
                        const wrap = document.createElement('div');
                        wrap.className = 'library-ai-table-wrap';
                        const table = document.createElement('table');
                        table.className = 'library-ai-table';
                        const thead = document.createElement('thead');
                        const headerRow = document.createElement('tr');
                        headers.forEach((value) => {
                            const cell = document.createElement('th');
                            setTextWithMath(cell, value);
                            headerRow.append(cell);
                        });
                        thead.append(headerRow);
                        const tbody = document.createElement('tbody');
                        rows.forEach((values) => {
                            const row = document.createElement('tr');
                            headers.forEach((_header, cellIndex) => {
                                const cell = document.createElement('td');
                                setTextWithMath(cell, values[cellIndex] || '');
                                row.append(cell);
                            });
                            tbody.append(row);
                        });
                        table.append(thead, tbody);
                        wrap.append(table);
                        answerRoot.append(wrap);
                        continue;
                    }
                    const headingMatch = line.match(/^#{1,4}\s+(.+)$/);
                    if (headingMatch) {
                        const level = line.match(/^#+/)[0].length;
                        const heading = document.createElement(level >= 3 ? 'h4' : 'h3');
                        setTextWithMath(heading, headingMatch[1]);
                        answerRoot.append(heading);
                        index += 1;
                        continue;
                    }
                    const unordered = /^\s*[-*]\s+/.test(line);
                    const ordered = /^\s*\d+[.)]\s+/.test(line);
                    if (unordered || ordered) {
                        const list = document.createElement(ordered ? 'ol' : 'ul');
                        const pattern = ordered ? /^\s*\d+[.)]\s+/ : /^\s*[-*]\s+/;
                        while (index < lines.length && pattern.test(lines[index])) {
                            const item = document.createElement('li');
                            setTextWithMath(item, lines[index].replace(pattern, '').trim());
                            list.append(item);
                            index += 1;
                        }
                        answerRoot.append(list);
                        continue;
                    }
                    const paragraphLines = [line.trim()];
                    index += 1;
                    while (index < lines.length && !isSpecialLine(lines, index)) {
                        paragraphLines.push(lines[index].trim());
                        index += 1;
                    }
                    const paragraph = document.createElement('p');
                    setTextWithMath(paragraph, paragraphLines.join('\n'));
                    answerRoot.append(paragraph);
                }
                window.renderStudyMath(answerRoot);
            };
            const applySubjectFilter = () => {
                const selectedSubject = subject.value;
                let selectedStillVisible = !sessionSelect.value;
                Array.from(sessionSelect.options).forEach((option, index) => {
                    if (index === 0) return;
                    const visible = !selectedSubject || option.dataset.subject === selectedSubject;
                    option.hidden = !visible;
                    option.disabled = !visible;
                    if (option.selected && visible) selectedStillVisible = true;
                });
                if (!selectedStillVisible) sessionSelect.value = '';
            };
            subject.addEventListener('change', applySubjectFilter);
            sessionSelect.addEventListener('change', () => {
                const selectedOption = sessionSelect.selectedOptions[0];
                if (selectedOption?.dataset.subject) {
                    subject.value = selectedOption.dataset.subject;
                    applySubjectFilter();
                }
            });
            panel.querySelectorAll('[data-library-ai-prompt]').forEach((button) => {
                button.addEventListener('click', () => {
                    question.value = button.dataset.libraryAiPrompt || '';
                    question.focus();
                    question.setSelectionRange(question.value.length, question.value.length);
                });
            });
            question.addEventListener('keydown', (event) => {
                if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
                    event.preventDefault();
                    form.requestSubmit();
                }
            });
            form.addEventListener('submit', async (event) => {
                event.preventDefault();

            font-size: 12px;
            font-weight: 850;
            white-space: nowrap;
        }
        .status.early { color: var(--teal); background: var(--teal-soft); border-color: #9bdcdd; }
        .status.active { color: var(--blue); background: var(--blue-soft); border-color: #a8c7f4; }
        .status.behind { color: var(--amber); background: var(--amber-soft); border-color: #f0d6a5; }
        .status.complete { color: var(--green); background: var(--green-soft); border-color: #b9e0c6; }
        .status.rest { color:#52697d; background:#e9eff4; border-color:#cbd7e2; }
        .status.upcoming { color: var(--muted); background: #f4f7fa; }

        .journey-card { min-height: 652px; position: relative; }
        .journey-stage {
            position: relative;
            min-height: 510px;
            margin: 8px 18px 0;
            border-radius: 28px;
            background:
                radial-gradient(circle at 50% 50%, rgba(255, 255, 255, .96) 0, rgba(255, 255, 255, .82) 26%, transparent 27%),
                radial-gradient(circle at 22% 22%, rgba(20, 99, 217, .13), transparent 26%),
                radial-gradient(circle at 82% 76%, rgba(15, 139, 141, .14), transparent 28%),
                linear-gradient(135deg, #f7fbff 0%, #eef6ff 100%);
            overflow: hidden;
            display: grid;
            place-items: center;
        }
        .journey-stage::before,
        .journey-stage::after {
            content: "";
            position: absolute;
            width: 62%;
            height: 74%;
            border: 1px dashed rgba(138, 160, 182, .45);
            border-radius: 50%;
        }
        .journey-stage::after { width: 44%; height: 54%; opacity: .78; }
        .orbit-line {
            position: absolute;
            width: 30%;
            height: 38%;
            border: 1px dashed rgba(138, 160, 182, .36);
            border-radius: 50%;
        }
        .star {
            position: absolute;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: rgba(20, 99, 217, .24);
        }
        .star.s1 { left: 15%; top: 20%; }
        .star.s2 { left: 31%; top: 74%; }
        .star.s3 { right: 18%; top: 24%; }
        .star.s4 { right: 25%; bottom: 20%; }
        .planet {
            --angle: {{ visual_angle }}deg;
            position: relative;
            z-index: 2;
            width: min(246px, 40vw);
            aspect-ratio: 1;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: conic-gradient(var(--blue) 0deg var(--angle), #dbe6f2 var(--angle) 360deg);
            box-shadow: 0 28px 70px rgba(20, 99, 217, .22);
        }
        .planet::before {
            content: "";
            position: absolute;
            inset: 21px;
            border-radius: 50%;
            background:
                radial-gradient(circle at 34% 24%, #ffffff 0, #ffffff 18%, transparent 19%),
                radial-gradient(circle at 65% 72%, rgba(20, 99, 217, .12), transparent 24%),
                linear-gradient(145deg, #ffffff 0%, #f0f7ff 56%, #dfefff 100%);
            box-shadow: inset 0 0 0 1px rgba(219, 230, 242, .95);
        }
        .planet::after {
            content: "";


        :root {
            --ink: #102a43;
            --ink-2: #243b53;
            --muted: #65758a;
            --soft: #8aa0b6;
            --canvas: #f4f8fd;
            --paper: #ffffff;
            --line: #dbe6f2;
            --blue: #1463d9;
            --blue-2: #4f8df7;
            --blue-soft: #eaf3ff;
            --green: #258957;
            --green-soft: #eaf8f0;
            --teal: #0f8b8d;
            --teal-soft: #e8fbfb;
            --purple: #6d4bd7;
            --purple-soft: #f2edff;
            --amber: #b86d00;
            --amber-soft: #fff5df;
            --shadow: 0 18px 52px rgba(16, 42, 67, .08);
            --shadow-soft: 0 10px 30px rgba(16, 42, 67, .06);
            font-family: Inter, "Noto Sans TC", "Microsoft JhengHei", system-ui, sans-serif;
        }

        * { box-sizing: border-box; }
        html, body { min-width: 0; overflow-x: hidden; }
        body {
            margin: 0;
            color: var(--ink);
            background:
                radial-gradient(circle at 12% 8%, rgba(181, 222, 255, .65) 0, transparent 28%),
                radial-gradient(circle at 88% 5%, rgba(226, 218, 255, .72) 0, transparent 25%),
                linear-gradient(180deg, #f7fbff 0%, var(--canvas) 100%);
        }
        a { color: inherit; text-decoration: none; }
        .shell { min-height: 100vh; }

        .topbar {
            height: 68px;
            padding: 0 32px;
            background: rgba(255, 255, 255, .86);
            border-bottom: 1px solid rgba(219, 230, 242, .86);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            backdrop-filter: blur(14px);
        }
        .crumb { display: flex; align-items: center; gap: 11px; color: var(--muted); font-size: 13px; }
        .crumb a { color: var(--ink-2); font-weight: 780; }
        .nav-actions { display: flex; align-items: center; gap: 10px; min-width: 0; }
        .nav-link,
        .admin-pill,
        .date-pill {
            min-height: 36px;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 0 13px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: rgba(255, 255, 255, .9);
            color: var(--ink-2);
            font-size: 13px;
            font-weight: 760;
            white-space: nowrap;
        }
        .admin-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px var(--green-soft); }
        .study-nav { min-height:66px; display:flex; align-items:center; justify-content:space-between; gap:18px; padding:0 32px; background:rgba(255,255,255,.96); border-bottom:1px solid var(--line); }
        .brand { display:flex; align-items:center; gap:10px; color:var(--ink); font-size:14px; font-weight:900; white-space:nowrap; }.mark { width:30px; height:30px; display:grid; place-items:center; color:#fff; background:var(--blue); border-radius:5px; }.nav-links { display:flex; align-items:center; justify-content:flex-end; gap:3px; flex-wrap:wrap; }.nav-links a { padding:8px 10px; color:var(--muted); border-bottom:2px solid transparent; font-size:13px; font-weight:800; }.nav-links a:hover,.nav-links a.active { color:var(--blue); border-bottom-color:var(--blue); }.admin { margin-left:7px; padding:6px 9px; color:var(--teal); background:var(--teal-soft); border:1px solid #bfe4df; border-radius:4px; font-size:12px; font-weight:800; }
        .recall-pocket { margin:18px 0; border:1px solid var(--line); border-radius:7px; background:#fff; }.recall-pocket-head,.recall-pocket > summary { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; list-style:none; }.recall-pocket > summary { cursor:pointer; }.recall-pocket > summary::-webkit-details-marker { display:none; }.recall-pocket strong { display:block; font-size:14px; }.recall-count { color:var(--teal); font-size:12px; font-weight:850; }.recall-items { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; padding:12px; border-top:1px solid var(--line); }.recall-card { min-width:0; padding:13px; border:1px solid var(--line); border-radius:5px; background:#fbfdff; }.recall-card-title { overflow-wrap:anywhere; font-size:13px; font-weight:850; }.recall-card-note { min-width:0; margin-top:4px; color:var(--muted); font-size:12px; line-height:1.55; }.recall-card form { display:grid; gap:8px; margin-top:12px; }.recall-rating { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:4px; }.recall-rating label { cursor:pointer; }.recall-rating input { position:absolute; width:1px; height:1px; margin:0; opacity:0; }.recall-rating span { display:grid; min-height:30px; place-items:center; border:1px solid var(--line); border-radius:4px; color:var(--muted); background:#fff; font-size:11px; font-weight:850; }.recall-rating input:checked + span { color:#fff; border-color:var(--blue); background:var(--blue); }.recall-rate { min-height:34px; border:0; border-radius:4px; color:#fff; background:var(--blue); font-size:12px; font-weight:850; cursor:pointer; }.recall-rate:disabled { opacity:.6; cursor:wait; }.recall-rate-status { min-height:16px; margin:0; color:var(--red); font-size:11px; }.recall-card.is-completing { opacity:0; transform:scale(.98); transition:opacity .18s ease,transform .18s ease; }.recall-empty { padding:4px 16px 16px; color:var(--muted); font-size:13px; }
        .recall-cue { margin-top:9px; padding:9px 10px; color:#40536c; border-left:3px solid var(--blue); background:#f3f7fc; font-size:12px; font-weight:700; line-height:1.55; }.recall-reveal { width:100%; min-height:34px; margin-top:9px; color:var(--blue); border:1px solid #b9d0ed; border-radius:4px; background:#fff; font-size:11px; font-weight:900; cursor:pointer; }.recall-reveal:hover { background:var(--blue-soft); }.recall-answer { margin-top:9px; }.recall-answer[hidden] { display:none; }.recall-core { margin-bottom:7px; padding:8px 9px; color:var(--ink); border-left:3px solid var(--green); background:#edf8f1; font-size:12px; font-weight:750; line-height:1.55; }.recall-example-badge { display:inline-block; margin-left:6px; padding:2px 5px; color:#815000; border:1px solid #e3bd78; border-radius:3px; background:#fff4de; font-size:9px; }.recall-example { margin-bottom:7px; padding:8px 9px; color:#40536c; border-left:3px solid var(--blue); background:#f4f8fd; font-size:12px; line-height:1.55; }.recall-example.method { border-left-color:var(--teal); background:var(--teal-soft); }.recall-example.simple { border-left-color:var(--amber); background:var(--amber-soft); }.recall-example strong { margin-bottom:3px; color:var(--ink); font-size:10px; }
        .recall-empty { display:none; }
        [data-math-content] { min-width:0; max-width:100%; overflow-wrap:anywhere; } [data-math-content] > .katex { display:inline-block; max-width:100%; overflow-x:auto; overflow-y:hidden; vertical-align:middle; } [data-math-content] .katex-display { width:100%; max-width:100%; margin:.65em 0; padding:2px 0 5px; overflow-x:auto; overflow-y:hidden; overscroll-behavior-inline:contain; scrollbar-width:thin; } [data-math-content] .katex-display > .katex { display:table; width:max-content; min-width:max-content; max-width:none; margin:0 auto; overflow:visible; text-align:left; }
        .study-code-block { width:100%; max-width:100%; margin:9px 0; overflow:hidden; border:1px solid #cbd7e5; border-left:3px solid var(--teal); border-radius:5px; background:#172033; box-shadow:0 5px 14px rgba(23,32,51,.08); text-align:left; }
        .study-code-head { min-height:32px; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:4px 7px 4px 10px; border-bottom:1px solid #dce4ef; background:#f4f7fb; }
        .study-code-language { min-width:0; overflow:hidden; color:#53657d; font-size:9px; font-weight:900; letter-spacing:.04em; text-overflow:ellipsis; text-transform:uppercase; white-space:nowrap; }
        .study-code-copy { flex:0 0 auto; min-height:23px; padding:2px 6px; color:var(--blue); border:1px solid #bfd0e4; border-radius:3px; background:#fff; font-size:9px; font-weight:850; cursor:pointer; }
        .study-code-copy:hover,.study-code-copy:focus-visible { color:#fff; border-color:var(--blue); background:var(--blue); outline:0; }
        .study-code-copy.is-copied { color:var(--green); border-color:#a8d4bb; background:var(--green-soft); }
        .study-code-block pre { width:100%; max-width:100%; margin:0; padding:11px 12px 13px; overflow:auto; color:#edf4ff; background:#172033; font:11px/1.65 "Cascadia Code","SFMono-Regular",Consolas,"Liberation Mono",monospace; tab-size:4; white-space:pre; overscroll-behavior-inline:contain; scrollbar-color:#718096 #172033; }
        .study-code-block code { color:inherit; font:inherit; letter-spacing:0; }
        .study-inline-code { display:inline; padding:1px 3px; color:#076b6c; border:1px solid #cee5e3; border-radius:3px; background:#edf8f7; font:600 .9em/1.45 "Cascadia Code","SFMono-Regular",Consolas,"Liberation Mono",monospace; overflow-wrap:anywhere; }

        .content {
            width: min(1520px, 100%);
            margin: 0 auto;
            padding: 28px 32px 36px;
        }
        .page-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 18px;
        }
        h1 {
            margin: 0;
            font-size: clamp(34px, 4.5vw, 56px);
            line-height: .98;
            letter-spacing: -.06em;
        }
        .subtitle { margin: 9px 0 0; color: var(--muted); font-size: 15px; line-height: 1.55; }
        .head-tools { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }
        .continue-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 40px;
            padding: 9px 13px;
            border-radius: 8px;
            color: #fff;
            background: var(--blue);
            box-shadow: 0 8px 18px rgba(20,99,217,.18);
            font-size: 13px;
            font-weight: 900;
        }
        .continue-button:hover { background: #0c53b9; }
        .continue-button svg { width: 17px; height: 17px; flex: 0 0 auto; }

        .metric-strip {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 12px;
        }
        .metric-card {
            min-width: 0;
            min-height: 104px;
            padding: 15px 16px;
            border: 1px solid rgba(219, 230, 242, .94);
            border-radius: 8px;
            background: rgba(255, 255, 255, .92);
            box-shadow: var(--shadow-soft);
            display: grid;
            align-content: space-between;
            gap: 14px;
            position: relative;
            overflow: hidden;
        }
        .metric-card::after {
            display: none;
        }
        .metric-card.green::after { background: radial-gradient(circle, rgba(37, 137, 87, .14), transparent 67%); }
        .metric-card.purple::after { background: radial-gradient(circle, rgba(109, 75, 215, .14), transparent 67%); }
        .metric-card.early::after { background: radial-gradient(circle, rgba(15, 139, 141, .15), transparent 67%); }
        .metric-card.behind::after { background: radial-gradient(circle, rgba(184, 109, 0, .15), transparent 67%); }
        .metric-top { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .metric-label { color: var(--muted); font-size: 12px; font-weight: 820; letter-spacing: .02em; }
        .metric-icon {
            width: 38px;
            height: 38px;
            border-radius: 14px;
            color: var(--blue);
            background: var(--blue-soft);
            display: grid;
            place-items: center;
            flex: 0 0 auto;
        }
        .metric-card.green .metric-icon { color: var(--green); background: var(--green-soft); }
        .metric-card.purple .metric-icon { color: var(--purple); background: var(--purple-soft); }
        .metric-card.early .metric-icon { color: var(--teal); background: var(--teal-soft); }
        .metric-card.behind .metric-icon { color: var(--amber); background: var(--amber-soft); }
        .metric-icon svg { width: 20px; height: 20px; stroke-width: 2.4; }
        .metric-value {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: baseline;
            gap: 6px;
            min-width: 0;
            color: var(--ink);
            font-size: clamp(25px, 2.4vw, 34px);
            font-weight: 900;
            letter-spacing: -.06em;
            white-space: nowrap;
        }
        .metric-value small { color: var(--muted); font-size: 13px; font-weight: 760; letter-spacing: 0; }

        .study-calendar-panel {
            display: grid;
            grid-template-columns: minmax(230px, 280px) minmax(0, 1fr);
            gap: 0;
            margin-bottom: 18px;
            overflow: hidden;
            border: 1px solid rgba(201, 216, 233, .96);
            border-radius: 18px;
            background: rgba(255, 255, 255, .96);
            box-shadow: var(--shadow-soft);
        }
        .calendar-insight {
            position: relative;
            display: flex;
            min-width: 0;
            padding: 22px;
            flex-direction: column;
            background: linear-gradient(155deg, #102a43 0%, #164f91 100%);
            color: #fff;
            isolation: isolate;
        }
        .calendar-insight::after {
            content: "";
            position: absolute;
            z-index: -1;
            width: 190px;
            height: 190px;
            right: -80px;
            bottom: -92px;
            border-radius: 50%;
            background: rgba(106, 168, 255, .22);
        }
        .calendar-kicker { color: #9fc7f4; font-size: 10px; font-weight: 900; letter-spacing: .13em; }
        .calendar-insight h2 { margin: 7px 0 0; font-size: 22px; letter-spacing: -.035em; }
        .calendar-total { margin-top: 25px; }
        .calendar-total-value { display: block; font-size: 36px; font-weight: 950; line-height: 1; letter-spacing: -.06em; font-variant-numeric: tabular-nums; }
        .calendar-total-label { display: block; margin-top: 7px; color: #bdd7f4; font-size: 11px; font-weight: 760; }
        .calendar-mini-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 18px; }
        .calendar-mini-stat { min-width: 0; padding: 10px; border: 1px solid rgba(196, 221, 249, .22); border-radius: 9px; background: rgba(255, 255, 255, .08); }
        .calendar-mini-stat span { display: block; color: #bdd7f4; font-size: 10px; font-weight: 750; }
        .calendar-mini-stat strong { display: block; margin-top: 4px; overflow: hidden; font-size: 15px; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
        .calendar-focus {
            margin-top: auto;
            padding-top: 18px;
            color: #eaf4ff;
            font-size: 12px;
            line-height: 1.55;
        }
        .calendar-focus strong { display: block; margin-bottom: 3px; color: #fff; font-size: 13px; }
        .calendar-main { min-width: 0; padding: 19px 22px 21px; }
        .calendar-toolbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
        .calendar-heading { margin: 0; color: var(--ink); font-size: 18px; font-weight: 930; letter-spacing: -.025em; }
        .calendar-caption { margin-top: 4px; color: var(--muted); font-size: 11px; line-height: 1.45; }
        .calendar-nav { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
        .calendar-nav button {
            min-width: 34px;
            height: 34px;
            padding: 0 10px;
            border: 1px solid var(--line);
            border-radius: 8px;
            color: var(--ink-2);
            background: #fff;
            font: inherit;
            font-size: 12px;
            font-weight: 900;
            cursor: pointer;
        }
        .calendar-nav button:hover:not(:disabled) { color: var(--blue); border-color: #a9c8ef; background: var(--blue-soft); }
        .calendar-nav button:focus-visible, .calendar-day:focus-visible { outline: 3px solid rgba(20, 99, 217, .22); outline-offset: 2px; }
        .calendar-nav button:disabled { opacity: .38; cursor: default; }
        .calendar-weekdays, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
        .calendar-weekdays { margin-top: 17px; color: var(--soft); font-size: 10px; font-weight: 900; text-align: center; }
        .calendar-weekdays span { padding: 3px 0; }
        .calendar-grid { margin-top: 6px; }
        .calendar-day-placeholder { min-height: 64px; pointer-events: none; }
        .calendar-day {
            position: relative;
            display: flex;
            min-width: 0;
            min-height: 58px;
            padding: 7px;
            align-items: flex-start;
            justify-content: space-between;
            gap: 4px;
            border: 1px solid transparent;
            border-color: var(--calendar-cell-border, transparent);
            border-radius: 9px;
            color: var(--ink-2);
            background: linear-gradient(145deg, #fbfdff 0%, #edf3f9 100%);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .56);
            font: inherit;
            text-align: left;
            cursor: pointer;
            transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, filter .16s ease;
        }
        .calendar-day:hover { z-index: 1; transform: translateY(-2px); border-color: rgba(20, 99, 217, .24); box-shadow: 0 7px 16px rgba(16, 42, 67, .10); }
        .calendar-day.is-today { border-color: var(--blue); }
        .calendar-day.is-selected { box-shadow: none; }
        .calendar-date { font-size: 11px; font-weight: 900; font-variant-numeric: tabular-nums; }
        .calendar-duration { align-self: flex-end; overflow: hidden; font-size: 9px; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
        body.calendar-modal-open { overflow: hidden; }
        .calendar-modal {
            position: fixed;
            z-index: 1000;
            inset: 0;
            display: grid;
            padding: 18px;
            place-items: center;
            background: rgba(8, 25, 43, .58);
            backdrop-filter: blur(8px);
        }
        .calendar-modal[hidden] { display: none; }
        .calendar-dialog {
            width: min(560px, 100%);
            max-height: min(720px, calc(100vh - 36px));
            overflow: hidden;
            border: 1px solid rgba(219, 230, 242, .92);
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 28px 80px rgba(8, 25, 43, .26);
            animation: calendar-dialog-in .18s ease-out;
        }
        .calendar-dialog-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 21px 22px 17px; border-bottom: 1px solid var(--line); }
        .calendar-dialog-kicker { color: var(--blue); font-size: 10px; font-weight: 900; letter-spacing: .12em; }
        .calendar-dialog-title { margin: 5px 0 0; font-size: 22px; letter-spacing: -.035em; }
        .calendar-dialog-summary { margin-top: 6px; color: var(--muted); font-size: 12px; font-weight: 760; }
        .calendar-dialog-close { display: grid; width: 36px; height: 36px; padding: 0; place-items: center; flex: 0 0 auto; border: 1px solid var(--line); border-radius: 9px; color: var(--muted); background: #fff; font-size: 23px; line-height: 1; cursor: pointer; }
        .calendar-dialog-close:hover { color: var(--blue); border-color: #a9c8ef; background: var(--blue-soft); }
        .calendar-dialog-close:focus-visible { outline: 3px solid rgba(20,99,217,.22); outline-offset: 2px; }
        .calendar-dialog-body { max-height: calc(100vh - 190px); padding: 16px 22px 22px; overflow-y: auto; }
        .calendar-activity-list { display: grid; gap: 9px; }
        .calendar-activity-item { display: grid; grid-template-columns: 38px minmax(0, 1fr) auto; gap: 11px; align-items: center; padding: 12px; border: 1px solid var(--line); border-radius: 11px; background: #fbfdff; }
        .calendar-activity-icon { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 9px; color: var(--blue); background: var(--blue-soft); }
        .calendar-activity-icon svg { width: 17px; height: 17px; }
        .calendar-activity-item.is-correction .calendar-activity-icon { color: var(--amber); background: var(--amber-soft); }
        .calendar-activity-copy { min-width: 0; }
        .calendar-activity-title { overflow: hidden; color: var(--ink-2); font-size: 13px; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
        .calendar-activity-meta { margin-top: 4px; color: var(--muted); font-size: 11px; font-weight: 750; }
        .calendar-activity-time { color: var(--blue); font-size: 12px; font-weight: 950; white-space: nowrap; }
        .calendar-activity-item.is-correction .calendar-activity-time { color: var(--amber); }
        .calendar-activity-empty { padding: 34px 18px; color: var(--muted); border: 1px dashed #cbd8e5; border-radius: 12px; background: #f8fbfe; font-size: 13px; line-height: 1.65; text-align: center; }
        @keyframes calendar-dialog-in { from { opacity: 0; transform: translateY(8px) scale(.985); } to { opacity: 1; transform: none; } }

        .pace-panel {
            margin-bottom: 18px;
            padding: 20px;
            border: 1px solid rgba(219, 230, 242, .94);
            border-radius: 26px;
            background: rgba(255, 255, 255, .94);
            box-shadow: var(--shadow-soft);
        }
        .pace-panel.behind { border-color: #f0d6a5; background: linear-gradient(135deg, #fffaf0 0%, #ffffff 62%); }
        .pace-panel.early { border-color: #9bdcdd; background: linear-gradient(135deg, #effefe 0%, #ffffff 62%); }
        .pace-panel.active { border-color: #a8c7f4; background: linear-gradient(135deg, #eef5ff 0%, #ffffff 62%); }
        .pace-layout { display: grid; grid-template-columns: 1fr; gap: 18px; align-items: stretch; }
        .pace-layout > * { min-width: 0; }
        .pace-kicker { color: var(--muted); font-size: 12px; font-weight: 900; letter-spacing: .08em; }
        .pace-headline { margin-top: 8px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
        .pace-number { color: var(--ink); font-size: clamp(42px, 5vw, 60px); line-height: .9; font-weight: 950; letter-spacing: -.075em; font-variant-numeric: tabular-nums; }
        .pace-unit { color: var(--ink-2); font-size: 16px; font-weight: 900; }
        .pace-message { margin-top: 11px; color: var(--muted); font-size: 14px; line-height: 1.65; overflow-wrap: anywhere; }
        .race-course { position: relative; margin-top: 24px; padding: 44px 8px 42px; }
        .race-lane { position: relative; height: 68px; border: 2px solid #aebfd0; border-radius: 10px; background: repeating-linear-gradient(to bottom, transparent 0 20px, rgba(255,255,255,.94) 20px 22px), linear-gradient(90deg, #eef4fa, #e5edf5); box-shadow: inset 0 3px 10px rgba(61,83,107,.10), 0 8px 20px rgba(61,83,107,.08); overflow: visible; }
        .race-lane::before { content: ""; position: absolute; z-index: 1; inset: 0; border-radius: 8px; background: linear-gradient(90deg, rgba(20,99,217,.15), rgba(20,99,217,.07)); width: var(--actual-progress); }
        .race-lane::after { content: ""; position: absolute; z-index: 6; top: -2px; right: 8px; bottom: -2px; width: 10px; border: 1px solid rgba(16,42,67,.28); background: conic-gradient(#fff 25%, #29435e 0 50%, #fff 0 75%, #29435e 0) 0 0 / 8px 8px; box-shadow: 2px 0 0 rgba(255,255,255,.72); }
        .pace-panel.early .race-lane::before { background: linear-gradient(90deg, rgba(20,99,217,.12), rgba(15,143,143,.16)); }
        .race-progress { position: absolute; z-index: 2; left: 0; top: 22px; width: var(--actual-progress); height: 22px; border-radius: 0 999px 999px 0; background: linear-gradient(90deg, rgba(20,99,217,.48), rgba(20,99,217,.72)); box-shadow: inset 0 1px 0 rgba(255,255,255,.45); }
        .pace-panel.early .race-progress { background: linear-gradient(90deg, rgba(20,99,217,.48), rgba(15,143,143,.78)); }
        .race-milestones { position: absolute; z-index: 2; inset: 0; pointer-events: none; }
        .race-milestones span { position: absolute; top: 0; bottom: 0; left: var(--milestone); border-left: 1px dashed rgba(75,96,119,.34); }
        .race-milestones span::after { content: attr(data-label); position: absolute; top: 4px; left: 5px; color: rgba(63,82,103,.62); font-size: 8px; font-weight: 900; }
        .race-start-line { position: absolute; z-index: 3; top: -2px; bottom: -2px; left: 8px; width: 3px; background: #7f94aa; box-shadow: 4px 0 0 rgba(255,255,255,.82); }
        .race-delta-segment { position: absolute; z-index: 3; left: var(--gap-start); top: 22px; width: var(--gap-width); height: 22px; border-top: 2px solid rgba(20,99,217,.58); border-bottom: 2px solid rgba(20,99,217,.58); background: rgba(20,99,217,.18); }
        .pace-panel.behind .race-delta-segment { border-color: rgba(196,125,8,.72); background: repeating-linear-gradient(135deg, rgba(220,150,18,.50) 0 7px, rgba(255,223,160,.46) 7px 14px); }
        .pace-panel.early .race-delta-segment { border-color: rgba(8,121,121,.72); background: repeating-linear-gradient(135deg, rgba(15,143,143,.52) 0 7px, rgba(182,238,231,.48) 7px 14px); }
        .race-plan-marker { position: absolute; z-index: 5; top: -18px; bottom: -14px; left: var(--plan-position); width: 2px; transform: translateX(-50%); border-left: 2px dashed #8195aa; }
        .pace-panel.behind .race-plan-marker { border-left-color: var(--amber); }
        .race-plan-label, .race-actual-label { position: absolute; z-index: 8; transform: translateX(-50%); padding: 4px 7px; border: 1px solid #cbd7e3; border-radius: 6px; color: #52677d; background: #f4f7fa; box-shadow: 0 4px 10px rgba(61,83,107,.10); font-size: 10px; font-weight: 900; white-space: nowrap; }
        .race-plan-label { top: -43px; left: clamp(64px, var(--plan-position), calc(100% - 64px)); }
        .race-actual-label { top: 82px; left: clamp(64px, var(--runner-position), calc(100% - 64px)); border-color: #b9d2f3; color: #0c53b9; background: #edf5ff; box-shadow: 0 4px 10px rgba(20,99,217,.10); }
        .pace-panel.behind .race-plan-label { border-color: #edcf93; color: #8f5d04; background: #fff8e7; }
        .pace-panel.early .race-actual-label { border-color: #9bdcdd; color: #087979; background: #ecfbf9; }
        .race-runner { position: absolute; z-index: 7; top: 8px; left: clamp(24px, var(--runner-position), calc(100% - 24px)); width: 48px; height: 48px; transform: translateX(-50%); text-align: center; }
        .runner-person { position: relative; z-index: 2; display: block; width: 44px; height: 44px; border: 2px solid var(--blue); border-radius: 50%; background: rgba(255,255,255,.96); box-shadow: 0 7px 16px rgba(16,42,67,.20); font-size: 29px; line-height: 40px; animation: runner-stride .72s ease-in-out infinite; }
        .pace-panel.behind .runner-person { border-color: var(--amber); }
        .pace-panel.early .runner-person { border-color: var(--teal); }
        .runner-person > span { display: block; transform: scaleX(-1); }
        .runner-shadow { position: absolute; z-index: 1; left: 50%; bottom: -3px; width: 30px; height: 7px; transform: translateX(-50%); border-radius: 50%; background: rgba(16,42,67,.18); animation: runner-shadow .72s ease-in-out infinite; }
        .race-actual-marker { position: absolute; z-index: 5; top: 54px; left: clamp(24px, var(--runner-position), calc(100% - 24px)); height: 40px; transform: translateX(-50%); border-left: 2px solid var(--blue); }
        .pace-panel.early .race-actual-marker { border-left-color: var(--teal); }
        .race-scale { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 30px; color: var(--muted); font-size: 10px; font-weight: 850; }
        .pace-history { margin-top: 10px; padding-top: 14px; border-top: 1px solid rgba(174,191,208,.52); }
        .pace-history-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 8px; }
        .pace-history-head h3 { margin: 0; color: var(--ink-2); font-size: 16px; letter-spacing: 0; }
        .pace-history-summary { min-width: 0; display: flex; align-items: center; justify-content: flex-end; gap: 8px 12px; flex-wrap: wrap; }
        .pace-history-current { flex: 0 0 auto; min-height: 32px; display: inline-flex; align-items: baseline; gap: 6px; padding: 5px 9px; border: 1px solid #b9d2f3; border-radius: 6px; color: var(--blue); background: #edf5ff; }
        .pace-history-current.early { color: #087979; border-color: #9bdcdd; background: #ecfbf9; }
        .pace-history-current.behind { color: #9a6200; border-color: #edcf93; background: #fff8e7; }
        .pace-history-current span { font-size: 10px; font-weight: 850; }
        .pace-history-current strong { font-size: 16px; font-variant-numeric: tabular-nums; }
        .pace-history-trend { color: var(--ink-2); font-size: 11px; font-weight: 850; }
        .pace-history-range { color: var(--muted); font-size: 11px; font-weight: 760; }
        .pace-history-scroll { margin: 0; padding: 0 8px; overflow-x: auto; overscroll-behavior-inline: contain; border-radius: 8px; background: rgba(245,249,253,.72); scrollbar-color: #a8bbce transparent; }
        .pace-history-chart { display: block; width: 100%; min-width: 760px; height: auto; }
        .pace-history-grid { stroke: #dce6ef; stroke-width: 1; }
        .pace-history-zero { stroke: #8195aa; stroke-width: 1.5; stroke-dasharray: 6 5; }
        .pace-history-guide { stroke: rgba(174,191,208,.23); stroke-width: 1; }
        .pace-history-area { fill: rgba(20,99,217,.08); }
        .pace-panel.behind .pace-history-area { fill: rgba(196,125,8,.09); }
        .pace-panel.early .pace-history-area { fill: rgba(8,121,121,.09); }
        .pace-history-line { fill: none; stroke: #1463d9; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
        .pace-history-point { fill: #1463d9; stroke: #fff; stroke-width: 2; }
        .pace-history-point.early { fill: var(--teal); }
        .pace-history-point.behind { fill: var(--amber); }
        .pace-history-point.today { stroke-width: 3; }
        .pace-history-axis { fill: var(--muted); font-size: 10px; font-weight: 800; }
        .pace-history-value { fill: #0c53b9; font-size: 10px; font-weight: 900; font-variant-numeric: tabular-nums; }
        .pace-history-value.early { fill: #087979; }
        .pace-history-value.behind { fill: #9a6200; }
        .pace-history-date { fill: var(--muted); font-size: 10px; font-weight: 800; }
        .pace-history-date.today { fill: var(--ink-2); font-weight: 950; }
        .progress-compare { display: grid; gap: 13px; margin-top: 14px; }
        .compare-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; color: var(--ink-2); font-size: 13px; font-weight: 900; }
        .compare-head strong { font-size: 17px; font-variant-numeric: tabular-nums; }
        .compare-track { height: 13px; margin-top: 7px; border-radius: 999px; background: #e5edf5; overflow: hidden; }
        .compare-fill { height: 100%; width: var(--progress); border-radius: inherit; background: linear-gradient(90deg, var(--blue), var(--teal)); }
        .pace-panel.early .compare-row.actual .compare-fill { background: linear-gradient(90deg, var(--blue), var(--teal)); }
        .pace-panel.behind .compare-row.actual .compare-fill { background: linear-gradient(90deg, #2877df, #e0a12d); }
        .compare-row.target .compare-fill { background: #91a4b8; }
        @keyframes runner-stride { 0%,100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-5px) rotate(2deg); } }
        @keyframes runner-shadow { 0%,100% { opacity: .2; transform: translateX(-50%) scaleX(1); } 50% { opacity: .1; transform: translateX(-50%) scaleX(.72); } }
        .pace-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 14px; }
        .pace-stat { min-width: 0; padding: 11px; border: 1px solid var(--line); border-radius: 16px; background: rgba(255,255,255,.78); }
        .pace-stat-label { color: var(--muted); font-size: 11px; font-weight: 850; }
        .pace-stat-value { margin-top: 5px; color: var(--ink-2); font-size: 18px; font-weight: 950; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
        .today-log-panel {
            margin-bottom: 18px;
            padding: 20px;
            border: 1px solid rgba(219, 230, 242, .94);
            border-radius: 26px;
            background: rgba(255, 255, 255, .94);
            box-shadow: var(--shadow-soft);
        }
        .today-log-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 14px; }
        .today-log-stat { padding: 13px; border: 1px solid var(--line); border-radius: 16px; background: #fbfdff; }
        .today-log-label { color: var(--muted); font-size: 11px; font-weight: 850; }
        .today-log-value { margin-top: 6px; color: var(--ink); font-size: 22px; font-weight: 950; letter-spacing: -.04em; }
        .makeup-list, .today-video-list { display: grid; gap: 8px; margin-top: 12px; }
        .makeup-item, .today-video-item { padding: 10px 12px; border: 1px solid var(--line); border-radius: 14px; background: #fff; }
        .makeup-item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 12px; }
        .makeup-title, .today-video-title { color: var(--ink-2); font-size: 13px; font-weight: 900; }
        .makeup-meta, .today-video-meta { margin-top: 3px; color: var(--muted); font-size: 12px; font-weight: 760; line-height: 1.45; }
        .makeup-minutes { color: var(--blue); font-size: 13px; font-weight: 950; white-space: nowrap; }
        .makeup-track { grid-column: 1 / -1; height: 9px; border-radius: 999px; background: linear-gradient(90deg, #e7eef5 0 var(--before), #2b72dd var(--before) var(--after), #e7eef5 var(--after) 100%); overflow: hidden; }
        .makeup-foot { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 10px; color: var(--muted); font-size: 11px; font-weight: 760; }
        .makeup-foot strong { color: var(--blue); }

        .today-action-panel {
            margin-bottom: 14px;
            padding: 18px 20px;
            border: 1px solid rgba(201,216,233,.96);
            border-radius: 8px;
            background: rgba(255,255,255,.96);
            box-shadow: var(--shadow-soft);
        }

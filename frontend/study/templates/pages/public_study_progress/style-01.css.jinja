        .day-chip.complete .day-progress-fill { background: var(--green); }
        .day-chip.early .day-progress-fill { background: var(--teal); }
        .day-chip.partial .day-progress-fill { background: var(--purple); }
        .day-chip.active .day-progress-fill { background: var(--blue); }
        .day-chip.behind .day-progress-fill { background: var(--amber); }
        .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 390px); gap: 18px; margin-top: 18px; align-items: start; }
        .panel { border-radius: 28px; overflow: hidden; }

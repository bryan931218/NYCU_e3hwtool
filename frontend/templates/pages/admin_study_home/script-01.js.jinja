
        (() => {
            const root = document.querySelector('[data-study-calendar]');
            const dataNode = root?.querySelector('[data-calendar-data]');
            if (!root || !dataNode) return;

            let payload;
            try {
                payload = JSON.parse(dataNode.textContent || '{}');
            } catch (_) {
                return;
            }

            const dayDetailsByKey = new Map((payload.days || []).map((item) => [item.date, item]));
            const secondsByDay = new Map((payload.days || []).map((item) => [item.date, Number(item.seconds) || 0]));
            const todayKey = String(payload.today || '');
            const parseMonth = (value) => {
                const [year, month] = String(value || '').split('-').map(Number);
                return new Date(year, Math.max(0, (month || 1) - 1), 1);
            };
            const monthNumber = (value) => value.getFullYear() * 12 + value.getMonth();
            const pad = (value) => String(value).padStart(2, '0');
            const dayKey = (value) => `${value.getFullYear()}-${pad(value.getMonth() + 1)}-${pad(value.getDate())}`;
            const firstMonth = parseMonth(payload.first_month || payload.initial_month);
            const todayMonth = parseMonth(payload.initial_month);
            let visibleMonth = parseMonth(payload.initial_month);
            let selectedKey = todayKey;

            const grid = root.querySelector('[data-calendar-grid]');
            const heading = root.querySelector('[data-calendar-heading]');
            const previous = root.querySelector('[data-calendar-previous]');
            const next = root.querySelector('[data-calendar-next]');
            const currentButton = root.querySelector('[data-calendar-today]');
            const totalNode = root.querySelector('[data-calendar-total]');
            const activeNode = root.querySelector('[data-calendar-active-days]');
            const averageNode = root.querySelector('[data-calendar-average]');
            const bestNode = root.querySelector('[data-calendar-best]');
            const focusDateNode = root.querySelector('[data-calendar-focus-date]');
            const focusDurationNode = root.querySelector('[data-calendar-focus-duration]');
            const modal = document.querySelector('[data-calendar-modal]');
            const modalTitle = modal?.querySelector('[data-calendar-modal-title]');
            const modalSummary = modal?.querySelector('[data-calendar-modal-summary]');
            const modalList = modal?.querySelector('[data-calendar-modal-list]');
            const modalClose = modal?.querySelector('[data-calendar-modal-close]');
            let lastFocusedCell = null;

            const applyHeatColor = (cell, seconds, monthMaximum) => {
                if (seconds <= 0 || monthMaximum <= 0) {
                    cell.style.background = 'linear-gradient(145deg, #fbfdff 0%, #edf3f9 100%)';
                    cell.style.setProperty('--calendar-cell-border', '#e2eaf3');
                    cell.style.color = '#17324d';
                    return;
                }
                const ratio = Math.min(1, Math.max(0, seconds / monthMaximum));
                const intensity = Math.pow(ratio, .72);
                const hue = Math.round(211 + intensity * 10);
                const saturation = Math.round(76 + intensity * 14);
                const topLightness = Math.round(97 - intensity * 43);
                const bottomLightness = Math.round(94 - intensity * 54);
                const borderLightness = Math.max(35, bottomLightness - 5);
                cell.style.background = `linear-gradient(145deg, hsl(${hue}, ${saturation}%, ${topLightness}%) 0%, hsl(${hue + 3}, ${saturation}%, ${bottomLightness}%) 100%)`;
                cell.style.setProperty('--calendar-cell-border', `hsla(${hue}, ${saturation}%, ${borderLightness}%, .38)`);
                cell.style.color = intensity >= .54 ? '#fff' : '#17324d';
            };
            const compactDuration = (seconds) => {
                if (seconds <= 0) return '';
                if (seconds < 3600) return `${Math.max(1, Math.round(seconds / 60))}m`;
                const hours = seconds / 3600;
                return `${hours >= 10 ? Math.round(hours) : hours.toFixed(1).replace('.0', '')}h`;
            };
            const fullDuration = (seconds) => {
                if (seconds <= 0) return '尚無影片觀看紀錄';
                const minutes = Math.max(1, Math.round(seconds / 60));
                const hours = Math.floor(minutes / 60);
                const remainder = minutes % 60;
                if (!hours) return `觀看 ${minutes} 分鐘`;
                return `觀看 ${hours} 小時${remainder ? ` ${remainder} 分鐘` : ''}`;
            };
            const summaryDuration = (seconds) => {
                if (seconds <= 0) return '0h';
                if (seconds < 3600) return `${Math.max(1, Math.round(seconds / 60))} 分`;
                return `${(seconds / 3600).toFixed(1).replace('.0', '')}h`;
            };
            const spokenDate = (key) => {
                const [year, month, day] = key.split('-').map(Number);
                const date = new Date(year, month - 1, day);
                const weekday = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'][date.getDay()];
                return `${month} 月 ${day} 日・${weekday}`;
            };
            const activityDuration = (seconds) => {
                const minutes = Math.max(1, Math.round((Number(seconds) || 0) / 60));
                const hours = Math.floor(minutes / 60);
                const remainder = minutes % 60;
                if (!hours) return `${minutes} 分鐘`;
                return `${hours} 小時${remainder ? ` ${remainder} 分鐘` : ''}`;
            };
            const closeDayModal = () => {
                if (!modal || modal.hidden) return;
                modal.hidden = true;
                document.body.classList.remove('calendar-modal-open');
                lastFocusedCell?.focus();
            };
            const openDayModal = (key) => {
                if (!modal || !modalTitle || !modalSummary || !modalList) return;
                const detail = dayDetailsByKey.get(key) || { date: key, seconds: 0, activities: [] };
                const activities = Array.isArray(detail.activities) ? detail.activities : [];
                const watchedActivities = activities.filter((item) => !item.is_correction);
                modalTitle.textContent = spokenDate(key);
                modalSummary.textContent = `${fullDuration(Number(detail.seconds) || 0)}・${watchedActivities.length} 支影片有進度`;
                modalList.replaceChildren();
                if (!activities.length) {
                    const empty = document.createElement('div');
                    empty.className = 'calendar-activity-empty';
                    empty.textContent = '這一天尚未留下影片觀看活動。開始播放並儲存進度後，紀錄就會出現在這裡。';
                    modalList.appendChild(empty);
                } else {
                    activities.forEach((activity) => {
                        const item = document.createElement('article');
                        item.className = `calendar-activity-item${activity.is_correction ? ' is-correction' : ''}`;
                        const icon = document.createElement('span');
                        icon.className = 'calendar-activity-icon';
                        icon.innerHTML = activity.is_correction
                            ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h11a5 5 0 0 1 0 10H9"/><path d="m8 3-4 4 4 4"/></svg>'
                            : '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5L8 5.5Z"/></svg>';
                        const copy = document.createElement('div');
                        copy.className = 'calendar-activity-copy';
                        const title = document.createElement('div');
                        title.className = 'calendar-activity-title';
                        title.textContent = `${String(Number(activity.sequence) || 0).padStart(3, '0')}・${activity.title || '未命名影片'}`;
                        const meta = document.createElement('div');
                        meta.className = 'calendar-activity-meta';
                        meta.textContent = `${activity.subject || '未分類'}・${activity.is_correction ? '進度回退校正' : `目前完成 ${Number(activity.completion) || 0}%`}`;
                        copy.append(title, meta);
                        const time = document.createElement('strong');
                        time.className = 'calendar-activity-time';
                        time.textContent = `${activity.is_correction ? '−' : '+'}${activityDuration(activity.seconds)}`;
                        item.append(icon, copy, time);
                        modalList.appendChild(item);
                    });
                }
                lastFocusedCell = grid.querySelector(`[data-date="${key}"]`);
                modal.hidden = false;
                document.body.classList.add('calendar-modal-open');
                modalClose?.focus();
            };
            const updateFocus = (key) => {
                selectedKey = key;
                focusDateNode.textContent = spokenDate(key);
                focusDurationNode.textContent = fullDuration(secondsByDay.get(key) || 0);
                grid.querySelectorAll('.calendar-day').forEach((cell) => {
                    cell.classList.toggle('is-selected', cell.dataset.date === selectedKey);
                    cell.setAttribute('aria-selected', cell.dataset.date === selectedKey ? 'true' : 'false');
                });
            };
            const renderSummary = () => {
                const prefix = `${visibleMonth.getFullYear()}-${pad(visibleMonth.getMonth() + 1)}-`;
                const monthDays = [...secondsByDay.entries()]
                    .filter(([key, seconds]) => key.startsWith(prefix) && seconds > 0)
                    .sort(([left], [right]) => left.localeCompare(right));
                const total = monthDays.reduce((sum, [, seconds]) => sum + seconds, 0);
                const best = monthDays.reduce((winner, item) => (!winner || item[1] > winner[1] ? item : winner), null);
                totalNode.textContent = summaryDuration(total);
                activeNode.textContent = `${monthDays.length} 天`;
                averageNode.textContent = monthDays.length ? summaryDuration(total / monthDays.length) : '0 分';
                bestNode.textContent = best ? `${Number(best[0].slice(5, 7))}/${Number(best[0].slice(8, 10))}・${summaryDuration(best[1])}` : '尚無紀錄';
            };
            const render = () => {
                const year = visibleMonth.getFullYear();
                const month = visibleMonth.getMonth();
                const monthPrefix = `${year}-${pad(month + 1)}-`;
                const monthMaximum = Math.max(
                    0,
                    ...[...secondsByDay.entries()]
                        .filter(([key]) => key.startsWith(monthPrefix))
                        .map(([, seconds]) => seconds),
                );
                const firstWeekday = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();
                heading.textContent = `${year} 年 ${month + 1} 月`;
                grid.replaceChildren();
                for (let offset = 0; offset < firstWeekday; offset += 1) {
                    const placeholder = document.createElement('span');
                    placeholder.className = 'calendar-day-placeholder';
                    placeholder.setAttribute('aria-hidden', 'true');
                    grid.appendChild(placeholder);
                }
                for (let day = 1; day <= daysInMonth; day += 1) {
                    const date = new Date(year, month, day);
                    const key = dayKey(date);
                    const seconds = secondsByDay.get(key) || 0;
                    const cell = document.createElement('button');
                    cell.type = 'button';
                    cell.className = 'calendar-day';
                    cell.dataset.date = key;
                    cell.setAttribute('role', 'gridcell');
                    cell.setAttribute('aria-label', `${spokenDate(key)}，${fullDuration(seconds)}`);
                    cell.setAttribute('aria-selected', key === selectedKey ? 'true' : 'false');
                    if (key === todayKey) cell.classList.add('is-today');
                    if (key === selectedKey) cell.classList.add('is-selected');
                    applyHeatColor(cell, seconds, monthMaximum);
                    const dateLabel = document.createElement('span');
                    dateLabel.className = 'calendar-date';
                    dateLabel.textContent = String(date.getDate());
                    const duration = document.createElement('span');
                    duration.className = 'calendar-duration';
                    duration.textContent = compactDuration(seconds);
                    cell.append(dateLabel, duration);
                    cell.addEventListener('click', () => {
                        updateFocus(key);
                        openDayModal(key);
                    });
                    grid.appendChild(cell);
                }
                previous.disabled = monthNumber(visibleMonth) <= monthNumber(firstMonth);
                next.disabled = monthNumber(visibleMonth) >= monthNumber(todayMonth);
                renderSummary();
                const selectedInVisibleMonth = selectedKey.startsWith(`${year}-${pad(month + 1)}-`);
                if (!selectedInVisibleMonth) {
                    const visibleToday = todayKey.startsWith(`${year}-${pad(month + 1)}-`) ? todayKey : '';
                    const bestDay = [...secondsByDay.entries()]
                        .filter(([key]) => key.startsWith(`${year}-${pad(month + 1)}-`))
                        .sort((left, right) => right[1] - left[1])[0]?.[0];
                    selectedKey = visibleToday || bestDay || `${year}-${pad(month + 1)}-01`;
                }
                updateFocus(selectedKey);
            };

            previous.addEventListener('click', () => {
                if (previous.disabled) return;
                visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1);
                render();
            });
            next.addEventListener('click', () => {
                if (next.disabled) return;
                visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1);
                render();
            });
            currentButton.addEventListener('click', () => {
                visibleMonth = new Date(todayMonth);
                selectedKey = todayKey;
                render();
            });
            modalClose?.addEventListener('click', closeDayModal);
            modal?.addEventListener('click', (event) => {
                if (event.target === modal) closeDayModal();
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && modal && !modal.hidden) closeDayModal();
            });
            render();
        })();

        const STUDY_CODE_LANGUAGE_LABELS = Object.freeze({
            c: 'C', cpp: 'C++', 'c++': 'C++', cs: 'C#', csharp: 'C#',
            py: 'Python', python: 'Python', js: 'JavaScript', javascript: 'JavaScript',
            ts: 'TypeScript', typescript: 'TypeScript', java: 'Java', sql: 'SQL',
            pseudocode: '虛擬碼', pseudo: '虛擬碼', text: '程式碼', plaintext: '程式碼',
        });
        const appendStudyInlineCode = (fragment, value) => {
            const pattern = /`([^`\n]+)`/g;
            let cursor = 0;
            let match;
            while ((match = pattern.exec(value)) !== null) {
                if (match.index > cursor) fragment.append(document.createTextNode(value.slice(cursor, match.index)));
                const code = document.createElement('code');
                code.className = 'study-inline-code';
                code.textContent = match[1];
                fragment.append(code);
                cursor = pattern.lastIndex;
            }
            if (cursor < value.length) fragment.append(document.createTextNode(value.slice(cursor)));
        };
        window.renderStudyCodeBlocks = (element) => {
            if (!element || element.dataset.studyCodeRendered === 'true') return;
            const source = element.textContent || '';
            if (!source.includes('`')) {
                element.dataset.studyCodeRendered = 'true';
                return;
            }
            const fencePattern = /```[ \t]*([A-Za-z0-9_+#.\-]*)[ \t]*\n([\s\S]*?)```/g;
            const fragment = document.createDocumentFragment();
            let cursor = 0;
            let match;
            while ((match = fencePattern.exec(source)) !== null) {
                appendStudyInlineCode(fragment, source.slice(cursor, match.index));
                const rawLanguage = (match[1] || 'text').toLowerCase();
                const block = document.createElement('div');
                block.className = 'study-code-block';
                const head = document.createElement('div');
                head.className = 'study-code-head';
                const language = document.createElement('span');
                language.className = 'study-code-language';
                language.textContent = STUDY_CODE_LANGUAGE_LABELS[rawLanguage] || rawLanguage || '程式碼';
                const copy = document.createElement('button');
                copy.type = 'button';
                copy.className = 'study-code-copy';
                copy.textContent = '複製';
                copy.title = '複製程式碼';
                copy.setAttribute('aria-label', '複製程式碼');
                const pre = document.createElement('pre');
                const code = document.createElement('code');
                code.dataset.studyCode = '';
                code.textContent = match[2].replace(/^\n/, '').replace(/\n[ \t]*$/, '');
                pre.append(code);
                head.append(language, copy);
                block.append(head, pre);
                fragment.append(block);
                cursor = fencePattern.lastIndex;
            }
            appendStudyInlineCode(fragment, source.slice(cursor));
            element.replaceChildren(fragment);
            element.dataset.studyCodeRendered = 'true';
        };
        document.addEventListener('click', async (event) => {
            const button = event.target.closest?.('.study-code-copy');
            if (!button) return;
            const value = button.closest('.study-code-block')?.querySelector('[data-study-code]')?.textContent || '';
            try {
                if (!navigator.clipboard?.writeText) throw new Error('clipboard_unavailable');
                await navigator.clipboard.writeText(value);
            } catch (_error) {
                const textarea = document.createElement('textarea');
                textarea.value = value;
                textarea.setAttribute('readonly', '');
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.append(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            }
            button.textContent = '已複製';
            button.classList.add('is-copied');
            window.setTimeout(() => {
                button.textContent = '複製';
                button.classList.remove('is-copied');
            }, 1400);
        });
        window.renderStudyMath = (root = document) => {
            const queryAll = (selector) => [
                ...(root.matches?.(selector) ? [root] : []),
                ...root.querySelectorAll(selector),
            ];
            const isDeferred = (element) => {
                if (element.closest('[hidden]')) return true;
                let ancestor = element.parentElement;
                while (ancestor) {
                    if (ancestor.tagName === 'DETAILS' && !ancestor.open) {
                        const summary = Array.from(ancestor.children).find((child) => child.tagName === 'SUMMARY');
                        if (!summary?.contains(element)) return true;
                    }
                    ancestor = ancestor.parentElement;
                }
                return false;
            };
            queryAll('.recall-card-title').forEach((element) => { element.dataset.mathContent = ''; });
            queryAll('[data-math-content]').forEach((element) => {
                if (isDeferred(element)) return;
                window.renderStudyCodeBlocks(element);
                if (!window.renderMathInElement || element.dataset.mathRendered === 'true') return;
                window.renderMathInElement(element, {
                    delimiters: [
                        { left: '$$', right: '$$', display: true },
                        { left: '$', right: '$', display: false },
                        { left: '\\[', right: '\\]', display: true },
                        { left: '\\(', right: '\\)', display: false },
                    ],
                    ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
                    throwOnError: false,
                    strict: 'ignore',
                });
                element.dataset.mathRendered = 'true';
            });
        };
        document.addEventListener('toggle', (event) => {
            const detail = event.target;
            if (detail instanceof HTMLDetailsElement && detail.open) window.renderStudyMath(detail);
        }, true);
        (() => {
            document.querySelectorAll('[data-recall-card]').forEach((card) => {
                const reveal = card.querySelector('[data-recall-reveal]');
                const answer = card.querySelector('[data-recall-answer]');
                if (!reveal || !answer) return;
                reveal.addEventListener('click', () => {
                    const shouldReveal = answer.hidden;
                    answer.hidden = !shouldReveal;
                    reveal.textContent = shouldReveal ? '收起重點' : '揭示重點';
                    reveal.setAttribute('aria-expanded', shouldReveal ? 'true' : 'false');
                    if (shouldReveal) window.renderStudyMath();
                });
            });
        })();
        (() => {
            const updateDueCounts = (count) => {
                document.querySelectorAll('[data-recall-due-count]').forEach((node) => {
                    node.textContent = `${count} ${node.dataset.countLabel || '張待複習'}`;
                });
            };
            const removeRatedCard = (card) => {
                card.classList.add('is-completing');
                window.setTimeout(() => {
                    const list = card.closest('[data-recall-card-list]');
                    card.remove();
                    if (list && !list.querySelector('[data-recall-card]')) {
                        list.hidden = true;
                        const empty = list.parentElement.querySelector('[data-recall-empty]');
                        if (empty) empty.hidden = false;
                    }
                }, 180);
            };
            document.querySelectorAll('form[data-recall-rating-form]').forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    if (form.dataset.submitting === 'true') return;
                    const status = form.querySelector('[data-recall-rating-status]');
                    const button = form.querySelector('button[type="submit"]');
                    if (!form.querySelector('input[type="radio"]:checked')) {
                        if (status) status.textContent = '請先選擇印象分。';
                        return;
                    }
                    form.dataset.submitting = 'true';
                    if (status) status.textContent = '';
                    const originalLabel = button.textContent;
                    button.disabled = true;
                    button.textContent = '儲存中…';
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            credentials: 'same-origin',
                            headers: { 'X-E3-Recall-Rating': '1', Accept: 'application/json' },
                        });
                        const result = await response.json().catch(() => ({}));
                        if (!response.ok || !result.ok) throw new Error(result.error || '印象分暫時無法儲存，請再試一次。');
                        updateDueCounts(result.remaining_due_count);
                        const card = form.closest('[data-recall-card]');
                        if (card) removeRatedCard(card);
                    } catch (error) {
                        if (status) status.textContent = error.message || '印象分暫時無法儲存，請再試一次。';
                        button.disabled = false;
                        button.textContent = originalLabel;
                        form.dataset.submitting = '';
                    }
                });
            });
        })();

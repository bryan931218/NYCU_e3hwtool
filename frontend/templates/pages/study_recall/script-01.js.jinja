            const clampPanelPosition = () => {
                if (dialog.hidden || !dialog.style.left || !dialog.style.top) return;
                let rect = dialog.getBoundingClientRect();
                const margin = window.innerWidth <= 620 ? 10 : 8;
                const availableWidth = Math.max(0, window.innerWidth - margin * 2);
                const targetWidth = Math.min(preferredPanelWidth || rect.width, availableWidth);
                dialog.style.width = `${targetWidth}px`;
                rect = dialog.getBoundingClientRect();
                const maxLeft = Math.max(margin, window.innerWidth - rect.width - margin);

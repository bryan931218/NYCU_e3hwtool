
        :root { --ink:#172b3d; --muted:#66788a; --line:#dbe5ed; --blue:#2463eb; --blue-soft:#edf4ff; --mint:#087c72; --mint-soft:#eaf8f5; --green:#1b7d50; --green-soft:#edf8f1; --amber:#9b6207; --amber-soft:#fff7e7; --rose:#ac4051; --rose-soft:#fff1f3; font-family:Inter,"Noto Sans TC","Microsoft JhengHei",system-ui,sans-serif; }
        * { box-sizing:border-box; }
        [hidden] { display:none!important; }
        html { min-width:0; background:#f5f8fb; }
        body { min-width:0; min-height:100vh; margin:0; color:var(--ink); background:radial-gradient(circle at 6% -4%,rgba(105,174,255,.2),transparent 29%),radial-gradient(circle at 98% 2%,rgba(82,196,174,.16),transparent 25%),#f5f8fb; }
        button,a { font:inherit; }
        a { color:inherit; text-decoration:none; }
        button { -webkit-tap-highlight-color:transparent; }
        button:focus-visible,a:focus-visible,summary:focus-visible { outline:3px solid rgba(36,99,235,.16); outline-offset:2px; }
        .study-nav { position:sticky; z-index:20; top:0; min-height:64px; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:9px 28px; border-bottom:1px solid rgba(211,222,232,.8); background:rgba(255,255,255,.88); backdrop-filter:blur(18px) saturate(1.1); }
        .brand { display:flex; align-items:center; gap:10px; font-size:13px; font-weight:900; white-space:nowrap; }
        .mark { width:36px; height:36px; display:grid; place-items:center; color:#fff; border-radius:11px; background:linear-gradient(145deg,#2b75f2,#1749ae); box-shadow:0 8px 17px rgba(36,99,235,.21); }
        .nav-link { min-height:38px; display:inline-flex; align-items:center; padding:0 13px; color:#506579; border-radius:10px; font-size:12px; font-weight:850; }
        .nav-link:hover { color:var(--blue); background:var(--blue-soft); }
        .quick-shell { width:min(930px,100%); margin:0 auto; padding:26px 22px 52px; }
        .session-head { display:grid; gap:14px; margin-bottom:16px; }
        .session-top { display:flex; align-items:end; justify-content:space-between; gap:18px; }
        .eyebrow { margin:0 0 6px; color:var(--mint); font-size:10px; font-weight:950; letter-spacing:.14em; }
        h1 { margin:0; font-size:clamp(30px,5vw,42px); line-height:1; letter-spacing:-.05em; }
        .session-copy { margin:8px 0 0; color:var(--muted); font-size:12px; font-weight:700; }
        .session-meta { display:flex; align-items:center; gap:7px; color:var(--muted); font-size:11px; font-weight:850; }
        .timer { min-width:62px; padding:8px 10px; text-align:center; border:1px solid var(--line); border-radius:999px; background:rgba(255,255,255,.9); font-variant-numeric:tabular-nums; }
        .progress-row { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:12px; }
        .progress-track { height:6px; overflow:hidden; border-radius:999px; background:#dfe8f0; }
        .progress-bar { width:0; height:100%; border-radius:inherit; background:linear-gradient(90deg,#2871ed,#0d9488); transition:width .25s ease; }
        .progress-label { color:var(--muted); font-size:11px; font-weight:850; white-space:nowrap; }
        .mode-picker { display:grid; grid-template-columns:repeat(3,1fr); gap:5px; padding:5px; border:1px solid var(--line); border-radius:13px; background:rgba(255,255,255,.78); }
        .mode-picker a { min-height:35px; display:grid; place-items:center; padding:0 10px; color:var(--muted); border-radius:9px; font-size:11px; font-weight:850; white-space:nowrap; }
        .mode-picker a:hover { color:var(--blue); background:var(--blue-soft); }
        .mode-picker a.active { color:#fff; background:#245fcf; box-shadow:0 5px 12px rgba(36,95,207,.18); }
        .card-stage { position:relative; min-height:470px; }
        .quick-card { min-height:470px; padding:22px; overflow:hidden; border:1px solid rgba(204,217,229,.95); border-radius:23px; background:rgba(255,255,255,.98); box-shadow:0 22px 55px rgba(23,43,61,.09),inset 0 1px 0 #fff; }
        .quick-card[hidden] { display:none; }
        .card-top { display:flex; align-items:center; justify-content:space-between; gap:12px; }
        .card-tags { min-width:0; display:flex; align-items:center; flex-wrap:wrap; gap:6px; }
        .tag { max-width:260px; overflow:hidden; padding:5px 8px; color:#50677c; text-overflow:ellipsis; white-space:nowrap; border:1px solid var(--line); border-radius:999px; background:#f8fafc; font-size:10px; font-weight:900; }
        .tag.subject { color:#096b64; border-color:#b9ddd7; background:var(--mint-soft); }
        .card-estimate { color:#8494a4; font-size:10px; font-weight:850; white-space:nowrap; }
        .phase-rail { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; margin:18px 0 0; }
        .phase { min-width:0; display:flex; align-items:center; gap:7px; color:#93a1af; font-size:10px; font-weight:850; }
        .phase::before { content:attr(data-step); flex:0 0 auto; width:22px; height:22px; display:grid; place-items:center; border:1px solid #d4dfe8; border-radius:50%; background:#f7f9fb; font-size:9px; }
        .phase::after { content:""; min-width:8px; height:1px; flex:1; order:2; background:#dfe6ec; }
        .phase:last-child::after { display:none; }
        .phase.is-active { color:var(--blue); }
        .phase.is-active::before { color:#fff; border-color:var(--blue); background:var(--blue); box-shadow:0 4px 10px rgba(36,99,235,.18); }
        .quick-card.is-revealed .phase:nth-child(2),.quick-card.is-revealed .phase:nth-child(3) { color:var(--blue); }
        .quick-card.is-revealed .phase:nth-child(2)::before,.quick-card.is-revealed .phase:nth-child(3)::before { color:#fff; border-color:var(--blue); background:var(--blue); }
        .prompt-block { display:grid; justify-items:start; gap:10px; padding:31px 20px 27px; }
        .prompt-meta { display:flex; align-items:center; flex-wrap:wrap; gap:7px; }
        .prompt-label { padding:5px 9px; color:var(--blue); border-radius:7px; background:var(--blue-soft); font-size:10px; font-weight:950; }
        .prompt-mission { color:#607386; font-size:11px; font-weight:780; }
        .prompt-block h2 { max-width:800px; margin:0; font-size:clamp(23px,4vw,32px); line-height:1.45; letter-spacing:-.025em; overflow-wrap:anywhere; }
        .question-instruction { max-width:690px; margin:0; color:var(--muted); font-size:13px; font-weight:700; line-height:1.65; }
        .concept-title { margin:1px 0 0; color:#96a3af; font-size:10px; font-weight:800; }
        .exam-options { display:grid; gap:8px; padding:0 2px 12px; }
        .exam-option { width:100%; min-width:0; display:grid; grid-template-columns:31px minmax(0,1fr); align-items:start; gap:11px; padding:13px 14px; color:#344d63; text-align:left; border:1px solid var(--line); border-radius:13px; background:#fbfcfe; cursor:pointer; }
        .option-letter { width:29px; height:29px; display:grid; place-items:center; color:#4f6b84; border:1px solid #cad8e4; border-radius:9px; background:#fff; font-size:11px; font-weight:950; }
        .option-text { min-width:0; padding-top:3px; font-size:13px; font-weight:720; line-height:1.65; white-space:pre-line; overflow-wrap:anywhere; }
        .exam-option:hover,.exam-option.is-selected { border-color:#8bb8ed; background:#f1f6ff; }
        .exam-option.is-selected .option-letter { color:#fff; border-color:var(--blue); background:var(--blue); }
        .exam-option.is-correct { color:#1d6946; border-color:#8dcca7; background:var(--green-soft); }
        .exam-option.is-correct .option-letter { color:#fff; border-color:var(--green); background:var(--green); }
        .exam-option.is-wrong { color:#913444; border-color:#e3a8b2; background:var(--rose-soft); }
        .exam-option.is-wrong .option-letter { color:#fff; border-color:var(--rose); background:var(--rose); }
        .exam-option:disabled { cursor:default; }
        .written-work { display:grid; gap:7px; padding:0 2px 12px; }
        .written-work label { color:#617589; font-size:11px; font-weight:850; }
        .written-work textarea { width:100%; min-height:78px; resize:vertical; padding:12px 13px; color:var(--ink); border:1px solid var(--line); border-radius:12px; background:#fbfcfe; font-size:13px; line-height:1.6; }
        .reveal-wrap { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; padding:0 2px; }
        .reveal-button,.hint-button { min-height:51px; border-radius:13px; font-size:13px; font-weight:950; cursor:pointer; }
        .reveal-button { color:#fff; border:0; background:linear-gradient(135deg,#266be8,#174db4); box-shadow:0 9px 20px rgba(36,99,235,.18); }
        .hint-button { min-width:116px; padding:0 15px; color:#4c647a; border:1px solid var(--line); background:#f8fafc; }
        .reveal-button:hover,.hint-button:hover { transform:translateY(-1px); }
        .hint-box { grid-column:1/-1; display:grid; grid-template-columns:auto minmax(0,1fr); gap:8px; padding:11px 13px; color:#62512f; border:1px solid #ead6a9; border-radius:11px; background:var(--amber-soft); font-size:12px; line-height:1.65; }
        .hint-box strong { color:var(--amber); }
        .shortcut { grid-column:1/-1; margin:1px 0 0; color:#9aa7b3; text-align:center; font-size:10px; font-weight:750; }
        .answer { display:grid; gap:11px; margin-top:9px; }
        .answer-head { display:flex; align-items:end; justify-content:space-between; gap:16px; padding:0 2px; }
        .answer-head span { color:var(--green); font-size:9px; font-weight:950; letter-spacing:.13em; }
        .answer-head h3 { margin:3px 0 0; font-size:20px; letter-spacing:-.025em; }
        .answer-head p { max-width:350px; margin:0; color:var(--muted); text-align:right; font-size:11px; line-height:1.45; }
        .answer-sheet { min-width:0; overflow:hidden; border:1px solid #cce2d4; border-radius:17px; background:linear-gradient(145deg,#f6fcf8,#fff); }
        .answer-core { min-width:0; padding:17px 18px; }
        .answer-method { min-width:0; padding:14px 18px; border-top:1px solid #dcece2; background:rgba(255,255,255,.55); }
        .answer-label { display:block; margin-bottom:7px; color:var(--green); font-size:10px; font-weight:950; }
        .answer-core p,.answer-method p { min-width:0; margin:0; color:#244738; font-size:15px; font-weight:760; line-height:1.75; white-space:pre-line; overflow-wrap:anywhere; }
        .answer-method p { color:#405d50; font-size:13px; font-weight:720; }
        .answer-steps { margin:0; padding:0; list-style:none; border-top:1px solid #dcece2; counter-reset:answer-step; }
        .answer-steps li { min-width:0; display:grid; grid-template-columns:26px minmax(0,1fr); gap:10px; padding:12px 18px; color:#405d50; font-size:13px; line-height:1.68; counter-increment:answer-step; overflow-wrap:anywhere; }
        .answer-steps li + li { border-top:1px solid #e5efe9; }
        .answer-steps li::before { content:counter(answer-step); width:24px; height:24px; display:grid; place-items:center; color:var(--green); border:1px solid #bcd9c6; border-radius:8px; background:#fff; font-size:10px; font-weight:950; }
        .pitfall { min-width:0; display:grid; grid-template-columns:auto minmax(0,1fr); gap:9px; padding:12px 14px; color:#6d5221; border:1px solid #ecd4a5; border-radius:12px; background:var(--amber-soft); font-size:12px; line-height:1.65; }
        .pitfall strong { white-space:nowrap; }
        .pitfall span { min-width:0; white-space:pre-line; overflow-wrap:anywhere; }
        .answer-detail { overflow:hidden; border:1px solid var(--line); border-radius:12px; background:#fff; }
        .answer-detail summary { padding:12px 14px; color:#5f7285; font-size:11px; font-weight:850; cursor:pointer; }
        .answer-detail-body { display:grid; gap:10px; padding:0 14px 14px; }
        .answer-detail-body p { min-width:0; margin:0; color:#526a7e; font-size:13px; line-height:1.75; white-space:pre-line; overflow-wrap:anywhere; }
        .answer-detail-body p + p { padding-top:10px; border-top:1px solid #e7edf2; }
        [data-math-content] .katex-display { max-width:100%; margin:.65em 0; overflow-x:auto; overflow-y:hidden; padding:3px 0 6px; text-align:left; }
        .rating-panel { display:grid; gap:9px; margin-top:3px; padding-top:2px; }
        .rating-question { margin:0; color:#50667a; font-size:12px; font-weight:850; }
        .rating-actions { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; }
        .rating-button { min-width:0; min-height:61px; display:grid; align-content:center; gap:3px; padding:7px; border-radius:13px; background:#fff; font-size:13px; font-weight:950; cursor:pointer; }
        .rating-button small { font-size:9px; font-weight:750; opacity:.72; }
        .rating-button.forgot { color:var(--rose); border:1px solid #edc7ce; background:var(--rose-soft); }
        .rating-button.fuzzy { color:var(--amber); border:1px solid #ead19d; background:var(--amber-soft); }
        .rating-button.know { color:var(--green); border:1px solid #bcdcc8; background:var(--green-soft); }
        .rating-button:hover { transform:translateY(-1px); filter:saturate(1.08); }
        .rating-button:disabled { opacity:.52; cursor:wait; transform:none; }
        .objective-feedback { display:grid; grid-template-columns:auto minmax(0,1fr); align-items:start; gap:9px; padding:12px 14px; border:1px solid #bcdcc8; border-radius:12px; background:var(--green-soft); color:#245d42; }
        .objective-feedback.is-wrong { color:#873747; border-color:#e4b0b9; background:var(--rose-soft); }
        .objective-feedback strong { font-size:12px; white-space:nowrap; }
        .objective-feedback span { min-width:0; font-size:12px; line-height:1.6; }
        .objective-next { min-height:51px; color:#fff; border:0; border-radius:13px; background:linear-gradient(135deg,#266be8,#174db4); font-size:13px; font-weight:950; cursor:pointer; }
        .rescue-note { padding:11px 13px; color:#12655e; border:1px solid #b9ddd7; border-radius:11px; background:var(--mint-soft); font-size:12px; line-height:1.6; }
        .rescue-next { min-height:51px; color:#fff; border:0; border-radius:13px; background:linear-gradient(135deg,#0b8b7e,#07655f); font-size:13px; font-weight:950; cursor:pointer; }
        .save-status { min-height:16px; margin:0; color:var(--rose); text-align:center; font-size:11px; }
        .completion,.empty-state { min-height:470px; display:grid; place-items:center; padding:34px; text-align:center; border:1px solid rgba(204,217,229,.95); border-radius:23px; background:#fff; box-shadow:0 22px 55px rgba(23,43,61,.09); }
        .completion-icon { width:64px; height:64px; display:grid; place-items:center; margin:0 auto 17px; color:#fff; border-radius:20px; background:linear-gradient(145deg,#1d9a68,#087a72); box-shadow:0 12px 25px rgba(16,133,104,.2); font-size:28px; font-weight:950; }
        .completion h2,.empty-state h2 { margin:0; font-size:29px; letter-spacing:-.04em; }
        .completion-copy,.empty-state p { max-width:470px; margin:9px auto 0; color:var(--muted); font-size:13px; line-height:1.7; }
        .result-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; margin:22px 0; }
        .result-item { min-width:92px; padding:12px 10px; border:1px solid var(--line); border-radius:12px; background:#f8fafc; }
        .result-item strong { display:block; font-size:22px; }
        .result-item span { display:block; margin-top:3px; color:var(--muted); font-size:10px; font-weight:850; }
        .completion-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:8px; }
        .completion-actions a,.empty-state a { min-height:42px; display:inline-flex; align-items:center; padding:0 15px; border:1px solid var(--line); border-radius:11px; color:#4f6578; background:#fff; font-size:12px; font-weight:900; }
        .completion-actions a.primary,.empty-state a { color:#fff; border-color:var(--blue); background:var(--blue); }
        .empty-state p { margin-bottom:21px; }
        .session-foot { display:flex; justify-content:center; gap:14px; margin-top:13px; color:#8a99a7; font-size:10px; font-weight:800; }
        .study-code-block { width:100%; max-width:100%; margin:10px 0; overflow:hidden; border:1px solid #cbd7e5; border-left:3px solid var(--mint); border-radius:8px; background:#172033; box-shadow:0 5px 14px rgba(23,32,51,.08); text-align:left; }
        .study-code-head { min-height:34px; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:5px 8px 5px 11px; border-bottom:1px solid #dce4ef; background:#f4f7fb; }
        .study-code-language { min-width:0; overflow:hidden; color:#53657d; font-size:10px; font-weight:900; letter-spacing:.04em; text-overflow:ellipsis; text-transform:uppercase; white-space:nowrap; }
        .study-code-copy { flex:0 0 auto; min-height:24px; padding:2px 7px; color:var(--blue); border:1px solid #bfd0e4; border-radius:4px; background:#fff; font-size:10px; font-weight:850; cursor:pointer; }
        .study-code-copy:hover,.study-code-copy:focus-visible { color:#fff; border-color:var(--blue); background:var(--blue); outline:0; }
        .study-code-copy.is-copied { color:var(--green); border-color:#a8d4bb; background:var(--green-soft); }
        .study-code-block pre { width:100%; max-width:100%; margin:0; padding:13px 14px 15px; overflow:auto; color:#edf4ff; background:#172033; font:12px/1.7 "Cascadia Code","SFMono-Regular",Consolas,"Liberation Mono",monospace; tab-size:4; white-space:pre; overscroll-behavior-inline:contain; scrollbar-color:#718096 #172033; }
        .study-code-block code { color:inherit; font:inherit; letter-spacing:0; }
        .study-inline-code { display:inline; padding:1px 4px; color:#076b6c; border:1px solid #cee5e3; border-radius:3px; background:#edf8f7; font:600 .9em/1.45 "Cascadia Code","SFMono-Regular",Consolas,"Liberation Mono",monospace; overflow-wrap:anywhere; }
        @media (max-width:640px) {
            .study-nav { min-height:58px; padding:8px 12px; }
            .brand span:last-child { display:none; }
            .nav-link { min-height:36px; padding:0 9px; }
            .quick-shell { padding:17px 10px 32px; }
            .session-top { align-items:start; }
            .session-copy { display:none; }
            .session-meta { align-items:flex-end; flex-direction:column; }
            h1 { font-size:31px; }
            .mode-picker { overflow-x:auto; grid-template-columns:repeat(3,minmax(86px,1fr)); }
            .card-stage,.quick-card,.completion,.empty-state { min-height:calc(100dvh - 231px); }
            .quick-card { padding:15px 13px; border-radius:19px; }
            .card-estimate { display:none; }
            .tag { max-width:150px; }
            .phase-rail { margin-top:14px; }
            .phase { gap:5px; font-size:9px; }
            .phase::before { width:20px; height:20px; }
            .prompt-block { gap:9px; padding:25px 3px 23px; }
            .prompt-block h2 { font-size:22px; line-height:1.5; }
            .question-instruction { font-size:12px; }
            .exam-option { padding:11px 10px; grid-template-columns:29px minmax(0,1fr); }
            .option-text { font-size:12px; }
            .reveal-wrap { grid-template-columns:1fr; }
            .hint-button { min-width:0; min-height:43px; grid-row:2; }
            .hint-box,.shortcut { grid-column:1; }
            .answer-head { align-items:start; flex-direction:column; gap:4px; }
            .answer-head p { text-align:left; }
            .answer-core { padding:15px 13px; }
            .answer-core p { font-size:14px; }
            .answer-steps li { padding:11px 13px; }
            .rating-actions { gap:5px; }
            .rating-button { min-height:59px; padding:6px 3px; font-size:12px; }
            .completion,.empty-state { padding:25px 14px; border-radius:19px; }
            .result-grid { width:100%; gap:5px; }
            .result-item { min-width:0; padding:11px 4px; }
            .session-foot { display:none; }
            .study-code-block pre { padding:11px 12px 13px; font-size:11px; }
        }
        @media (prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; transition:none!important; } }

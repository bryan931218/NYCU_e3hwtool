            const initialParams = new URLSearchParams(window.location.search);
            const requestedVideoId = initialParams.get('video_id') || '';
            const shouldFocusRequestedVideo = Boolean(requestedVideoId || window.location.hash === '#youtube-player-section');

            if (!videoSelect || !durationHint) return;

            const setVideoSummaryOpen = function (isOpen) {
                if (!videoSummary || !videoSummaryToggle || !videoSummaryBody) return;
                videoSummary.classList.toggle('is-open', Boolean(isOpen));
                videoSummaryBody.hidden = !isOpen;

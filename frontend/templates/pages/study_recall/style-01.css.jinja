        .topic-section { padding:16px 20px 4px; }.topic-section + .topic-section { margin-top:12px; border-top:1px solid var(--line); }.topic-section-head { display:flex; align-items:end; justify-content:space-between; gap:12px; }.topic-section-head h3 { margin:3px 0 0; font-size:17px; }.topic-kicker { color:var(--teal); font-size:10px; font-weight:900; }.topic-section .concepts { margin-top:10px; }.related-cards { display:flex; align-items:center; flex-wrap:wrap; gap:6px; margin-top:11px; padding-top:10px; border-top:1px dashed var(--line); }.related-label { color:var(--muted); font-size:11px; font-weight:800; }.related-tags { display:flex; min-width:0; flex-wrap:wrap; gap:5px; }.related-tag { max-width:100%; min-height:27px; padding:4px 7px; overflow:hidden; color:var(--blue); border:1px solid #b9d0ed; border-radius:4px; background:#f7faff; font-size:11px; font-weight:850; text-overflow:ellipsis; white-space:nowrap; cursor:pointer; }.related-tag:hover,.related-tag:focus-visible { border-color:var(--blue); background:var(--blue-soft); outline:0; }.relation-dialog { width:min(520px,calc(100vw - 28px)); max-height:min(620px,calc(100vh - 40px)); padding:0; color:var(--ink); border:1px solid var(--line); border-radius:7px; background:#fff; box-shadow:0 24px 70px rgba(23,32,51,.22); }.relation-dialog::backdrop { background:rgba(23,32,51,.42); }.relation-dialog-body { display:grid; gap:15px; padding:20px; }.relation-dialog-head { display:grid; grid-template-columns:minmax(0,1fr) 34px; gap:12px; align-items:start; }.relation-dialog-kicker { display:block; margin-bottom:5px; color:var(--teal); font-size:10px; font-weight:900; }.relation-dialog h2 { margin:0; overflow-wrap:anywhere; font-size:19px; }.dialog-close { width:34px; height:34px; display:grid; place-items:center; padding:0; color:var(--muted); border:1px solid var(--line); border-radius:4px; background:#fff; font-size:22px; line-height:1; cursor:pointer; }.dialog-close:hover { color:var(--ink); background:#f5f7fb; }.relation-dialog-content { min-width:0; margin:0; color:var(--muted); font-size:14px; line-height:1.75; overflow-wrap:anywhere; }.relation-dialog-actions { display:flex; justify-content:flex-end; gap:8px; padding-top:2px; }.dialog-secondary { min-height:40px; padding:0 13px; color:var(--muted); border:1px solid var(--line); border-radius:4px; background:#fff; font-weight:800; cursor:pointer; }.relation-dialog-actions .submit { display:inline-flex; align-items:center; }.session-topic { border-bottom:1px solid var(--line); }.session-topic:last-child { border-bottom:0; }.session-topic-head { padding:11px 12px 5px; color:var(--teal); font-size:11px; font-weight:900; }.session-topic .history-note:last-child { border-bottom:0; }

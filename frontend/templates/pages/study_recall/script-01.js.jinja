                        'assistant',
                        conversation.mode === 'card' ? '這張卡哪裡不清楚？' : '今天想解決什麼問題？',
                        { copyable: false },
                    );
                }
                conversation.messages.forEach((message) => {
                    if (message.role === 'proposal') appendProposal(message.proposal);
                    else appendMessage(message.role, message.content);
                });
                if (conversation.pending) appendMessage('pending', '');
                renderSuggestions(conversation);
                status.textContent = conversation.pending ? '回答中' : (conversation.error || '');
                status.classList.toggle('error', Boolean(conversation.error));
                submit.disabled = conversation.pending;
                submit.hidden = conversation.pending;
                stop.hidden = !conversation.pending;
                reset.disabled = conversation.pending || conversation.messages.length === 0;
                retry.hidden = !conversation.lastFailedQuestion || conversation.pending;
                styleButtons.forEach((button) => {
                    button.classList.toggle('is-active', button.dataset.aiStyle === conversation.style);
                    button.setAttribute('aria-pressed', button.dataset.aiStyle === conversation.style ? 'true' : 'false');
                    button.disabled = conversation.pending;
                });
                toggle.classList.toggle('is-pending', conversation.pending);
                window.renderStudyMath(dialog);
                window.requestAnimationFrame(() => {
                    messageList.scrollTop = messageList.scrollHeight;
                    clampPanelPosition();
                });
            };
            const activateConversation = (key, title, mode) => {
                const previousConversation = conversations.get(activeKey);
                if (previousConversation) previousConversation.draft = input.value;
                activeKey = key;
                const conversation = ensureConversation(key, title, mode);
                heading.textContent = window.normalizeStudyMathText(conversation.title);
                modeLabel.textContent = conversation.mode === 'card' ? '重點卡助教' : '一般問答';
                contextTitle.textContent = conversation.mode === 'card' ? window.normalizeStudyMathText(conversation.title) : '';
                cardContext.hidden = conversation.mode !== 'card';
                input.setAttribute('aria-label', conversation.mode === 'card' ? '詢問這張重點卡' : '詢問 AI 助手');
                input.placeholder = conversation.mode === 'card' ? '詢問這張重點卡' : '輸入任何問題';
                input.value = conversation.draft || '';
                resizeInput();
                heading.dataset.mathContent = '';
                delete heading.dataset.mathRendered;
                delete contextTitle.dataset.mathRendered;
                delete heading.dataset.studyCodeRendered;
                delete contextTitle.dataset.studyCodeRendered;
                setPanelOpen(true);
                renderConversation(conversation);
                window.setTimeout(() => input.focus(), 0);
            };
            document.addEventListener('click', (event) => {
                const trigger = event.target.closest('[data-ai-card]');
                if (!trigger || trigger.disabled) return;
                activateConversation(trigger.dataset.aiCardUrl, trigger.dataset.aiCardTitle, 'card');
            });
            toggle.addEventListener('click', () => {
                if (!dialog.hidden) {
                    setPanelOpen(false);
                    return;
                }
                const conversation = conversations.get(activeKey);
                if (conversation) {
                    activateConversation(activeKey, conversation.title, conversation.mode);
                } else {
                    activateConversation(generalKey, 'AI 問答', 'general');
                }
            });
            generalModeButton.addEventListener('click', () => {
                activateConversation(generalKey, 'AI 問答', 'general');
            });
            const sendQuestion = async (question, { retrying = false } = {}) => {
                const requestKey = activeKey;
                const conversation = conversations.get(requestKey);
                let receivedAnswer = false;
                if (!conversation || conversation.pending || !question) return;
                if (retrying && conversation.messages.at(-1)?.role === 'error') conversation.messages.pop();
                const priorHistory = conversation.history.slice(-6);
                const userMessage = { role: 'user', content: question };
                if (!retrying) conversation.messages.push(userMessage);
                conversation.pending = true;
                conversation.error = '';
                conversation.lastFailedQuestion = '';
                conversation.controller = new AbortController();
                if (!retrying) {
                    input.value = '';
                    conversation.draft = '';
                    resizeInput();
                }
                renderConversation(conversation);
                try {
                    const response = await fetch(requestKey, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                        body: JSON.stringify({
                            question,
                            history: priorHistory,
                            response_style: conversation.style,
                            page_context: {
                                path: window.location.pathname,
                                title: document.querySelector('h1')?.textContent?.trim() || document.title,
                            },
                        }),
                        signal: conversation.controller.signal,
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.ok) throw new Error(result.error || 'AI 助教暫時無法回答，請稍後再試。');
                    const assistantMessage = { role: 'assistant', content: result.answer };
                    conversation.messages.push(assistantMessage);
                    if (result.proposal) {
                        conversation.messages.push({
                            role: 'proposal',
                            proposal: { ...result.proposal, status: 'pending', resultMessage: '' },
                        });
                    }
                    conversation.history.push(userMessage, assistantMessage);
                    conversation.history = conversation.history.slice(-12);
                    conversation.lastFailedQuestion = '';
                    receivedAnswer = true;
                } catch (error) {
                    const aborted = error?.name === 'AbortError';
                    const message = aborted ? '已停止這次回答。' : (error.message || 'AI 助教暫時無法回答，請稍後再試。');
                    conversation.messages.push({ role: 'error', content: message });
                    conversation.error = aborted ? '已停止' : '回答失敗';
                    conversation.lastFailedQuestion = question;
                } finally {
                    conversation.pending = false;
                    conversation.controller = null;
                    if (receivedAnswer && (dialog.hidden || activeKey !== requestKey)) {
                        toggle.classList.add('has-unread');
                    }
                    persistConversations();
                    if (activeKey === requestKey) {
                        renderConversation(conversation);
                        input.focus();
                    }
                }
            };
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                const conversation = conversations.get(activeKey);
                const question = input.value.trim();
                if (!conversation || conversation.pending) return;
                if (!question) {
                    conversation.error = '請先輸入問題。';
                    renderConversation(conversation);
                    return;
                }
                sendQuestion(question);
            });
            input.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
                    event.preventDefault();
                    form.requestSubmit();
                }
            });
            input.addEventListener('input', () => {
                const conversation = conversations.get(activeKey);
                if (conversation) conversation.draft = input.value;
                resizeInput();
            });
            suggestions.addEventListener('click', (event) => {
                const button = event.target.closest('[data-ai-suggestion]');
                if (!button) return;
                input.value = button.dataset.aiSuggestion;
                const conversation = conversations.get(activeKey);
                if (conversation) conversation.draft = input.value;
                resizeInput();
                input.focus();
                input.setSelectionRange(input.value.length, input.value.length);
            });
            styleButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const conversation = conversations.get(activeKey);
                    if (!conversation || conversation.pending) return;
                    conversation.style = button.dataset.aiStyle === 'detailed' ? 'detailed' : 'concise';
                    renderConversation(conversation);
                    persistConversations();
                });
            });
            stop.addEventListener('click', () => {
                conversations.get(activeKey)?.controller?.abort();
            });
            retry.addEventListener('click', () => {
                const conversation = conversations.get(activeKey);
                if (!conversation?.lastFailedQuestion || conversation.pending) return;
                sendQuestion(conversation.lastFailedQuestion, { retrying: true });
            });
            messageList.addEventListener('click', async (event) => {
                const actionButton = event.target.closest('[data-ai-action-apply],[data-ai-action-undo]');
                if (actionButton) {
                    const conversation = conversations.get(activeKey);
                    const proposalId = actionButton.dataset.aiProposalId || '';
                    const proposalMessage = conversation?.messages.find((message) => (
                        message.role === 'proposal' && message.proposal?.id === proposalId
                    ));
                    if (!conversation || !proposalMessage || conversation.pending) return;
                    const proposal = proposalMessage.proposal;
                    const isUndo = Boolean(actionButton.dataset.aiActionUndo);
                    const endpoint = isUndo ? actionButton.dataset.aiActionUndo : actionButton.dataset.aiActionApply;
                    if (!endpoint) return;
                    proposal.status = isUndo ? 'undoing' : 'applying';
                    proposal.resultMessage = '';
                    conversation.pending = true;
                    renderConversation(conversation);
                    try {
                        const response = await fetch(endpoint, {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { Accept: 'application/json' },
                        });
                        const result = await response.json().catch(() => ({}));
                        if (!response.ok || !result.ok) throw new Error(result.error || '資料變更失敗。');
                        if (result.verification?.verified !== true) {
                            throw new Error(isUndo ? '資料庫尚未完成復原驗證。' : '資料庫尚未完成驗證，這次變更不會標示為完成。');
                        }
                        proposal.status = isUndo ? 'reverted' : 'applied';
                        proposal.resultMessage = result.message || (isUndo ? '已復原這次變更。' : '已套用並回讀資料庫確認。');
                        if (!isUndo && result.undo) proposal.undo = result.undo;
                    } catch (error) {
                        proposal.status = 'error';
                        proposal.resultMessage = error.message || '資料變更失敗。';
                    } finally {
                        conversation.pending = false;
                        persistConversations();
                        renderConversation(conversation);
                    }
                    return;
                }
                const button = event.target.closest('[data-ai-copy-message]');
                if (!button) return;
                const value = button.dataset.aiCopyMessage || '';
                try {
                    if (!navigator.clipboard?.writeText) throw new Error('clipboard_unavailable');
                    await navigator.clipboard.writeText(value);
                } catch (_error) {
                    const textarea = document.createElement('textarea');
                    textarea.value = value;
                    textarea.setAttribute('readonly', '');
                    textarea.style.position = 'fixed';
                    textarea.style.opacity = '0';
                    document.body.append(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    textarea.remove();
                }
                button.textContent = '已複製';
                window.setTimeout(() => { button.textContent = '複製'; }, 1200);
            });
            reset.addEventListener('click', () => {
                const conversation = conversations.get(activeKey);
                if (!conversation || conversation.pending) return;
                conversation.messages = [];
                conversation.history = [];
                conversation.error = '';
                conversation.lastFailedQuestion = '';
                conversation.draft = '';
                input.value = '';
                resizeInput();
                renderConversation(conversation);
                persistConversations();
                input.focus();
            });
            dialog.querySelectorAll('[data-ai-close]').forEach((button) => {
                button.addEventListener('click', () => setPanelOpen(false));
            });
            document.addEventListener('pointerdown', (event) => {
                if (
                    dialog.hidden
                    || dialog.contains(event.target)
                    || toggle.contains(event.target)
                    || event.target.closest('[data-ai-card]')
                ) return;
                setPanelOpen(false);
            });
        })();
        (() => {
            const form = document.getElementById('recall-upload-form');
            if (!form) return;
            const input = document.getElementById('note-images');
            const status = document.getElementById('upload-status');
            const submit = form.querySelector('button[type="submit"]');
            const stageUrl = form.dataset.stageUrl;
            const maxImageBytes = 2 * 1024 * 1024;

            const formatBytes = (bytes) => `${(bytes / 1024 / 1024).toFixed(bytes < 10 * 1024 * 1024 ? 1 : 0)}MB`;
            const setStatus = (message, tone = '') => {
                status.textContent = message;
                status.className = `upload-status ${tone}`.trim();
            };
            const loadImage = (file) => new Promise((resolve, reject) => {
                const source = URL.createObjectURL(file);
                const image = new Image();
                image.onload = () => { URL.revokeObjectURL(source); resolve(image); };
                image.onerror = () => { URL.revokeObjectURL(source); reject(new Error('image-load-failed')); };
                image.src = source;
            });
            const canvasBlob = (canvas, quality) => new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', quality));
            const compress = async (file) => {
                const image = await loadImage(file);
                let longestSide = Math.max(image.naturalWidth, image.naturalHeight);
                if (file.size <= maxImageBytes && longestSide <= 1600) return file;
                let scale = Math.min(1, 1600 / longestSide);
                let width = Math.max(1, Math.round(image.naturalWidth * scale));
                let height = Math.max(1, Math.round(image.naturalHeight * scale));
                let blob = null;
                while (!blob || blob.size > maxImageBytes) {
                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    canvas.getContext('2d', { alpha: false }).drawImage(image, 0, 0, width, height);
                    blob = await canvasBlob(canvas, blob ? 0.72 : 0.84);
                    if (!blob || blob.size <= maxImageBytes || Math.max(width, height) <= 720) break;
                    width = Math.round(width * 0.8);
                    height = Math.round(height * 0.8);
                }
                if (!blob || blob.size > maxImageBytes) throw new Error('image-too-large');
                const basename = file.name.replace(/\.[^.]+$/, '') || 'note-image';
                return new File([blob], `${basename}.jpg`, { type: 'image/jpeg' });
            };

            input.addEventListener('change', () => {
                const count = input.files.length;
                if (count) setStatus(`已選擇 ${count} 張照片；送出後會逐張壓縮與上傳。`, 'ready');
            });
            form.addEventListener('submit', async (event) => {
                if (submit.disabled) return;
                event.preventDefault();
                const files = Array.from(input.files || []);
                if (!files.length) {
                    setStatus('請至少選擇 1 張筆記照片。', 'error');
                    return;
                }
                submit.disabled = true;
                setStatus('正在縮小照片…');
                let uploadId = '';
                const uploadController = new AbortController();
                try {
                    let uploadedBytes = 0;
                    let uploadedCount = 0;
                    const uploadOne = async (index, batchId = '') => {
                        const prepared = await compress(files[index]);
                        const stagePayload = new FormData();
                        if (batchId) stagePayload.append('upload_id', batchId);
                        stagePayload.append('image_index', String(index + 1));
                        stagePayload.append('total_images', String(files.length));
                        stagePayload.append('note_image', prepared, prepared.name);
                        const stageResponse = await fetch(stageUrl, {
                            method: 'POST',
                            body: stagePayload,
                            credentials: 'same-origin',
                            signal: uploadController.signal,
                            headers: { 'X-E3-Study-Upload': '1', Accept: 'application/json' },
                        });
                        const stageResult = await stageResponse.json().catch(() => ({}));
                        if (!stageResponse.ok || !stageResult.ok) {
                            throw new Error(stageResult.error || (stageResponse.status === 413 ? 'request-too-large' : 'upload-failed'));
                        }
                        const nextUploadId = stageResult.upload_id || batchId;
                        if (!nextUploadId) throw new Error('upload-failed');
                        uploadedBytes += prepared.size;
                        uploadedCount += 1;
                        setStatus(`已上傳 ${uploadedCount}/${files.length} 張（${formatBytes(uploadedBytes)}）`, 'ready');
                        return nextUploadId;
                    };
                    setStatus(`正在準備並上傳第 1/${files.length} 張照片…`);
                    uploadId = await uploadOne(0);
                    if (files.length > 1) {
                        let nextIndex = 1;
                        const workerCount = Math.min(3, files.length - 1);
                        setStatus(`正在同時處理 ${files.length - 1} 張剩餘照片…`);
                        const workers = Array.from({ length: workerCount }, async () => {
                            while (nextIndex < files.length) {
                                const index = nextIndex;
                                nextIndex += 1;
                                await uploadOne(index, uploadId);
                            }
                        });
                        await Promise.all(workers);
                    }
                    setStatus(`全部 ${files.length} 張照片已上傳，正在建立背景整理工作…`, 'ready');
                    const payload = new FormData(form);
                    payload.delete('note_images');
                    payload.append('upload_id', uploadId);
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: payload,
                        credentials: 'same-origin',
                        headers: { 'X-E3-Study-Upload': '1', Accept: 'application/json' },
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.ok) throw new Error(result.error || (response.status === 413 ? 'request-too-large' : 'upload-failed'));
                    if (!result.job_id) throw new Error('upload-failed');
                    window.E3StudyUploadTracker?.track(result.job_id);
                    form.reset();
                    submit.disabled = false;
                    setStatus('已開始背景整理，可自由前往其他頁面；右下角會持續顯示進度。', 'ready');
                } catch (error) {
                    uploadController.abort();
                    if (uploadId) {
                        fetch(`${stageUrl}/${encodeURIComponent(uploadId)}/cancel`, {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { 'X-E3-Study-Upload': '1', Accept: 'application/json' },
                        }).catch(() => {});
                    }
                    const message = error.message === 'request-too-large'
                        ? '其中一張照片仍超過傳輸限制，請改用較小的圖片後再試。'
                        : error.message === 'image-too-large'
                            ? '其中一張照片無法縮小到 2MB，請改用較小或較清晰的照片。'
                            : error.message === 'upload-failed'
                                ? '照片處理或上傳失敗，請確認圖片格式後再試。'
                                : error.message || '照片處理或上傳失敗，請確認圖片格式後再試。';
                    setStatus(message, 'error');
                    submit.disabled = false;
                }
            });
            window.addEventListener('e3-study-upload-progress', (event) => {
                const job = event.detail || {};
                if (job.status === 'success') setStatus('筆記與全庫關聯已完成，可從右下角開啟。', 'ready');
                else if (job.status === 'error') setStatus(job.message || '筆記背景處理失敗，請再試一次。', 'error');
                else if (job.status === 'interrupted') setStatus(job.message || '筆記上傳中斷，可以從右下角接續處理。', 'error');
                else if (job.status === 'cancelled') setStatus('已取消這次筆記處理，可以立即選擇照片重新上傳。', 'ready');
                else setStatus(`${job.message || '筆記背景處理中'}（${Number(job.progress) || 0}%）`, 'ready');
            });
        })();

        (() => {
            document.querySelectorAll('[data-recall-card]').forEach((card) => {
                const reveal = card.querySelector('[data-recall-reveal]');
                const answer = card.querySelector('[data-recall-answer]');
                if (!reveal || !answer) return;
                reveal.addEventListener('click', () => {
                    const shouldReveal = answer.hidden;
                    answer.hidden = !shouldReveal;
                    card.classList.toggle('is-revealed', shouldReveal);
                    reveal.setAttribute('aria-expanded', shouldReveal ? 'true' : 'false');
                    reveal.textContent = shouldReveal ? '收起重點' : '揭示重點';
                    if (shouldReveal && !card.dataset.firstRevealedAt) {
                        card.dataset.firstRevealedAt = String(Date.now());
                    }
                    if (shouldReveal) window.renderStudyMath();
                });
                card.querySelectorAll('input[data-rating-description]').forEach((input) => {
                    input.addEventListener('change', () => {
                        const choice = card.querySelector('[data-rating-choice]');
                        if (choice) choice.textContent = `${input.value} 分：${input.dataset.ratingDescription || ''}`;
                    });
                });
            });
        })();

        (() => {
            const updateDueCounts = (count) => {
                document.querySelectorAll('[data-recall-due-count]').forEach((node) => {
                    node.textContent = `${count} ${node.dataset.countLabel || '張'}`;
                });
            };
            const updateProgress = () => {
                const progress = document.querySelector('[data-recall-progress]');
                const list = document.querySelector('[data-recall-card-list]');
                if (!progress || !list) return;
                const total = Math.max(0, Number(progress.dataset.total) || 0);
                const remaining = list.querySelectorAll('[data-recall-card]').length;
                const completed = Math.max(0, total - remaining);
                const label = progress.querySelector('[data-recall-progress-label]');
                const bar = progress.querySelector('[data-recall-progress-bar]');
                if (label) label.textContent = `本次完成 ${completed} 張，剩 ${remaining} 張`;
                if (bar) bar.style.width = `${total ? completed / total * 100 : 100}%`;
                progress.hidden = total === 0;
                updateDueCounts(remaining);
            };
            const removeRatedCard = (card) => {
                card.classList.add('is-completing');
                window.setTimeout(() => {
                    const list = card.closest('[data-recall-card-list]');
                    card.remove();
                    updateProgress();
                    if (list && !list.querySelector('[data-recall-card]')) {
                        list.hidden = true;
                        const empty = list.parentElement.querySelector('[data-recall-empty]');
                        if (empty) empty.hidden = false;
                    }
                }, 180);
            };
            document.querySelectorAll('form[data-recall-rating-form]').forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    if (form.dataset.submitting === 'true') return;
                    const status = form.querySelector('[data-recall-rating-status]');
                    const button = form.querySelector('button[type="submit"]');
                    if (!form.querySelector('input[type="radio"]:checked')) {
                        if (status) status.textContent = '請先選擇印象分。';
                        return;
                    }
                    form.dataset.submitting = 'true';
                    if (status) status.textContent = '';
                    const originalLabel = button.textContent;
                    button.disabled = true;
                    button.textContent = '儲存中…';
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            credentials: 'same-origin',
                            headers: { 'X-E3-Recall-Rating': '1', Accept: 'application/json' },
                        });
                        const result = await response.json().catch(() => ({}));
                        if (!response.ok || !result.ok) throw new Error(result.error || '印象分暫時無法儲存，請再試一次。');
                        const card = form.closest('[data-recall-card]');
                        if (card) removeRatedCard(card);
                    } catch (error) {
                        if (status) status.textContent = error.message || '印象分暫時無法儲存，請再試一次。';
                        button.disabled = false;
                        button.textContent = originalLabel;
                        form.dataset.submitting = '';
                    }
                });
            });
        })();

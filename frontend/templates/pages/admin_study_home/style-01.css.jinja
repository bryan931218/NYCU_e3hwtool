        .today-card .caption { color: rgba(255, 255, 255, .72); }
        .today-row { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin: 10px 0 5px; }
        .today-hours { font-size: 34px; font-weight: 950; letter-spacing: -.07em; }
        .today-state { font-size: 13px; font-weight: 850; }
        .video-list { display: grid; gap: 8px; margin-top: 10px; }

                } catch (error) {}
                setVideoSummaryOpen(shouldOpen);
                videoSummaryToggle.addEventListener('click', function () {
                    setVideoSummaryOpen(videoSummaryBody.hidden);
                });
            }

            const formatMinutes = function (seconds) {
                return (Math.max(0, Number(seconds) || 0) / 60).toFixed(1);
            };
            const formatClock = function (seconds) {
                const value = Math.max(0, Math.floor(Number(seconds) || 0));
                const minutes = Math.floor(value / 60);
                const rest = value % 60;
                return minutes + ':' + String(rest).padStart(2, '0');
            };
            const formatLongClock = function (seconds) {
                const value = Math.max(0, Math.floor(Number(seconds) || 0));
                const hours = Math.floor(value / 3600);
                const minutes = Math.floor((value % 3600) / 60);
                const rest = value % 60;
                return [hours, minutes, rest].map(function (part) {
                    return String(part).padStart(2, '0');
                }).join(':');
            };
            const makeStudySessionId = function (prefix) {
                const random = window.crypto && typeof window.crypto.randomUUID === 'function'
                    ? window.crypto.randomUUID().replace(/-/g, '')
                    : Math.random().toString(36).slice(2) + Date.now().toString(36);
                return prefix + '_' + random;
            };
            const renderStudyTimeHistory = function () {
                if (!studyTimeHistoryList || !studyTimeHistoryEmpty) return;
                studyTimeHistoryList.textContent = '';
                studyTimeHistoryEmpty.hidden = studyTimeSessions.length > 0;
                studyTimeSessions.forEach(function (session) {
                    const item = document.createElement('div');
                    item.className = 'study-time-history-item';
                    const kind = document.createElement('span');
                    kind.className = 'study-time-kind ' + (session.kind === 'practice' ? 'practice' : 'video');
                    kind.textContent = session.kind === 'practice' ? '刷題' : '影片';
                    const label = document.createElement('span');
                    label.className = 'study-time-history-label';
                    label.textContent = session.label || (session.kind === 'practice' ? '刷題' : '影片學習');
                    const duration = document.createElement('span');
                    duration.className = 'study-time-history-duration';
                    duration.textContent = formatLongClock(session.elapsed_seconds || 0);
                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'study-time-delete';
                    remove.dataset.deleteStudyTime = session.session_id || '';
                    remove.textContent = '刪除';
                    item.append(kind, label, duration, remove);
                    studyTimeHistoryList.appendChild(item);
                });
            };
            const updateTodayStudyTime = function (today) {
                if (!today) return;
                if (todayStudyTime) todayStudyTime.textContent = (Number(today.total_seconds || 0) / 3600).toFixed(2) + 'h';
                if (todayVideoTime) todayVideoTime.textContent = (Number(today.video_seconds || 0) / 3600).toFixed(2) + 'h';
                if (todayPracticeTime) todayPracticeTime.textContent = (Number(today.practice_seconds || 0) / 3600).toFixed(2) + 'h';
                if (Array.isArray(today.sessions)) {
                    studyTimeSessions = today.sessions;
                    renderStudyTimeHistory();
                }
            };
            const postStudyTime = function (session, completed, keepalive) {
                if (!session || !session.id) return Promise.resolve();
                const elapsedSeconds = Math.max(0, Number(session.elapsed || 0))
                    + (session.runningSince ? Math.max(0, (Date.now() - session.runningSince) / 1000) : 0);
                return fetch('{{ url_for("admin_study_plan_study_time") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        session_id: session.id,
                        kind: session.kind,
                        video_id: session.videoId || null,
                        label: session.label || '',
                        elapsed_seconds: elapsedSeconds,
                        completed: Boolean(completed)
                    }),
                    keepalive: Boolean(keepalive)
                }).then(function (response) {
                    if (!response.ok) throw new Error('study_time_not_saved');
                    return response.json();
                }).then(function (result) {
                    updateTodayStudyTime(result.today);
                    if (studyTimeSyncStatus) studyTimeSyncStatus.textContent = '已同步';
                    return result;
                }).catch(function () {
                    if (studyTimeSyncStatus) studyTimeSyncStatus.textContent = '同步失敗，請重試';
                    return { ok: false };
                });
            };
            const currentSessionSeconds = function (session) {
                if (!session) return 0;
                return Math.max(0, Number(session.elapsed || 0))
                    + (session.runningSince ? Math.max(0, (Date.now() - session.runningSince) / 1000) : 0);
            };
            const renderStudyTimers = function () {
                if (playerStudyTime) playerStudyTime.textContent = formatLongClock(currentSessionSeconds(videoStudySession));
                if (!practiceTimerClock || !practiceTimerToggle || !practiceTimerFinish) return;
                practiceTimerClock.textContent = formatLongClock(currentSessionSeconds(practiceTimer));
                const hasTimer = Boolean(practiceTimer);
                const running = Boolean(practiceTimer && practiceTimer.runningSince);
                practiceTimerToggle.textContent = !hasTimer ? '開始' : running ? '暫停' : '繼續';
                practiceTimerFinish.disabled = !hasTimer;
                if (practiceTimerLabel) practiceTimerLabel.disabled = hasTimer;
                if (practiceTimerStatus) practiceTimerStatus.textContent = !hasTimer ? '尚未開始' : running ? '計時中' : '已暫停';
            };
            const persistPracticeTimer = function () {
                try {
                    if (practiceTimer) window.localStorage.setItem('e3-practice-timer', JSON.stringify(practiceTimer));
                    else window.localStorage.removeItem('e3-practice-timer');
                } catch (error) {}
            };
            try {
                const savedPracticeTimer = JSON.parse(window.localStorage.getItem('e3-practice-timer') || 'null');
                if (savedPracticeTimer && savedPracticeTimer.id && savedPracticeTimer.kind === 'practice') {
                    practiceTimer = savedPracticeTimer;
                    if (practiceTimerLabel) practiceTimerLabel.value = practiceTimer.label || '';
                }
            } catch (error) {
                practiceTimer = null;
            }
            const pauseSessionAt = function (session, stoppedAt) {
                if (!session || !session.runningSince) return;
                const stopTime = Math.max(
                    Number(session.runningSince),
                    Number(stoppedAt) || Date.now()
                );
                session.elapsed = Math.max(0, Number(session.elapsed || 0))
                    + Math.max(0, (stopTime - Number(session.runningSince)) / 1000);
                session.runningSince = null;
            };
            const pauseSession = function (session) {
                pauseSessionAt(session, Date.now());
            };
            const VIDEO_STUDY_IDLE_TIMEOUT_MS = 5 * 60 * 1000;
            const clearVideoStudyIdleTimer = function () {
                if (videoStudyIdleTimer) window.clearTimeout(videoStudyIdleTimer);
                videoStudyIdleTimer = null;
            };
            const finalizeVideoStudySession = function (reason, keepalive) {
                if (!videoStudySession) {
                    clearVideoStudyIdleTimer();
                    return Promise.resolve();
                }
                clearVideoStudyIdleTimer();
                const stoppedAt = videoStudySession.pausedAt
                    ? Math.min(
                        Date.now(),
                        Number(videoStudySession.pausedAt) + VIDEO_STUDY_IDLE_TIMEOUT_MS
                    )
                    : Date.now();
                pauseSessionAt(videoStudySession, stoppedAt);
                const finishedSession = videoStudySession;
                videoStudySession = null;
                renderStudyTimers();
                if (reason === 'idle') {
                    playerSyncState.textContent = '已停止本輪計時，播放後將開始新一輪';
                }
                return postStudyTime(finishedSession, true, Boolean(keepalive));
            };
            const scheduleVideoStudyIdleCutoff = function () {
                clearVideoStudyIdleTimer();
                if (!videoStudySession) return;
                if (!videoStudySession.pausedAt) videoStudySession.pausedAt = Date.now();
                const sessionId = videoStudySession.id;
                const elapsedIdle = Math.max(0, Date.now() - Number(videoStudySession.pausedAt || 0));
                const remainingIdle = Math.max(0, VIDEO_STUDY_IDLE_TIMEOUT_MS - elapsedIdle);
                videoStudyIdleTimer = window.setTimeout(function verifyIdleCutoff() {
                    videoStudyIdleTimer = null;
                    if (
                        !videoStudySession
                        || videoStudySession.id !== sessionId
                        || !videoStudySession.pausedAt
                    ) return;
                    const idleFor = Math.max(0, Date.now() - Number(videoStudySession.pausedAt || 0));
                    if (idleFor < VIDEO_STUDY_IDLE_TIMEOUT_MS) {
                        scheduleVideoStudyIdleCutoff();
                        return;
                    }
                    finalizeVideoStudySession('idle', false);
                }, remainingIdle);
            };
            const beginVideoStudyTime = function () {
                const option = selectedOption();
                if (!option) return;
                const videoId = Number(option.value);
                if (videoStudySession && videoStudySession.videoId !== videoId) {
                    finalizeVideoStudySession('switch', false);
                }
                if (
                    videoStudySession
                    && videoStudySession.pausedAt
                    && Date.now() - Number(videoStudySession.pausedAt) >= VIDEO_STUDY_IDLE_TIMEOUT_MS
                ) {
                    finalizeVideoStudySession('idle', false);
                }
                clearVideoStudyIdleTimer();
                if (!videoStudySession) {
                    videoStudySession = {
                        id: makeStudySessionId('video'), kind: 'video', videoId: videoId,
                        label: option.dataset.title || '影片學習', elapsed: 0,
                        runningSince: null, pausedAt: null
                    };
                }
                videoStudySession.pausedAt = null;
                if (!videoStudySession.runningSince) videoStudySession.runningSince = Date.now();
                renderStudyTimers();
            };
            const pauseVideoStudyTime = function (completed) {
                if (!videoStudySession) return;
                if (completed) {
                    finalizeVideoStudySession('complete', false);
                    return;
                }
                if (!videoStudySession.pausedAt) videoStudySession.pausedAt = Date.now();
                postStudyTime(videoStudySession, false, false);
                scheduleVideoStudyIdleCutoff();
                renderStudyTimers();
            };
            if (practiceTimerToggle) practiceTimerToggle.addEventListener('click', function () {
                if (!practiceTimer) {
                    practiceTimer = {
                        id: makeStudySessionId('practice'), kind: 'practice', videoId: null,
                        label: (practiceTimerLabel ? practiceTimerLabel.value : '').trim() || '刷題',
                        elapsed: 0, runningSince: Date.now()

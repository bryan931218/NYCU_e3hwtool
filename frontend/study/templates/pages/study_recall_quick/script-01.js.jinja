            while ((match = fencePattern.exec(source)) !== null) {
                appendQuickInlineCode(fragment, source.slice(cursor, match.index));
                const rawLanguage = (match[1] || 'text').toLowerCase();
                const block = document.createElement('div');
                block.className = 'study-code-block';
                const head = document.createElement('div');
                head.className = 'study-code-head';
                const language = document.createElement('span');
                language.className = 'study-code-language';
                language.textContent = QUICK_CODE_LANGUAGE_LABELS[rawLanguage] || rawLanguage || '程式碼';
                const copy = document.createElement('button');

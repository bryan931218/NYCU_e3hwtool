        .side-stack { display: grid; gap: 18px; }
        .focus-card { padding: 20px; }
        .status { display: inline-flex; align-items: center; justify-content: center; min-width: 64px; padding: 6px 10px; border-radius: 999px; border: 1px solid var(--line); font-size: 12px; font-weight: 850; white-space: nowrap; }
        .status.early { color: var(--teal); background: var(--teal-soft); border-color: #9bdcdd; }
        .status.partial { color: var(--purple); background: var(--purple-soft); border-color: #cabdf6; }
        .status.active { color: var(--blue); background: var(--blue-soft); border-color: #a8c7f4; }
        .status.behind { color: var(--amber); background: var(--amber-soft); border-color: #f0d6a5; }
        .status.complete { color: var(--green); background: var(--green-soft); border-color: #b9e0c6; }
        .status.upcoming { color: var(--muted); background: #f4f7fa; }
        .focus-main { margin-top: 16px; padding: 18px; border-radius: 22px; color: #fff; background: linear-gradient(135deg, #102a43, #1463d9); }
        .focus-hours { margin-top: 10px; font-size: 42px; font-weight: 950; letter-spacing: -.07em; }
        .week-chart-wrap { padding: 14px 18px 18px; }
        .week-chart { width: 100%; height: auto; display: block; border-radius: 20px; background: linear-gradient(180deg, #fbfdff 0%, #f4f8fd 100%); border: 1px solid var(--line); }
        .chart-legend { display: flex; gap: 14px; flex-wrap: wrap; padding: 12px 2px 0; color: var(--muted); font-size: 12px; font-weight: 760; }
        .chart-key { display: inline-flex; align-items: center; gap: 6px; }
        .key-line { width: 22px; height: 4px; border-radius: 999px; background: var(--blue); }
        .key-line.target { background: #a4b3c2; }
        .footer-note { margin-top: 18px; color: var(--muted); text-align: center; font-size: 12px; }
        @media (max-width: 980px) {

        .review-zone .concepts { align-items:start; }.review-progress { display:grid; grid-template-columns:auto minmax(80px,1fr); align-items:center; gap:10px; margin:14px 20px 0; color:var(--muted); font-size:11px; }.review-progress-track { height:6px; overflow:hidden; border-radius:3px; background:#e8edf4; }.review-progress-bar { width:0; height:100%; background:var(--green); transition:width .2s ease; }.recall-prompt { margin-top:13px; padding:11px 12px; border-left:3px solid var(--blue); background:#f3f7fc; }.recall-prompt > span,.concept-section-label { display:block; color:var(--teal); font-size:10px; font-weight:900; }.recall-prompt p { margin:5px 0 0; color:#40536c; font-weight:700; }.recall-reveal { width:100%; min-height:40px; margin-top:12px; color:var(--blue); border:1px solid #b9d0ed; border-radius:4px; background:#fff; font-size:12px; font-weight:900; cursor:pointer; }.recall-reveal:hover,.recall-reveal:focus-visible { background:var(--blue-soft); border-color:var(--blue); outline:0; }.recall-answer { display:grid; gap:12px; margin-top:13px; }.recall-answer[hidden] { display:none; }.review-card:not(.is-revealed) .card-ai-trigger { display:none; }.core-summary { padding:11px 12px; border-left:3px solid var(--green); background:var(--green-soft); }.core-summary p { margin:5px 0 0; color:var(--ink); font-weight:750; }.concept-detail { min-width:0; }.concept-detail > p { margin-top:5px; }.reasoning-steps { margin:6px 0 0; padding-left:21px; color:var(--muted); font-size:13px; line-height:1.65; }.reasoning-steps li + li { margin-top:4px; }.common-confusion { padding:9px 11px; color:#6d4c17; border-left:3px solid var(--amber); background:var(--amber-soft); font-size:12px; line-height:1.6; }.example-badge { display:inline-flex; width:max-content; margin-top:8px; padding:3px 7px; color:#815000; border:1px solid #e3bd78; border-radius:4px; background:var(--amber-soft); font-size:10px; font-weight:900; }.example-section { min-width:0; padding:10px 11px; border-
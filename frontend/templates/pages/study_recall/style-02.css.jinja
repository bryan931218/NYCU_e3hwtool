        .ai-general-mode { min-height:30px; display:inline-flex; align-items:center; gap:5px; padding:0 8px; border-radius:8px; background:#fff; }
        .ai-general-mode svg { width:13px; height:13px; }
        .ai-chat-messages { min-height:82px; max-height:min(42dvh,360px); gap:12px; padding:14px; overflow-y:auto; background:#f5f8fb; scrollbar-width:thin; scrollbar-color:#b8c8d8 transparent; }
        .ai-message-row { min-width:0; max-width:90%; display:grid; grid-template-columns:auto minmax(0,1fr); align-items:end; gap:6px; }
        .ai-message-row.user { grid-template-columns:minmax(0,1fr); }
        .ai-message-avatar { width:25px; height:25px; display:grid; place-items:center; align-self:end; margin-bottom:2px; color:#fff; border-radius:8px; background:#102a43; font-size:8px; font-weight:950; }
        .ai-message { border-radius:12px; line-height:1.68; }
        .ai-message.assistant { border-color:#d7e2ec; border-top-left-radius:12px; border-bottom-left-radius:4px; }
        .ai-message.user { border-color:#1769d8; border-top-right-radius:12px; border-bottom-right-radius:4px; background:#1769d8; }
        .ai-message-tools { grid-column:2; }
        .ai-chat-form { padding:10px 12px 11px; }
        .ai-suggestion { min-height:30px; padding:0 10px; border-radius:15px; transition:transform .16s ease,border-color .16s ease,background .16s ease; }
        .ai-suggestion:hover { transform:translateY(-1px); }
        .ai-composer { border-radius:13px; box-shadow:0 2px 8px rgba(16,42,67,.05); }
        .ai-send,.ai-stop { width:38px; min-width:38px; height:38px; display:grid; place-items:center; padding:0; border-radius:10px; background:#1769d8; }
        .ai-send[hidden],.ai-stop[hidden] { display:none; }
        .ai-send svg,.ai-stop svg { width:17px; height:17px; stroke-width:2.4; }
        .ai-stop { background:#53697f; }
        .ai-chat-footer { min-height:28px; }
        .ai-floating-toggle { width:60px; height:60px; overflow:visible; border:1px solid rgba(255,255,255,.35); border-radius:50%; background:#102a43; box-shadow:0 15px 34px rgba(16,42,67,.3),0 0 0 5px rgba(255,255,255,.88); transition:transform .18s ease,box-shadow .18s ease,background .18s ease; }
        .ai-floating-toggle svg { position:absolute; width:25px; height:25px; stroke-width:2; transition:opacity .16s ease,transform .2s ease; }
        .ai-floating-toggle .ai-toggle-close { opacity:0; transform:rotate(-45deg) scale(.7); }
        .ai-floating-toggle::before { content:"AI 助教"; position:absolute; right:calc(100% + 11px); padding:6px 9px; color:#fff; border-radius:7px; background:#102a43; box-shadow:0 6px 16px rgba(16,42,67,.2); font-size:10px; font-weight:850; white-space:nowrap; opacity:0; transform:translateX(5px); pointer-events:none; transition:opacity .16s ease,transform .16s ease; }
        .ai-floating-toggle::after { content:""; position:absolute; right:5px; top:5px; width:9px; height:9px; display:none; border:2px solid #102a43; border-radius:50%; background:#31ba79; }
        .ai-floating-toggle.has-unread::after { display:block; }
        .ai-floating-toggle:hover,.ai-floating-toggle:focus-visible { background:#163b5d; transform:translateY(-2px); box-shadow:0 18px 38px rgba(16,42,67,.34),0 0 0 5px rgba(226,240,248,.96); outline:0; }
        .ai-floating-toggle:hover::before,.ai-floating-toggle:focus-visible::before { opacity:1; transform:translateX(0); }
        .ai-floating-toggle.is-active { background:#087f80; transform:translateY(0); }
        .ai-floating-toggle.is-active::before { opacity:0; transform:translateX(5px); }
        .ai-floating-toggle.is-active .ai-toggle-assistant { opacity:0; transform:rotate(45deg) scale(.7); }
        .ai-floating-toggle.is-active .ai-toggle-close { opacity:1; transform:rotate(0) scale(1); }
        .ai-floating-toggle.is-active::after { display:none; }
        .ai-floating-toggle.is-pending::after { display:block; width:10px; height:10px; right:4px; top:4px; border:2px solid #fff; border-top-color:transparent; background:transparent; }
        @media (max-width:620px) {
            .ai-card-dialog { left:8px!important; right:8px!important; top:auto!important; bottom:82px!important; width:auto!important; height:auto; max-height:calc(100dvh - 98px); border-radius:15px; }
            .ai-dialog-body { max-height:calc(100dvh - 98px); }
            .ai-chat-messages { min-height:76px; max-height:min(43dvh,340px); padding:12px 10px; }
            .ai-message-row { max-width:94%; }
            .ai-floating-toggle { right:12px; bottom:max(14px,env(safe-area-inset-bottom)); width:58px; height:58px; }
            .ai-floating-toggle::before { display:none; }
        }
        @media (prefers-reduced-motion:reduce) {
            .ai-floating-toggle,.ai-floating-toggle svg,.ai-floating-toggle::before,.ai-suggestion { transition:none; }
            .ai-thinking span,.ai-floating-toggle.is-pending::after { animation:none; }
        }
        .relation-association, .relation-card-preview { border-radius: 13px; }
        @media (max-width: 900px) {
            .study-nav { padding: 12px 16px; align-items: center; flex-direction: row; flex-wrap: wrap; }
            .nav-links { width: 100%; justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
            .nav-links::-webkit-scrollbar { display: none; }
            .nav-links a { flex: 0 0 auto; }
            .shell { padding: 20px 14px 44px; }
            .layout { grid-template-columns: 1fr; }
            .side-stack { position: static; grid-template-columns: repeat(2,minmax(0,1fr)); }
            .side-stack .history { max-height: none; overflow: visible; scrollbar-gutter: auto; }
            .recall-shortcuts { top: 132px; }
        }
        @media (max-width: 620px) {
            .page-head { padding: 22px 18px; border-radius: 20px; }
            .today { margin-top: 2px; }
            .side-stack { grid-template-columns: 1fr; }
            .recall-shortcuts { position: static; overflow-x: auto; flex-wrap: nowrap; }
            .recall-shortcuts a { flex: 0 0 auto; }
            .panel { border-radius: 17px; }
            .panel-static-head, .panel-head { padding: 19px 16px 0; }
            .note-search-body, .upload-body { padding: 16px; }
            .panel-fold-summary { padding: 18px 16px; }
            .note-search-primary { grid-template-columns: 1fr; }
            .note-search-primary .submit { width: 100%; }
            .session-head { padding: 20px 16px 18px; }
            .topic-index { padding-left: 16px; padding-right: 16px; }
            .topic-section-body { padding-left: 16px; padding-right: 16px; }
            .brand { font-size: 14px; }
            .mark { width: 35px; height: 35px; }
            .nav-links a { padding: 8px 10px; }
        }

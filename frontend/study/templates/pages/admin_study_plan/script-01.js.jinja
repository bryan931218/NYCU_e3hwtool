            studyTimePulseTimer = window.setInterval(function () {
                if (videoStudySession && videoStudySession.runningSince) postStudyTime(videoStudySession, false, false);
                if (practiceTimer && practiceTimer.runningSince) {
                    persistPracticeTimer();
                    postStudyTime(practiceTimer, false, false);
                }
            }, 15000);
            window.setInterval(renderStudyTimers, 1000);
            renderStudyTimeHistory();
            renderStudyTimers();
            const setPlayerPosition = function (seconds, durationSeconds) {
                const safeSeconds = Math.max(0, Number(seconds) || 0);
                const safeDuration = Math.max(0, Number(durationSeconds) || 0);
                playerCurrentTime.textContent = formatLongClock(safeSeconds);
                playerProgressFill.style.setProperty(
                    '--progress',
                    safeDuration ? Math.min(100, safeSeconds / safeDuration * 100) + '%' : '0%'
                );
                if (focusMarkerTime) focusMarkerTime.textContent = '記下 ' + formatClock(safeSeconds);
            };
            const selectedOption = function () {
                const option = videoSelect.options[videoSelect.selectedIndex] || null;
                return option && option.value ? option : null;
            };
            const optionByValue = function (value) {
                if (!value) return null;
                return Array.prototype.find.call(videoSelect.options, function (option) {
                    return option.value === String(value);
                }) || null;
            };
            const resetFrameQuestionResult = function () {
                frameQuestionHasResult = false;
                if (frameQuestionPreview) frameQuestionPreview.hidden = true;
                if (frameQuestionImage) frameQuestionImage.removeAttribute('src');
                if (frameQuestionAnswer) {
                    frameQuestionAnswer.hidden = true;
                    frameQuestionAnswer.textContent = '';
                    frameQuestionAnswer.removeAttribute('data-math-rendered');
                }
                if (frameQuestionStatus) {
                    frameQuestionStatus.textContent = '';
                    frameQuestionStatus.classList.remove('is-error');
                }
            };
            const playerHasFullscreenPresentation = function () {
                if (!focusPlayerFrame) return false;
                let matchesFullscreen = false;
                try { matchesFullscreen = focusPlayerFrame.matches(':fullscreen'); } catch (error) {}
                return Boolean(
                    document.fullscreenElement
                    || document.webkitFullscreenElement
                    || matchesFullscreen
                    || focusPlayerFrame.classList.contains('is-theater')
                    || focusPlayerFrame.classList.contains('is-focus-mode')
                );
            };
            const prefetchFrameQuestionImage = function (context) {
                if (!context) return Promise.resolve(null);
                if (frameQuestionStatus) {
                    frameQuestionStatus.textContent = '正在背景準備這一幕…';

                    const title = appendText(head, 'h3', '', item.concept_title || item.title || '相關筆記');
                    title.dataset.mathContent = '';
                    appendText(head, 'span', 'note-search-rank', index === 0 ? '最相關' : (index < 3 ? '高度相關' : '相關'));
                    content.appendChild(head);
                    const meta = document.createElement('div');
                    meta.className = 'note-search-meta';
                    [item.subject, item.study_date, `${item.title}・第 ${item.image_index} 張`, item.match_reason]
                        .filter(Boolean)

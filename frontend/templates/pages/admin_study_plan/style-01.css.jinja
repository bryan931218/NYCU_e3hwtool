
        :root {
            --ink: #102a43;
            --ink-2: #243b53;
            --blue: #1463d9;
            --blue-soft: #eaf3ff;
            --paper: #ffffff;
            --canvas: #f7f9fc;
            --line: #dce5ef;
            --muted: #62768b;
            --green: #258957;
            --green-soft: #eaf7ef;
            --purple: #6d4bd7;
            --purple-soft: #f1edff;
            --teal: #0f8b8d;
            --teal-soft: #e8fbfb;
            --amber: #b86d00;
            --amber-soft: #fff5df;
            --red: #b33a3a;
            --radius: 12px;
            font-family: Inter, "Noto Sans TC", "Microsoft JhengHei", system-ui, sans-serif;
        }
        * { box-sizing: border-box; }
        body { margin: 0; color: var(--ink); background: var(--canvas); }
        a { color: inherit; text-decoration: none; }
        button, input, select, textarea { font: inherit; }
        .shell { min-height: 100vh; }
        .main { min-width: 0; }
        .topbar { height: 72px; padding: 0 34px; background: var(--paper); border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
        .crumb { display: flex; align-items: center; gap: 12px; font-size: 14px; color: var(--muted); }
        .back-link { display: inline-flex; align-items: center; gap: 7px; color: var(--ink-2); font-weight: 680; }
        .admin-identity { display: inline-flex; align-items: center; gap: 9px; color: var(--ink-2); font-size: 14px; font-weight: 650; }
        .identity-dot { width: 9px; height: 9px; background: var(--green); border-radius: 50%; box-shadow: 0 0 0 4px var(--green-soft); }
        .study-nav { min-height:66px; display:flex; align-items:center; justify-content:space-between; gap:18px; padding:0 32px; background:rgba(255,255,255,.96); border-bottom:1px solid var(--line); }
        .brand { display:flex; align-items:center; gap:10px; color:var(--ink); font-size:14px; font-weight:900; white-space:nowrap; }.mark { width:30px; height:30px; display:grid; place-items:center; color:#fff; background:var(--blue); border-radius:5px; }.nav-links { display:flex; align-items:center; justify-content:flex-end; gap:3px; flex-wrap:wrap; }.nav-links a { padding:8px 10px; color:var(--muted); border-bottom:2px solid transparent; font-size:13px; font-weight:800; }.nav-links a:hover,.nav-links a.active { color:var(--blue); border-bottom-color:var(--blue); }.admin { margin-left:7px; padding:6px 9px; color:var(--teal); background:var(--teal-soft); border:1px solid #bfe4df; border-radius:4px; font-size:12px; font-weight:800; }
        .recall-pocket { margin:18px 0; border:1px solid var(--line); border-radius:7px; background:#fff; }.recall-pocket-head,.recall-pocket > summary { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; list-style:none; }.recall-pocket > summary { cursor:pointer; }.recall-pocket > summary::-webkit-details-marker { display:none; }.recall-pocket strong { display:block; font-size:14px; }.recall-count { color:var(--teal); font-size:12px; font-weight:850; }.recall-items { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; padding:12px; border-top:1px solid var(--line); }.recall-card { min-width:0; padding:13px; border:1px solid var(--line); border-radius:5px; background:#fbfdff; }.recall-card-title { overflow-wrap:anywhere; font-size:13px; font-weight:850; }.recall-card-note { min-width:0; margin-top:4px; color:var(--muted); font-size:12px; line-height:1.55; }.recall-card form { display:grid; gap:8px; margin-top:12px; }.recall-rating { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:4px; }.recall-rating label { cursor:pointer; }.recall-rating input { position:absolute; width:1px; height:1px; margin:0; opacity:0; }.recall-rating span { display:grid; min-height:30px; place-items:center; border:1px solid var(--line); border-radius:4px; color:var(--muted); background:#fff; font-size:11px; font-weight:850; }.recall-rating input:checked + span { color:#fff; border-color:var(--blue); background:var(--blue); }.recall-rate { min-height:34px; border:0; border-radius:4px; color:#fff; background:var(--blue); font-size:12px; font-weight:850; cursor:pointer; }.recall-rate:disabled { opacity:.6; cursor:wait; }.recall-rate-status { min-height:16px; margin:0; color:var(--red); font-size:11px; }.recall-card.is-completing { opacity:0; transform:scale(.98); transition:opacity .18s ease,transform .18s ease; }.recall-empty { padding:4px 16px 16px; color:var(--muted); font-size:13px; }
        .recall-cue { margin-top:9px; padding:9px 10px; color:#40536c; border-left:3px solid var(--blue); background:#f3f7fc; font-size:12px; font-weight:700; line-height:1.55; }.recall-reveal { width:100%; min-height:34px; margin-top:9px; color:var(--blue); border:1px solid #b9d0ed; border-radius:4px; background:#fff; font-size:11px; font-weight:900; cursor:pointer; }.recall-reveal:hover { background:var(--blue-soft); }.recall-answer { margin-top:9px; }.recall-answer[hidden] { display:none; }.recall-core { margin-bottom:7px; padding:8px 9px; color:var(--ink); border-left:3px solid var(--green); background:#edf8f1; font-size:12px; font-weight:750; line-height:1.55; }.recall-example-badge { display:inline-block; margin-left:6px; padding:2px 5px; color:#815000; border:1px solid #e3bd78; border-radius:3px; background:#fff4de; font-size:9px; }.recall-example { margin-bottom:7px; padding:8px 9px; color:#40536c; border-left:3px solid var(--blue); background:#f4f8fd; font-size:12px; line-height:1.55; }.recall-example.method { border-left-color:var(--teal); background:var(--teal-soft); }.recall-example.simple { border-left-color:var(--amber); background:var(--amber-soft); }.recall-example strong { margin-bottom:3px; color:var(--ink); font-size:10px; }
        .recall-empty { display:none; }
        [data-math-content] { min-width:0; max-width:100%; overflow-wrap:anywhere; } [data-math-content] > .katex { display:inline-block; max-width:100%; overflow-x:auto; overflow-y:hidden; vertical-align:middle; } [data-math-content] .katex-display { width:100%; max-width:100%; margin:.65em 0; padding:2px 0 5px; overflow-x:auto; overflow-y:hidden; overscroll-behavior-inline:contain; scrollbar-width:thin; } [data-math-content] .katex-display > .katex { display:table; width:max-content; min-width:max-content; max-width:none; margin:0 auto; overflow:visible; text-align:left; }
        .content { width: 100%; max-width: none; padding: 34px; }
        .title-row { display: flex; justify-content: space-between; gap: 20px; align-items: end; margin-bottom: 24px; }
        .settings-link { display:inline-block; margin-top:8px; color:var(--blue); font-size:13px; font-weight:800; }
        .settings-link:hover { text-decoration:underline; }
        h1 { margin: 0; font-size: clamp(25px, 3vw, 34px); line-height: 1.12; letter-spacing: -.035em; }
        .subtitle { margin: 9px 0 0; color: var(--muted); font-size: 15px; line-height: 1.6; }
        .date-range { color: var(--muted); font-size: 14px; white-space: nowrap; }
        .metric-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper); margin-bottom: 24px; }
        .metric { padding: 18px 20px; border-right: 1px solid var(--line); }
        .metric:last-child { border-right: 0; }
        .metric-label { color: var(--muted); font-size: 12px; font-weight: 700; }
        .metric-value { margin-top: 6px; font-size: 25px; font-weight: 780; letter-spacing: -.04em; }
        .metric-value small { margin-left: 4px; color: var(--muted); font-size: 13px; font-weight: 650; letter-spacing: 0; }
        .workspace { display: grid; grid-template-columns: minmax(360px, .92fr) minmax(560px, 1.38fr); gap: 24px; align-items: start; }
        .column { display: grid; gap: 24px; min-width: 0; }
        .panel { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
        .panel-header { padding: 18px 20px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
        .panel-title { margin: 0; font-size: 16px; letter-spacing: -.015em; }
        .focus-body { padding: 22px 20px 20px; }
        .focus-subject { margin: 4px 0 20px; font-size: 30px; line-height: 1; letter-spacing: -.045em; }
        .focus-caption { color: var(--muted); font-size: 14px; }
        .focus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 22px 0; }
        .focus-item { padding: 12px 0; border-bottom: 1px solid var(--line); }
        .focus-item:nth-child(odd) { padding-right: 14px; }
        .focus-item:nth-child(even) { padding-left: 14px; border-left: 1px solid var(--line); }
        .focus-item:nth-last-child(-n+2) { border-bottom: 0; }
        .focus-item span { display: block; color: var(--muted); font-size: 12px; }
        .focus-item strong { display: block; margin-top: 4px; font-size: 15px; }
        .progress-line { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 13px; color: var(--muted); }
        .progress-line strong { color: var(--blue); font-size: 24px; letter-spacing: -.04em; }
        .track { height: 7px; background: #e7edf4; border-radius: 99px; overflow: hidden; margin-top: 9px; }
        .fill { height: 100%; width: min(100%, var(--progress)); background: var(--blue); border-radius: inherit; }
        .daily-plan-head { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin-top: 18px; }
        .daily-plan-title { color: var(--muted); font-size: 12px; font-weight: 760; }
        .daily-legend { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; color: var(--muted); font-size: 10px; }
        .legend-item { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
        .legend-dot { width: 7px; height: 7px; border-radius: 50%; background: #b8c4d2; }
        .legend-dot.complete { background: var(--green); }
        .legend-dot.early { background: var(--teal); }
        .legend-dot.partial { background: var(--purple); }
        .legend-dot.active { background: var(--blue); }
        .legend-dot.behind { background: var(--amber); }
        .daily-plan { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7px; margin-top: 9px; }
        .day-chip { position: relative; min-width: 0; padding: 8px 8px; border: 1px solid var(--line); border-radius: 10px; background: #fbfdff; overflow: hidden; }
        .day-chip.complete { border-color: #b9e0c6; background: linear-gradient(180deg, #f4fbf6 0%, #ffffff 100%); }
        .day-chip.early { border-color: #9bdcdd; background: linear-gradient(180deg, #effefe 0%, #ffffff 100%); box-shadow: 0 0 0 2px rgba(15, 139, 141, .07); }
        .day-chip.partial { border-color: #cabdf6; background: linear-gradient(180deg, #f7f4ff 0%, #ffffff 100%); }
        .day-chip.active { border-color: #9ebdf3; background: linear-gradient(180deg, #eef5ff 0%, #ffffff 100%); box-shadow: 0 0 0 2px rgba(20, 99, 217, .08); }
        .day-chip.behind { border-color: #f0d6a5; background: linear-gradient(180deg, #fff8e8 0%, #ffffff 100%); }
        .day-chip.rest { border-color:#cbd7e2; background:repeating-linear-gradient(135deg,#f7f9fb 0 8px,#fff 8px 16px); }
        .day-chip.upcoming { background: #fbfdff; }
        .day-topline { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
        .day-top-actions { display:flex; align-items:center; justify-content:flex-end; gap:4px; }
        .day-rest-form { margin:0; line-height:1; }
        .day-rest-button { width:24px; height:24px; display:grid; place-items:center; padding:0; color:#536a7f; border:1px solid #cbd8e4; border-radius:50%; background:#fff; font-size:10px; font-weight:900; cursor:pointer; }
        .day-rest-button:hover { color:var(--blue); border-color:#9ebdf3; background:var(--blue-soft); }
        .day-rest-button.restore { color:#087979; border-color:#acd7d3; background:#f1fbfa; }
        .day-label { display: block; color: var(--muted); font-size: 11px; font-weight: 780; }
        .day-date { display: block; color: #8aa0b6; font-size: 10px; font-weight: 650; }
        .day-hours { display: block; margin-top: 5px; color: var(--ink); font-size: 17px; font-weight: 800; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
        .day-focus { display: block; margin-top: 2px; color: var(--muted); font-size: 10px; line-height: 1.35; }
        .day-subject-list { display:grid; width:100%; min-width:0; gap:7px; margin-top:8px; padding-top:7px; border-top:1px solid var(--line); }
        .day-subject-row, .day-subject-head { width:100%; min-width:0; }
        .day-subject-head { display:flex; align-items:baseline; justify-content:space-between; gap:5px; color:var(--muted); font-size:9px; font-weight:760; }
        .day-subject-head strong { min-width:0; overflow:hidden; color:var(--ink-2); text-overflow:ellipsis; white-space:nowrap; }
        .day-subject-value { flex:0 0 auto; font-variant-numeric:tabular-nums; white-space:nowrap; }
        .day-subject-track { width:100%; max-width:100%; height:5px; margin-top:3px; overflow:hidden; border-radius:99px; background:#e6edf4; }
        .day-subject-fill { height:100%; width:min(100%,var(--subject-progress)); border-radius:inherit; background:var(--blue); }
        .day-status { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; padding: 2px 5px; border-radius: 999px; background: #eef3f8; color: var(--muted); font-size: 10px; font-weight: 760; }
        .day-chip.complete .day-status { background: var(--green-soft); color: var(--green); }
        .day-chip.early .day-status { background: var(--teal-soft); color: var(--teal); }
        .day-chip.partial .day-status { background: var(--purple-soft); color: var(--purple); }
        .day-chip.active .day-status { background: #fff; color: var(--blue); }
        .day-chip.behind .day-status { background: var(--amber-soft); color: var(--amber); }
        .day-chip.rest .day-status { color:#52697d; background:#e9eff4; }
        .day-chip.rest .day-hours,.day-chip.rest .day-focus { color:#6d8194; }
        .day-completion { display: flex; justify-content: space-between; gap: 6px; margin-top: 7px; color: var(--muted); font-size: 10px; font-variant-numeric: tabular-nums; }
        .day-completion strong { color: var(--ink-2); }
        .day-progress { height: 5px; margin-top: 5px; border-radius: 99px; background: #e6edf4; overflow: hidden; }
        .day-progress-fill { height: 100%; width: min(100%, var(--day-progress)); border-radius: inherit; background: #a8b7c8; }
        .day-chip.complete .day-progress-fill { background: var(--green); }
        .day-chip.early .day-progress-fill { background: var(--teal); }
        .day-chip.partial .day-progress-fill { background: var(--purple); }
        .day-chip.active .day-progress-fill { background: var(--blue); }
        .day-chip.behind .day-progress-fill { background: var(--amber); }
        .timeline { max-height: 580px; overflow: auto; }
        .week-row { display: grid; grid-template-columns: 33px minmax(0, 1fr) 64px; gap: 10px; align-items: center; padding: 13px 18px; border-bottom: 1px solid var(--line); }
        .week-row:last-child { border-bottom: 0; }
        .week-row.active { background: var(--blue-soft); }
        .week-index { width: 23px; height: 23px; display: grid; place-items: center; border: 1px solid #b9c7d8; border-radius: 50%; color: var(--muted); font-size: 12px; font-weight: 750; }
        .week-row.complete .week-index { color: #fff; background: var(--green); border-color: var(--green); }
        .week-row.active .week-index { color: var(--blue); border: 2px solid var(--blue); background: #fff; }
        .week-subject { font-size: 14px; font-weight: 720; }
        .replan-week-badge { display: inline-flex; margin-left: 6px; padding: 2px 6px; border-radius: 999px; color: #5d3fc1; background: #f1edff; font-size: 9px; font-weight: 900; vertical-align: 2px; }
        .week-meta { color: var(--muted); font-size: 12px; line-height: 1.45; }
        .week-target { color: var(--ink-2); font-size: 12px; line-height: 1.45; }
        .week-target strong { display: block; color: var(--blue); font-size: 13px; font-weight: 820; }
        .week-summary { grid-column: 2 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); min-width: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
        .week-stat { min-width: 0; padding: 7px 8px; border-right: 1px solid var(--line); }
        .week-stat:first-child { padding-left: 0; }
        .week-stat:last-child { padding-right: 0; border-right: 0; }
        .week-stat span { display: block; overflow: hidden; color: var(--muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
        .week-stat strong { display: block; margin-top: 2px; color: var(--ink-2); font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .week-stat.progress strong { color: var(--blue); }
        .week-row.complete .week-stat.progress strong { color: var(--green); }
        .week-row.behind .week-stat.remaining strong { color: var(--amber); }
        .week-daily { grid-column: 2 / -1; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 5px; min-width: 0; }
        .week-daily .day-chip { padding: 6px; border-radius: 6px; }
        .week-daily .day-chip[id] { scroll-margin-top:82px; }
        .week-daily .day-hours { font-size: 13px; }
        .week-daily .day-focus, .week-daily .day-date, .week-daily .day-status { display: none; }
        .week-daily .day-chip.rest .day-status { display:inline-flex; }
        .week-daily .day-completion { justify-content: flex-end; margin-top: 4px; }
        .week-daily .day-completion span { display: none; }
        .week-daily .day-progress { height: 4px; }
        .state { display: inline-flex; align-items: center; justify-content: center; min-width: 54px; border: 1px solid var(--line); border-radius: 4px; padding: 4px 6px; font-size: 11px; font-weight: 720; }
        .state.complete { color: var(--green); background: var(--green-soft); border-color: #b9e0c6; }
        .state.early { color: var(--teal); background: var(--teal-soft); border-color: #9bdcdd; }
        .state.active { color: var(--blue); background: #fff; border-color: #9ebdf3; }
        .state.behind { color: var(--amber); background: var(--amber-soft); border-color: #f0d6a5; }
        .subject-filter { padding: 15px 20px; display: flex; align-items: end; gap: 12px; border-bottom: 1px solid var(--line); background: #fff; }
        .subject-filter .field { width: min(100%, 270px); }
        .youtube-player { display: grid; grid-template-columns: minmax(0, 1.32fr) minmax(270px, .68fr); align-items: stretch; gap: 14px; padding: 16px; border-bottom: 1px solid var(--line); background: linear-gradient(145deg, #f7fbff 0%, #fff 50%, #f2f7fd 100%); }
        .youtube-player.is-hidden { display: none; }
        .player-frame { position: relative; align-self: start; width: 100%; aspect-ratio: 16 / 9; min-height: 0; border: 1px solid #c4d3e2; border-radius: 16px; background: #07111d; overflow: hidden; box-shadow: 0 16px 34px rgba(16, 42, 67, .16); }
        .player-frame iframe, #youtube-player { display: block; width: 100%; height: 100%; min-height: 0; border: 0; }
        .player-empty { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; color: #b9c7d8; text-align: center; line-height: 1.65; }
        .video-end-screen { position:absolute; z-index:30; left:12px; right:12px; bottom:12px; display:flex; flex-direction:column; gap:9px; max-height:calc(100% - 24px); padding:11px; color:#fff; border:1px solid rgba(255,255,255,.18); border-radius:8px; background:linear-gradient(135deg,rgba(6,16,29,.94),rgba(12,29,49,.92)); box-shadow:0 16px 42px rgba(0,0,0,.42),inset 0 1px 0 rgba(255,255,255,.08); opacity:1; visibility:visible; -webkit-backdrop-filter:blur(18px) saturate(135%); backdrop-filter:blur(18px) saturate(135%); animation:video-end-reveal .24s ease-out; transition:opacity .2s ease,visibility .2s ease,transform .2s ease; }
        .video-end-screen[hidden] { display:none !important; }
        .video-end-head { display:flex; align-items:center; justify-content:space-between; gap:12px; }
        .video-end-heading { min-width:0; display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:baseline; gap:8px; }
        .video-end-kicker { margin:0; color:#82b9ff; font-size:10px; font-weight:900; letter-spacing:.08em; white-space:nowrap; }
        .video-end-heading h3 { margin:0; color:#fff; font-size:15px; }
        .video-end-count { color:rgba(226,239,255,.6); font-size:9px; font-weight:800; white-space:nowrap; }
        .video-end-subtitle { display:none; margin:0; color:rgba(222,235,250,.72); font-size:12px; line-height:1.5; }
        .video-end-actions { display:flex; gap:7px; flex:0 0 auto; }
        .video-end-action { min-height:29px; padding:0 9px; border:1px solid rgba(255,255,255,.16); border-radius:8px; color:rgba(255,255,255,.9); background:rgba(255,255,255,.07); font-size:10px; font-weight:850; cursor:pointer; }
        .video-end-action:hover,.video-end-action:focus-visible { border-color:rgba(112,180,255,.65); background:rgba(75,145,224,.25); outline:none; }
        .video-end-list { min-height:0; display:grid; grid-template-columns:repeat(auto-fit,minmax(158px,1fr)); gap:7px; overflow-x:hidden; overflow-y:auto; padding:1px; scrollbar-width:thin; scrollbar-color:rgba(132,185,255,.48) rgba(255,255,255,.07); overscroll-behavior:contain; }
        .video-end-card { width:100%; min-width:0; height:54px; display:grid; grid-template-columns:76px minmax(0,1fr); overflow:hidden; padding:0; border:1px solid rgba(255,255,255,.13); border-radius:8px; color:#fff; background:rgba(255,255,255,.055); text-align:left; cursor:pointer; transition:transform .16s ease,border-color .16s ease,background .16s ease; }
        .video-end-card:hover,.video-end-card:focus-visible { transform:translateY(-1px); border-color:rgba(112,180,255,.66); background:rgba(74,143,220,.16); outline:none; }
        .video-end-thumb { position:relative; min-width:0; height:100%; overflow:hidden; background:linear-gradient(135deg,#16314f,#0a1829); }

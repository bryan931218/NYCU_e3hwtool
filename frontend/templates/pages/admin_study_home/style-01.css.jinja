        .today-action-head .caption { margin-top: 4px; }
        .today-task-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); margin-top: 16px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
        .today-task-stat { min-width: 0; padding: 13px 15px; }
        .today-task-stat + .today-task-stat { border-left: 1px solid var(--line); }
        .today-task-label { color: var(--muted); font-size: 11px; font-weight: 850; }
        .today-task-value { margin-top: 5px; color: var(--ink); font-size: 23px; font-weight: 950; font-variant-numeric: tabular-nums; }
        .today-action-panel .video-list { margin-top: 14px; }
        .today-action-panel .video-item { border-radius: 8px; background: #fff; }
        .today-action-panel .video-item:hover { border-color: #9fc1ee; background: #f5f9ff; }
        .today-history, .analysis-pocket {
            margin-bottom: 14px;
            border: 1px solid rgba(201,216,233,.96);
            border-radius: 8px;
            background: rgba(255,255,255,.96);

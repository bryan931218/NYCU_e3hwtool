        .panel-title { margin: 0; font-size: 19px; letter-spacing: -.025em; }
        .caption { color: var(--muted); font-size: 12px; line-height: 1.5; }
        .subject-list { padding: 14px 18px 18px; display: grid; gap: 10px; }

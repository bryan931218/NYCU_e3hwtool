                if (!isTyping && event.key === 'Escape' && (!frameQuestionDialog || !frameQuestionDialog.open) && focusPlayerFrame && focusPlayerFrame.classList.contains('is-theater')) {
                    event.preventDefault();
                    exitFocusMode();
                }
            });
            document.addEventListener('keyup', function (event) {
                if (event.code !== 'Space') return;
                event.preventDefault();
                endSpaceBoost();
            });
            window.addEventListener('blur', endSpaceBoost);
            window.addEventListener('resize', updateFocusMode);
            document.addEventListener('visibilitychange', function () {
                if (document.hidden) endSpaceBoost();
                else updateFocusMode();
            });
            document.querySelectorAll('[data-select-video]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const option = optionByValue(button.dataset.selectVideo);
                    if (!option) return;
                    videoSelect.value = option.value;
                    videoSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    window.setTimeout(function () {
                        if (youtubePlayerPanel) {
                            youtubePlayerPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            youtubePlayerPanel.focus({ preventScroll: true });
                        }
                    }, 80);
                });
            });
            window.addEventListener('beforeunload', function () {
                saveProgress('leave', true);
                if (videoStudySession) postStudyTime(videoStudySession, false, true);
                if (practiceTimer) {
                    persistPracticeTimer();
                    postStudyTime(practiceTimer, false, true);
                }
            });
            if (requestedVideoId) {
                const requestedOption = optionByValue(requestedVideoId);
                if (requestedOption) videoSelect.value = requestedOption.value;
            }
            sortVideoOptions();
            updateDuration();
            const smartReplan = document.getElementById('smart-replan');
            if (smartReplan && window.location.hash === '#smart-replan') smartReplan.open = true;
            focusVideoArea();
        }());

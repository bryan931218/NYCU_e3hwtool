        /* Refined study-center design system */
        body {
            min-width: 0;
            overflow-x: hidden;
            background:
                radial-gradient(circle at 8% 2%, rgba(179, 220, 255, .58) 0, transparent 27%),
                radial-gradient(circle at 92% 5%, rgba(226, 218, 255, .55) 0, transparent 25%),
                linear-gradient(180deg, #f8fbff 0%, #f2f7fc 100%);
        }
        .study-nav {
            position: sticky;
            z-index: 40;
            top: 0;
            min-height: 72px;
            padding: 10px 30px;
            border-bottom-color: rgba(205, 220, 235, .78);
            background: rgba(255, 255, 255, .86);
            box-shadow: 0 1px 0 rgba(255,255,255,.85), 0 8px 28px rgba(16,42,67,.045);
            backdrop-filter: blur(18px) saturate(1.18);
        }
        .brand { gap: 12px; font-size: 15px; letter-spacing: -.015em; }
        .mark {
            width: 38px;
            height: 38px;
            border-radius: 12px;

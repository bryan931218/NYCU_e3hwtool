        .day-chip { position: relative; min-width: 0; padding: 15px 14px 13px; border: 1px solid var(--line); border-radius: 18px; background: #fbfdff; overflow: hidden; }
        .day-chip.complete { border-color: #b9e0c6; background: linear-gradient(180deg, #f4fbf6 0%, #ffffff 100%); }
        .day-chip.early { border-color: #9bdcdd; background: linear-gradient(180deg, #effefe 0%, #ffffff 100%); box-shadow: 0 0 0 2px rgba(15, 139, 141, .06); }
        .day-chip.partial { border-color: #cabdf6; background: linear-gradient(180deg, #f7f4ff 0%, #ffffff 100%); }
        .day-chip.active { border-color: #9ebdf3; background: linear-gradient(180deg, #eef5ff 0%, #ffffff 100%); box-shadow: 0 0 0 2px rgba(20, 99, 217, .07); }
        .day-chip.behind { border-color: #f0d6a5; background: linear-gradient(180deg, #fff8e8 0%, #ffffff 100%); }
        .day-chip.rest { border-color:#cbd7e2; background:repeating-linear-gradient(135deg,#f7f9fb 0 8px,#fff 8px 16px); }

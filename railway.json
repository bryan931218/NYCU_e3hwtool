{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "python backend/tools/check_security.py",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "startCommand": "sh -c 'exec gunicorn --chdir backend --bind 0.0.0.0:${PORT:-8000} --workers 1 --threads 8 --timeout 240 wsgi:app'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

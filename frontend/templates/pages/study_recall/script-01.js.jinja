                const candidate = {
                    left: Number(trigger.dataset.sourceLeft),
                    top: Number(trigger.dataset.sourceTop),
                    right: Number(trigger.dataset.sourceRight),
                    bottom: Number(trigger.dataset.sourceBottom),
                };
                const hasBox = [candidate.left, candidate.top, candidate.right, candidate.bottom]
                    .every((value) => Number.isFinite(value))
                    && candidate.right > candidate.left
                    && candidate.bottom > candidate.top;
                box = hasBox ? candidate : null;
